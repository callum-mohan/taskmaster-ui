---
import Layout from "../../layouts/Layout.astro";
import { withBase } from "../../lib/url";
import TerminalWindow from "../../components/TerminalWindow.astro";
import TaskStatusBadge from "../../components/TaskStatusBadge.astro";
import Countdown from "../../components/Countdown.astro";
import ScoreBadge from "../../components/ScoreBadge.astro";
import TaskPager from "../../components/TaskPager.astro";
import ShareButton from "../../components/ShareButton.astro";
import BackLink from "../../components/BackLink.astro";
import AdminEditLink from "../../components/AdminEditLink.astro";
import { weekHref } from "../../lib/admin-nav";
import PlayerAvatar from "../../components/PlayerAvatar.astro";
import BonusPointsLedger from "../../components/BonusPointsLedger.astro";
import TaskRevealPrompt from "../../components/TaskRevealPrompt.astro";
import DecryptReveal from "../../components/DecryptReveal.astro";
import SubmissionPanel from "../../components/SubmissionPanel.astro";
import SubmissionGallery from "../../components/SubmissionGallery.astro";
import PeoplesChoiceBar from "../../components/PeoplesChoiceBar.astro";
import PredictionPanel from "../../components/PredictionPanel.astro";
import Pagination from "../../components/Pagination.astro";
import {
  GALLERY_PAGE_SIZE,
  LIST_PAGE_SIZE,
  pageHref,
  paginate,
  parsePage,
} from "../../lib/pagination";
import { loadTaskSubmissions, presignEntryMedia } from "../../data/submissions";
import { loadTaskReactions } from "../../data/reactions";
import { getRevealPassword } from "../../data/task-reveal";
import {
  allowRevealAttempt,
  passwordMatches,
  setRevealCookie,
} from "../../lib/task-reveal";
import type {
  GalleryOutcome,
  PredictionOutcome,
  RevealError,
  SubmissionOutcome,
} from "../../types";
import { ukDateFormat } from "../../lib/time";
import { recordScope } from "../../lib/season-scope";
import SeasonArchiveBanner from "../../components/SeasonArchiveBanner.astro";

const viewer = await Astro.locals.getViewer();
const scope = await recordScope(Astro.locals, "task", Astro.params.id, {
  isAdmin: viewer?.isAdmin,
});
if (!scope) return Astro.rewrite("/404");
const { season } = scope;

const {
  getTaskSummary,
  getTaskResults,
  getTaskPager,
  getRecapTaskIds,
  getTeamResults,
  getTaskBonuses,
  getSubmissionPanel,
  getPublicSubmissionGallery,
  getSocialGallery,
  getPeoplesChoice,
  getPredictionPanel,
  teams,
} = scope.queries;

const { id } = Astro.params;
const summary = getTaskSummary(id!);

// Unknown id → 404 rather than a broken page.
if (!summary) {
  return Astro.rewrite("/404");
}

const { task, winner, winningScore, winningTeam } = summary;

// A live, password-protected task this visitor hasn't unlocked yet: the data
// layer has already redacted its title and brief.
const needsPassword = task.locked && task.status === "live";

// Reveal-password guesses post back here (post/redirect/get on success).
let revealError: RevealError | undefined;
if (Astro.request.method === "POST") {
  if (!needsPassword) {
    return Astro.redirect(withBase(`/tasks/${task.id}`), 303);
  }
  const form = await Astro.request.formData();
  const guess = String(form.get("password") ?? "").slice(0, 200);
  let clientIp = Astro.request.headers.get("cf-connecting-ip") ?? "";
  try {
    clientIp ||= Astro.clientAddress;
  } catch {
    clientIp ||= "unknown";
  }
  if (!(await allowRevealAttempt(clientIp, task.id))) {
    revealError = "throttled";
    Astro.response.status = 429;
  } else {
    const password = await getRevealPassword(task.id);
    if (password && guess.trim() && passwordMatches(guess, password)) {
      await setRevealCookie(
        Astro.cookies,
        task.id,
        password,
        Astro.url.protocol === "https:",
      );
      return Astro.redirect(withBase(`/tasks/${task.id}?decrypted=1`), 303);
    }
    revealError = "denied";
    Astro.response.status = 403;
  }
}

// Decrypt animation: straight after a correct password, otherwise once per
// browser the first time a password-protected task is seen unlocked.
const revealPlay: "always" | "if-unseen" | undefined =
  task.passwordProtected && !task.locked && task.status === "live"
    ? Astro.url.searchParams.has("decrypted")
      ? "always"
      : "if-unseen"
    : undefined;
const isTeam = task.format === "team";
const results = task.status === "completed" ? getTaskResults(task.id) : [];
const teamResults =
  isTeam && task.status === "completed" ? getTeamResults(task.id) : [];
const pager = getTaskPager(task.id);
const hasRecap = getRecapTaskIds().includes(task.id);
const bonuses = getTaskBonuses(task.id);

// Each list pages on its own query param, so paging one leaves the others
// where they were. Paging links drop one-off form outcomes.
const outcomeParams = ["gallery", "prediction", "entry", "decrypted"];
const pageOf = (param: string) => parsePage(Astro.url.searchParams.get(param));
const pageLinks = (param: string, hash: string) => (page: number) =>
  pageHref(Astro.url, param, page, { hash, drop: outcomeParams });
const resultsPage = paginate(results, pageOf("results"), LIST_PAGE_SIZE);
const bonusPage = paginate(bonuses, pageOf("bonuses"), LIST_PAGE_SIZE);

// Entries: the viewer's own slots while the task is live, then a gallery for
// signed-in users once the deadline passes. Only loaded when something will show.
const submissionViewer = {
  signedIn: viewer !== undefined,
  isAdmin: viewer?.isAdmin ?? false,
  ...(viewer?.playerId && { playerId: viewer.playerId }),
};
const takesEntries =
  task.status === "live" && !task.locked && task.submissions.max > 0;
const showGallery = task.status === "completed" && viewer !== undefined;
const [submissions, reactions] = await Promise.all([
  showGallery || (takesEntries && viewer?.playerId)
    ? loadTaskSubmissions(task.id)
    : [],
  showGallery ? loadTaskReactions(task.id) : [],
]);
const submissionPanel = takesEntries
  ? getSubmissionPanel(task, submissions, submissionViewer)
  : undefined;
const gallery = getSocialGallery(
  task,
  getPublicSubmissionGallery(task, submissions, submissionViewer),
  reactions,
  submissionViewer,
);
// One group per entry, so a page break can fall between a player's entries.
const galleryPage = paginate(
  gallery.flatMap((group) =>
    group.entries.map((entry) => ({ owner: group.owner, entries: [entry] })),
  ),
  pageOf("entries"),
  GALLERY_PAGE_SIZE,
);
// Only the entries on show need signed media links.
const galleryPageGroups = await Promise.all(
  galleryPage.items.map(async (group) => ({
    ...group,
    entries: await presignEntryMedia(group.entries),
  })),
);
const peoplesChoice = getPeoplesChoice(task, submissionViewer);
const peoplesChoiceWinners = gallery.flatMap((group) =>
  group.entries.some((entry) => entry.social.winner) ? [group.owner.name] : [],
);
const galleryOutcomes: GalleryOutcome[] = [
  "reacted",
  "unreacted",
  "voted",
  "vote-changed",
  "vote-withdrawn",
  "vote-closed",
  "own-entry",
  "invalid",
];
const galleryParam = Astro.url.searchParams.get("gallery");
const galleryOutcome = galleryOutcomes.find((o) => o === galleryParam);

// "Call the winner": open while the task is live, revealed at the deadline.
const predictionPanel =
  task.status === "upcoming"
    ? undefined
    : getPredictionPanel(task, {
        signedIn: viewer !== undefined,
        ...(viewer?.playerId && { playerId: viewer.playerId }),
      });
const predictionOutcomes: PredictionOutcome[] = [
  "saved",
  "changed",
  "withdrawn",
  "closed",
  "invalid",
];
const predictionParam = Astro.url.searchParams.get("prediction");
const predictionOutcome = predictionOutcomes.find((o) => o === predictionParam);
const resultsHeld = task.status === "completed" && task.resultsHeld;
const entryCount = gallery.reduce((n, g) => n + g.entries.length, 0);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const squadCount = gallery.filter((g) => g.owner.type === "team").length;
const entrantsLabel = [
  squadCount > 0 && plural(squadCount, "squad"),
  gallery.length > squadCount && plural(gallery.length - squadCount, "player"),
]
  .filter(Boolean)
  .join(" and ");
// The submission endpoint redirects back with `?entry=<outcome>`.
const submissionOutcomes: SubmissionOutcome[] = [
  "submitted",
  "deleted",
  "closed",
  "full",
  "kind",
  "invalid",
  "too-large",
  "bad-type",
  "heic",
  "upload-failed",
];
const entryParam = Astro.url.searchParams.get("entry");
const submissionOutcome = submissionOutcomes.find((o) => o === entryParam);

const weekLabel = `WEEK ${String(task.weekNumber).padStart(2, "0")}`;
const isLocked = task.status === "upcoming";
const briefFile = `${task.id}.brief`;

const pageTitle = needsPassword
  ? `${weekLabel} — Encrypted`
  : `${weekLabel} — ${task.title}`;
const pageDescription = isLocked
  ? `${weekLabel} of the EAYL Taskmaster is still classified. The brief unlocks soon.`
  : needsPassword
    ? `${weekLabel} of the EAYL Taskmaster is live, but the brief is encrypted. Enter the Taskmaster's password to decrypt it.`
    : winner
      ? `${task.description} Won by ${winner.name}${winningScore ? ` with ${winningScore} pts` : ""}.`
      : task.description;

const dayFmt = ukDateFormat({
  weekday: "long",
  day: "2-digit",
  month: "long",
});
const timeFmt = ukDateFormat({
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const formatStamp = (iso: string) => {
  const d = new Date(iso);
  return `${dayFmt.format(d)}, ${timeFmt.format(d)}`;
};

// Standard competition rules shown on every brief (presentational content,
// identical for all tasks — not per-task entity data).
const { max: maxEntries, kinds: entryKinds } = task.submissions;
const rules = [
  maxEntries > 0
    ? `${maxEntries === 1 ? "One entry" : `Up to ${maxEntries} entries`} per ${isTeam ? "squad" : "player"} (${entryKinds.join(" or ")}), submitted here before the deadline.`
    : "One submission per player, before the deadline.",
  "No external help unless the brief explicitly allows it.",
  "Points are awarded by the Taskmaster. The Taskmaster's decision is final.",
  "Creativity is rewarded. Literalism is... noted.",
];

const medal = (position: number) =>
  position === 1 ? "🥇" : position === 2 ? "🥈" : position === 3 ? "🥉" : null;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    {
      revealPlay && (
        <DecryptReveal taskId={task.id} play={revealPlay} label={briefFile} />
      )
    }
    <SeasonArchiveBanner season={season} class="mb-6" />
    <!-- Back link + share -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <BackLink href="/tasks" label="ALL TASKS" />
      <div class="flex flex-wrap items-center gap-3">
        {
          viewer?.isAdmin && (
            <AdminEditLink
              href={weekHref(task.id)}
              subject={`the week ${task.weekNumber} task`}
            />
          )
        }
        <ShareButton
          url={new URL(Astro.url.pathname, Astro.site).href}
          shareTitle={`${pageTitle} · EAYL Taskmaster`}
          shareText={pageDescription}
          label="SHARE TASK"
        />
      </div>
    </div>

    <!-- Header -->
    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-sm font-bold tracking-[0.3em] text-magenta">
          {weekLabel}
        </span>
        <TaskStatusBadge status={task.status} locked={task.locked} />
        {
          isTeam && (
            <span class="inline-flex items-center rounded border border-magenta/40 bg-magenta/10 px-2 py-0.5 text-[10px] font-bold tracking-[0.2em] text-magenta">
              TEAM TASK
            </span>
          )
        }
      </div>
      {
        needsPassword ? (
          <h1 class="mt-3 text-4xl font-extrabold leading-tight text-ink-faint sm:text-6xl">
            <span aria-hidden="true">▓▓▓▓▒▒░ ▓▓▒░</span>
            <span class="sr-only">Encrypted task</span>
          </h1>
        ) : (
          <h1
            class="mt-3 text-4xl font-extrabold leading-tight text-ink text-glow sm:text-6xl"
            data-decrypt
          >
            {task.title}
          </h1>
        )
      }
    </header>

    <!-- The brief -->
    <section class="mt-8">
      <TerminalWindow
        title={`~/tasks/${briefFile}${needsPassword ? ".enc" : ""}`}
        meta={weekLabel}
      >
        {
          isLocked ? (
            <div class="py-6 text-center">
              <p class="text-5xl" aria-hidden="true">
                🔒
              </p>
              <p class="mt-4 text-sm text-ink-dim">
                <span class="text-acid">$</span> cat {task.id}.brief
              </p>
              <p class="mt-1 text-sm text-danger">
                permission denied: brief is classified
              </p>
              <p class="mt-4 text-xs tracking-widest text-ink-faint uppercase">
                Unlocks {formatStamp(task.releaseDate)}
              </p>
            </div>
          ) : needsPassword ? (
            <TaskRevealPrompt label={briefFile} error={revealError} />
          ) : (
            <div>
              {task.brief &&
                (Array.isArray(task.brief) ? (
                  <ul
                    class="space-y-3 border-l-2 border-acid pl-4"
                    data-decrypt
                  >
                    {task.brief.map((point) => (
                      <li class="flex gap-3 text-lg leading-relaxed text-ink sm:text-xl">
                        <span class="shrink-0 text-acid" aria-hidden="true">
                          &gt;
                        </span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <blockquote
                    class="border-l-2 border-acid pl-4 text-lg leading-relaxed text-ink sm:text-xl"
                    data-decrypt
                  >
                    {task.brief}
                  </blockquote>
                ))}
              <p class="mt-6 text-sm leading-relaxed text-ink-dim" data-decrypt>
                {task.description}
              </p>
              {task.status === "live" && (
                <p class="mt-6 font-bold tracking-widest text-acid">
                  &gt; Your time starts now
                  <span class="caret" />
                </p>
              )}
            </div>
          )
        }
      </TerminalWindow>
    </section>

    <!-- Schedule + countdown -->
    <section class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border border-grid bg-term-panel p-5">
        <p class="text-[10px] tracking-[0.2em] text-ink-faint uppercase">
          Released
        </p>
        <p class="mt-1 font-semibold text-acid">
          {formatStamp(task.releaseDate)}
        </p>
        <p class="mt-4 text-[10px] tracking-[0.2em] text-ink-faint uppercase">
          Deadline
        </p>
        <p class="mt-1 font-semibold text-amber">
          {formatStamp(task.deadline)}
        </p>
        {
          task.status !== "completed" && (
            <a
              href={withBase(`/tasks/${task.id}.ics`)}
              download={`${task.id}-deadline.ics`}
              class="mt-4 inline-flex items-center gap-2 rounded-md border border-grid px-3 py-1.5 text-[11px] font-bold tracking-widest text-ink-dim transition-colors hover:border-ink-faint hover:text-ink focus-visible:outline-none"
            >
              <svg
                class="h-3.5 w-3.5 text-ink-faint"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              ADD TO CALENDAR
            </a>
          )
        }
      </div>

      <div
        class="flex flex-col justify-center rounded-lg border border-grid bg-term-bg/50 p-5"
      >
        <p
          class="mb-3 text-center text-[10px] tracking-[0.3em] text-ink-faint uppercase"
        >
          {task.status === "completed" ? "task closed" : "time remaining"}
        </p>
        {
          task.status === "completed" ? (
            <p class="text-center text-2xl font-extrabold tracking-widest text-acid">
              &gt; COMPLETE
            </p>
          ) : (
            <Countdown
              deadline={
                task.status === "live" ? task.deadline : task.releaseDate
              }
            />
          )
        }
      </div>
    </section>

    <!-- Participating teams (team tasks only) -->
    {
      isTeam && (
        <section class="mt-8">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            teams --playing
          </h2>
          <p class="mb-4 text-sm leading-relaxed text-ink-dim">
            <span class="text-magenta">// </span>
            This is a team task. Players compete in their fixed teams of 4–5;
            the squad's points are shared by every member and also decide the
            <a
              href={withBase("/teams")}
              class="text-cyan underline-offset-2 hover:underline"
            >
              {" "}
              team leaderboard
            </a>
            .
          </p>
          <ul class="grid gap-3 sm:grid-cols-2">
            {teams.map((team) => (
              <li>
                <a
                  href={withBase(`/teams/${team.id}`)}
                  class="group flex h-full flex-col rounded-lg border border-grid bg-term-panel p-4 transition-colors hover:border-magenta"
                >
                  <span class="flex items-center justify-between gap-2">
                    <span class="text-sm font-extrabold text-ink group-hover:text-magenta">
                      {team.name}
                    </span>
                    <span class="text-[10px] tracking-widest text-ink-faint uppercase">
                      {team.memberIds.length} players
                    </span>
                  </span>
                  {team.tagline && (
                    <span class="mt-1 text-[11px] text-ink-faint">
                      <span class="text-acid">$</span> {team.tagline}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Rules -->
    {
      !isLocked && (
        <section class="mt-8">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            rules --list
          </h2>
          <ul class="space-y-2">
            {rules.map((rule, i) => (
              <li class="flex gap-3 rounded-md border border-grid bg-term-panel px-4 py-3 text-sm text-ink-dim">
                <span class="font-bold text-acid tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Entries — submit while the task is live -->
    {
      submissionPanel && (
        <section id="entries" class="mt-8 scroll-mt-24">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            entries --submit
          </h2>
          <TerminalWindow
            title={`~/tasks/${task.id}/entries`}
            meta={`closes ${formatStamp(task.deadline)}`}
          >
            <SubmissionPanel
              taskId={task.id}
              panel={submissionPanel}
              outcome={submissionOutcome}
              formatStamp={formatStamp}
            />
          </TerminalWindow>
        </section>
      )
    }

    <!-- Results held back for a live reveal -->
    {
      resultsHeld && (
        <a
          href={withBase("/live")}
          class="group mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-amber/40 bg-amber/5 px-5 py-4 transition-colors hover:border-amber"
        >
          <span class="flex items-center gap-2 text-[11px] font-bold tracking-widest text-amber uppercase">
            <span
              class="live-dot h-1.5 w-1.5 rounded-full bg-amber"
              aria-hidden="true"
            />{" "}
            results night
          </span>
          <span class="text-sm text-ink-dim">
            The Taskmaster is holding this week's results for a live reveal.
          </span>
          <span
            class="ml-auto text-xs font-bold tracking-widest text-amber uppercase group-hover:text-ink"
            aria-hidden="true"
          >
            watch live &rarr;
          </span>
        </a>
      )
    }

    <!-- Call the winner (live: make a call; afterwards: who backed whom) -->
    {
      predictionPanel && (
        <section id="predict" class="mt-10 scroll-mt-24">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            predict --winner
          </h2>
          <TerminalWindow
            title={`~/tasks/${task.id}/predictions`}
            meta={
              predictionPanel.status === "open"
                ? `locks ${formatStamp(task.deadline)}`
                : predictionPanel.status === "settled"
                  ? "settled"
                  : "locked"
            }
          >
            <PredictionPanel
              taskId={task.id}
              panel={predictionPanel}
              isTeam={isTeam}
              outcome={predictionOutcome}
            />
          </TerminalWindow>
        </section>
      )
    }

    <!-- Results — individual tasks (completed only) -->
    {
      task.status === "completed" && !isTeam && winner && (
        <section id="results" class="mt-10 scroll-mt-24">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            results --final
          </h2>

          {/* Winner spotlight */}
          <div class="mb-6 overflow-hidden rounded-xl border border-amber/40 bg-amber/5 p-6 text-center ring-1 ring-amber/20">
            <p class="text-[10px] tracking-[0.4em] text-amber uppercase">
              Winner
            </p>
            <p class="mt-2 text-4xl" aria-hidden="true">
              🥇
            </p>
            <a
              href={withBase(`/players/${winner.id}`)}
              class="mt-1 inline-block text-3xl font-extrabold text-ink text-glow hover:text-acid"
            >
              {winner.name}
            </a>
            {winningScore !== undefined && (
              <p class="mt-2 text-sm font-bold tracking-widest text-amber">
                {winningScore} POINTS
              </p>
            )}
          </div>

          {/* Full results table */}
          <div class="overflow-hidden rounded-lg border border-grid">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">
                Final results for {weekLabel}: {task.title}
              </caption>
              <thead>
                <tr class="border-b border-grid bg-term-bg/60 text-[10px] tracking-[0.2em] text-ink-faint uppercase">
                  <th scope="col" class="px-4 py-3 font-semibold">
                    Pos
                  </th>
                  <th scope="col" class="px-4 py-3 font-semibold">
                    Player
                  </th>
                  <th scope="col" class="px-4 py-3 text-right font-semibold">
                    Points
                  </th>
                </tr>
              </thead>
              <tbody>
                {resultsPage.items.map((row) => (
                  <tr class="border-b border-grid-soft last:border-b-0 hover:bg-term-panel/60">
                    <td class="px-4 py-3">
                      <span class="font-bold tabular-nums">
                        {medal(row.position) ?? (
                          <span class="text-ink-faint">
                            {String(row.position).padStart(2, "0")}
                          </span>
                        )}
                      </span>
                    </td>
                    <td class="px-4 py-3">
                      <a
                        href={withBase(`/players/${row.player.id}`)}
                        class="group inline-flex items-center gap-3"
                      >
                        <PlayerAvatar
                          player={row.player}
                          class="h-8 w-8 rounded"
                        />
                        <span class="font-semibold text-ink group-hover:text-acid">
                          {row.player.name}
                        </span>
                      </a>
                    </td>
                    <td class="px-4 py-3 text-right">
                      <ScoreBadge points={row.points} position={row.position} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <Pagination
            info={resultsPage}
            href={pageLinks("results", "results")}
            label="Results pages"
            itemLabel="players"
            class="mt-3"
          />
        </section>
      )
    }

    <!-- Results — team tasks (completed only) -->
    {
      task.status === "completed" && isTeam && winningTeam && (
        <section id="results" class="mt-10 scroll-mt-24">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            results --team --final
          </h2>

          {/* Winning squad spotlight */}
          <div class="mb-6 overflow-hidden rounded-xl border border-amber/40 bg-amber/5 p-6 text-center ring-1 ring-amber/20">
            <p class="text-[10px] tracking-[0.4em] text-amber uppercase">
              Winning squad
            </p>
            <p class="mt-2 text-4xl" aria-hidden="true">
              🏆
            </p>
            <a
              href={withBase(`/teams/${winningTeam.id}`)}
              class="mt-1 inline-block text-3xl font-extrabold text-ink text-glow hover:text-acid"
            >
              {winningTeam.name}
            </a>
            {winningScore !== undefined && (
              <p class="mt-2 text-sm font-bold tracking-widest text-amber">
                {winningScore} POINTS
              </p>
            )}
          </div>

          {/* Full team results table */}
          <div class="overflow-hidden rounded-lg border border-grid">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">
                Final team results for {weekLabel}: {task.title}
              </caption>
              <thead>
                <tr class="border-b border-grid bg-term-bg/60 text-[10px] tracking-[0.2em] text-ink-faint uppercase">
                  <th scope="col" class="px-4 py-3 font-semibold">
                    Pos
                  </th>
                  <th scope="col" class="px-4 py-3 font-semibold">
                    Squad
                  </th>
                  <th scope="col" class="px-4 py-3 text-right font-semibold">
                    Points
                  </th>
                </tr>
              </thead>
              <tbody>
                {teamResults.map((row) => (
                  <tr class="border-b border-grid-soft last:border-b-0 hover:bg-term-panel/60">
                    <td class="px-4 py-3">
                      <span class="font-bold tabular-nums">
                        {medal(row.position) ?? (
                          <span class="text-ink-faint">
                            {String(row.position).padStart(2, "0")}
                          </span>
                        )}
                      </span>
                    </td>
                    <td class="px-4 py-3">
                      <a
                        href={withBase(`/teams/${row.team.id}`)}
                        class="group inline-flex items-center gap-3"
                      >
                        <span class="flex -space-x-2" aria-hidden="true">
                          {row.members.slice(0, 5).map((member) => (
                            <PlayerAvatar
                              player={member}
                              class="h-7 w-7 rounded border border-term-bg"
                            />
                          ))}
                        </span>
                        <span class="font-semibold text-ink group-hover:text-acid">
                          {row.team.name}
                        </span>
                      </a>
                    </td>
                    <td class="px-4 py-3 text-right">
                      <ScoreBadge points={row.points} position={row.position} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <!-- Entries — public once the deadline has passed -->
    {
      gallery.length > 0 && (
        <section id="entries" class="mt-10 scroll-mt-24">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            entries --gallery
          </h2>
          <p class="mb-4 text-[11px] text-ink-faint">
            <span class="text-acid">$</span> {entryCount}{" "}
            {entryCount === 1 ? "entry" : "entries"} from {entrantsLabel}
          </p>
          <PeoplesChoiceBar
            summary={peoplesChoice}
            winnerNames={peoplesChoiceWinners}
            isPlayer={submissionViewer.playerId !== undefined}
            outcome={galleryOutcome}
            formatStamp={formatStamp}
            class="mb-4"
          />
          <SubmissionGallery
            taskId={task.id}
            groups={galleryPageGroups}
            page={galleryPage.page}
            formatStamp={formatStamp}
          />
          <Pagination
            info={galleryPage}
            href={pageLinks("entries", "entries")}
            label="Gallery pages"
            itemLabel="entries"
            class="mt-4"
          />
        </section>
      )
    }

    <!-- Bonus points & deductions given this week -->
    {
      bonuses.length > 0 && (
        <section
          id="bonuses"
          class="mt-10 scroll-mt-24"
          aria-labelledby="bonus-heading"
        >
          <h2
            id="bonus-heading"
            class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
          >
            bonus --week {String(task.weekNumber).padStart(2, "0")}
          </h2>
          <TerminalWindow
            title={`~/tasks/${task.id}.bonus`}
            meta={`${bonuses.length} ${bonuses.length === 1 ? "adjustment" : "adjustments"}`}
            bodyClass="p-0 sm:p-0"
          >
            <BonusPointsLedger
              entries={bonusPage.items}
              subject="player"
              caption={`Bonus points and deductions for ${weekLabel}: ${task.title}`}
            />
          </TerminalWindow>
          <Pagination
            info={bonusPage}
            href={pageLinks("bonuses", "bonuses")}
            label="Bonus pages"
            itemLabel="adjustments"
            class="mt-3"
          />
          <p class="mt-3 text-[11px] text-ink-faint">
            <span class="text-acid">//</span> Added to each player's overall
            total. They don't change this week's finishing positions.
          </p>
        </section>
      )
    }

    <!-- Episode recap link (completed, scored tasks only) -->
    {
      hasRecap && (
        <a
          href={withBase(`/recaps/${task.id}`)}
          class="group mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-magenta/40 bg-magenta/5 px-5 py-4 transition-colors hover:border-magenta"
        >
          <span class="flex items-center gap-2 text-[11px] font-bold tracking-widest text-magenta uppercase">
            <span aria-hidden="true">◆</span> episode recap
          </span>
          <span class="text-sm text-ink-dim">
            The full write-up — winner, biggest climber, points swing and the
            funniest moment.
          </span>
          <span
            class="ml-auto text-xs font-bold tracking-widest text-magenta uppercase group-hover:text-ink"
            aria-hidden="true"
          >
            read recap &rarr;
          </span>
        </a>
      )
    }

    <!-- Previous / next task pager -->
    <TaskPager prev={pager.prev} next={pager.next} class="mt-12" />
  </div>
</Layout>
