---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import StatCard from "../../components/StatCard.astro";
import ComparePicker from "../../components/ComparePicker.astro";
import ShareButton from "../../components/ShareButton.astro";
import BackLink from "../../components/BackLink.astro";
import PointsChart from "../../components/PointsChart.astro";
import AchievementBadge from "../../components/AchievementBadge.astro";
import PlayerAvatar from "../../components/PlayerAvatar.astro";
import BonusPointsLedger from "../../components/BonusPointsLedger.astro";
import { withBase } from "../../lib/url";

const {
  getTeamForPlayer,
  getPlayerStanding,
  getPlayerResults,
  getPlayerCompareOptions,
  getPlayerAchievements,
  getPlayerProgressionChart,
  getPlayerBonusSummary,
} = await Astro.locals.getQueries();

const { id } = Astro.params;
const standing = getPlayerStanding(id!);

// Unknown id → 404 rather than a broken page.
if (!standing) {
  return Astro.rewrite("/404");
}

const { player, rank } = standing;
const results = getPlayerResults(player.id);
const team = getTeamForPlayer(player.id);

const bio = player.bio?.trim() ?? "";

const hasPlayed = standing.tasksCompleted > 0;
const bestFinish = hasPlayed ? Math.min(...results.map((r) => r.position)) : 0;
const compareOptions = getPlayerCompareOptions(player.id);
const achievements = getPlayerAchievements(player.id);
const progressionChart = getPlayerProgressionChart(player.id);
const bonusSummary = getPlayerBonusSummary(player.id);

// Signed points with a true minus sign, e.g. "+3" / "−2" / "0".
const signed = (n: number) =>
  n > 0 ? `+${n}` : n < 0 ? `−${Math.abs(n)}` : "0";

const pageDescription = hasPlayed
  ? `${player.name} is #${rank} in the EAYL Taskmaster with ${standing.points} pts and ${standing.wins} win${standing.wins === 1 ? "" : "s"} across ${standing.tasksCompleted} task${standing.tasksCompleted === 1 ? "" : "s"}.`
  : `${player.name} is on the EAYL Taskmaster roster and yet to be scored.`;

const medal = (position: number) =>
  position === 1 ? "🥇" : position === 2 ? "🥈" : position === 3 ? "🥉" : null;

const ordinal = (n: number) => {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return `${n}${s[(v - 20) % 10] ?? s[v] ?? s[0]}`;
};

const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, "0")}`;

// Position cell tint, mirroring the leaderboard form guide.
const positionClasses = (position: number) => {
  if (position === 1) return "border-acid-dim bg-acid/10 text-acid";
  if (position <= 3) return "border-cyan/40 bg-cyan/5 text-cyan";
  return "border-grid bg-term-bg text-ink-dim";
};
---

<Layout title={player.name} description={pageDescription}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Back link -->
    <!-- Back link + share -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <BackLink href="/players" label="ALL PLAYERS" />
      <ShareButton
        url={new URL(Astro.url.pathname, Astro.site).href}
        shareTitle={`${player.name} · EAYL Taskmaster`}
        shareText={pageDescription}
        label="SHARE PROFILE"
      />
    </div>

    <!-- Header -->
    <header class="mt-6">
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        cat ~/players/{player.id}.md
      </p>
      <div class="mt-4 flex items-center gap-4 sm:gap-5">
        <PlayerAvatar
          player={player}
          class="h-16 w-16 rounded-lg sm:h-20 sm:w-20"
        />
        <div class="min-w-0">
          <h1
            class="truncate text-4xl font-extrabold tracking-tight text-ink text-glow sm:text-6xl"
          >
            {player.name}
          </h1>
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
            <span class="font-bold tracking-widest text-magenta">
              RANK #{rank}
            </span>
            <span class="text-ink-faint" aria-hidden="true">·</span>
            <span class="text-ink-dim">
              <span class="font-bold text-acid">{standing.points}</span> pts
            </span>
            <span class="text-ink-faint" aria-hidden="true">·</span>
            <span class="text-ink-dim">
              {standing.wins}{" "}
              {standing.wins === 1 ? "win" : "wins"}
            </span>
            {
              team && (
                <>
                  <span class="text-ink-faint" aria-hidden="true">
                    ·
                  </span>
                  <a
                    href={withBase(`/teams/${team.id}`)}
                    class="text-cyan underline-offset-2 hover:underline"
                  >
                    {team.name}
                  </a>
                </>
              )
            }
          </p>
        </div>
      </div>
    </header>

    <!-- Bio -->
    <section class="mt-6" aria-labelledby="bio-heading">
      <p
        id="bio-heading"
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        cat ~/players/{player.id}.bio
      </p>
      {
        bio ? (
          <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-dim">
            {bio}
          </p>
        ) : (
          <p class="mt-3 max-w-prose text-sm text-ink-faint italic">
            No bio yet.
          </p>
        )
      }
    </section>

    <!-- Key stats -->
    <section class="mt-8">
      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <StatCard
          value={`#${rank}`}
          label="League position"
          command="rank --self"
          accent="acid"
        />
        <StatCard
          value={standing.points}
          label="Total points"
          command={bonusSummary.net !== 0
            ? `sum scores ${signed(bonusSummary.net)} bonus`
            : "sum scores"}
          accent="magenta"
        />
        <StatCard
          value={standing.wins}
          label="Task wins"
          command="count wins"
          accent="cyan"
        />
        <StatCard
          value={hasPlayed ? standing.averagePosition.toFixed(1) : "—"}
          label="Average finish"
          command="avg position"
          accent="amber"
        />
      </div>
    </section>

    <!-- Achievements -->
    {
      achievements.length > 0 && (
        <section class="mt-8" aria-labelledby="achievements-heading">
          <h2
            id="achievements-heading"
            class="prompt mb-3 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
          >
            achievements --unlocked
          </h2>
          <ul class="flex flex-wrap gap-2">
            {achievements.map((achievement) => (
              <li>
                <AchievementBadge achievement={achievement} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Compare with… entry point -->
    <ComparePicker
      playerId={player.id}
      playerName={player.name}
      rival={compareOptions.rival}
      opponents={compareOptions.opponents}
      class="mt-8"
    />

    <!-- Points progression -->
    {
      progressionChart && (
        <section class="mt-12" aria-labelledby="progression-heading">
          <h2
            id="progression-heading"
            class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
          >
            points --over-time
          </h2>
          <TerminalWindow
            title={`~/players/${player.id}.chart`}
            meta={`${standing.points} pts`}
          >
            <PointsChart
              data={progressionChart}
              ariaLabel={`${player.name}'s cumulative points, week by week.`}
            />
          </TerminalWindow>
        </section>
      )
    }

    <!-- Task-by-task record -->
    <section class="mt-12">
      <div class="mb-4 flex items-end justify-between gap-4">
        <h2
          class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
        >
          history --player {player.id}
        </h2>
        {
          hasPlayed && bestFinish && (
            <span class="text-[11px] text-ink-faint">
              best finish: {medal(bestFinish) ?? ordinal(bestFinish)}
            </span>
          )
        }
      </div>

      <TerminalWindow
        title={`~/players/${player.id}.log`}
        meta={`${standing.tasksCompleted} tasks`}
        bodyClass="p-0 sm:p-0"
      >
        {
          hasPlayed ? (
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <caption class="sr-only">
                  {player.name}'s results, task by task
                </caption>
                <thead>
                  <tr class="border-b border-grid">
                    <th
                      scope="col"
                      class="px-3 py-2.5 text-left text-[10px] font-bold tracking-[0.2em] text-ink-faint uppercase"
                    >
                      Week
                    </th>
                    <th
                      scope="col"
                      class="px-3 py-2.5 text-left text-[10px] font-bold tracking-[0.2em] text-ink-faint uppercase"
                    >
                      Task
                    </th>
                    <th
                      scope="col"
                      class="px-3 py-2.5 text-center text-[10px] font-bold tracking-[0.2em] text-ink-faint uppercase"
                    >
                      Finish
                    </th>
                    <th
                      scope="col"
                      class="px-3 py-2.5 text-right text-[10px] font-bold tracking-[0.2em] text-ink-faint uppercase"
                    >
                      Pts
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {results.map((result) => (
                    <tr class="group border-b border-grid-soft transition-colors last:border-b-0 hover:bg-term-panel-2/60">
                      <td class="px-3 py-3 whitespace-nowrap text-[11px] font-bold tracking-[0.2em] text-magenta">
                        {weekLabel(result.task.weekNumber)}
                      </td>
                      <td class="px-3 py-3">
                        <a
                          href={withBase(`/tasks/${result.task.id}`)}
                          class="font-semibold text-ink group-hover:text-acid"
                        >
                          {result.task.title}
                        </a>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="inline-flex items-center gap-1.5">
                          {medal(result.position) && (
                            <span aria-hidden="true">
                              {medal(result.position)}
                            </span>
                          )}
                          <span
                            class:list={[
                              "inline-flex min-w-7 items-center justify-center rounded border px-1.5 py-0.5 text-[11px] font-bold tabular-nums",
                              positionClasses(result.position),
                            ]}
                          >
                            {ordinal(result.position)}
                          </span>
                        </span>
                      </td>
                      <td class="px-3 py-3 text-right">
                        <span class="text-base font-extrabold tabular-nums text-acid">
                          {result.points}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="px-4 py-10 text-center sm:px-6">
              <p class="text-4xl" aria-hidden="true">
                🫥
              </p>
              <p class="mt-3 text-sm text-ink-dim">
                <span class="text-acid">$</span> grep {player.id} scores.tsv
                &rarr; <span class="text-ink-faint">no matches yet</span>
              </p>
              <p class="mt-1 text-[11px] text-ink-faint">
                No tasks scored so far. Everyone starts at zero.
              </p>
            </div>
          )
        }
      </TerminalWindow>
    </section>

    <!-- Bonus points & deductions -->
    <section class="mt-12" aria-labelledby="bonus-heading">
      <div
        class="mb-4 flex flex-wrap items-end justify-between gap-x-4 gap-y-2"
      >
        <h2
          id="bonus-heading"
          class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
        >
          bonus --ledger
        </h2>
        {
          bonusSummary.entries.length > 0 && (
            <p class="flex flex-wrap gap-x-3 text-[11px] text-ink-faint">
              <span>
                bonuses{" "}
                <span class="font-bold tabular-nums text-acid">
                  {signed(bonusSummary.awarded)}
                </span>
              </span>
              <span aria-hidden="true">·</span>
              <span>
                deductions{" "}
                <span class="font-bold tabular-nums text-danger">
                  {signed(bonusSummary.deducted)}
                </span>
              </span>
              <span aria-hidden="true">·</span>
              <span>
                net{" "}
                <span class="font-bold tabular-nums text-ink">
                  {signed(bonusSummary.net)}
                </span>
              </span>
            </p>
          )
        }
      </div>

      <TerminalWindow
        title={`~/players/${player.id}.bonus`}
        meta={`net ${signed(bonusSummary.net)} pts`}
        bodyClass="p-0 sm:p-0"
      >
        <BonusPointsLedger
          entries={bonusSummary.entries}
          subject="week"
          caption={`${player.name}'s bonus points and deductions, week by week`}
          emptyMessage="No bonus points or deductions so far."
        />
      </TerminalWindow>

      <p class="mt-4 text-[11px] text-ink-faint">
        <span class="text-acid">//</span> Bonuses and deductions count toward the
        overall total but don't change a week's finishing positions. See the
        <a href={withBase("/leaderboard")} class="text-cyan hover:text-ink">
          {" "}full leaderboard{" "}
        </a>
        for live standings.
      </p>
    </section>
  </div>
</Layout>
