---
import SubmissionEntryCard from "./SubmissionEntryCard.astro";
import type { SubmissionGalleryGroup } from "../types";

interface Props {
  groups: SubmissionGalleryGroup[];
  /** Formats an ISO timestamp for display (the page owns date formatting). */
  formatStamp: (iso: string) => string;
  class?: string;
}

const { groups, formatStamp, class: className } = Astro.props;
---

<ul class:list={["grid gap-3 sm:grid-cols-2 lg:grid-cols-3", className]}>
  {
    groups.flatMap((group) =>
      group.entries.map((entry) => (
        <li class="flex min-w-0 flex-col gap-1.5">
          <a
            href={group.owner.href}
            class:list={[
              "truncate text-sm font-extrabold transition-colors hover:text-acid active:text-acid",
              group.owner.type === "team" ? "text-magenta" : "text-ink",
            ]}
          >
            {group.owner.name}
          </a>
          <SubmissionEntryCard
            entry={entry}
            formatStamp={formatStamp}
            showSubmitter={group.owner.type === "team"}
            class="flex-1"
          />
        </li>
      )),
    )
  }
</ul>
