{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskmaster-ui",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Both hosts are served by this Worker; the middleware 301s `www` to the
  // apex so there's a single canonical origin (and one Neon Auth domain).
  "routes": [
    { "pattern": "eayltaskmaster.co.uk", "custom_domain": true },
    { "pattern": "www.eayltaskmaster.co.uk", "custom_domain": true },
  ],
  // Secrets (set with `npx wrangler secret put <NAME>`): DATABASE_URL,
  // NEON_AUTH_BASE_URL, NEON_AUTH_COOKIE_SECRET. Locally they come from
  // `.env.local`.
  // Throttles guesses at a task's reveal password: 10 per minute per IP+task.
  "ratelimits": [
    {
      "name": "TASK_REVEAL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
