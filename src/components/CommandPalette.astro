---
import type { CommandPaletteItem } from "../types";

interface Props {
  /** Full searchable index of pages, tasks, teams and players. */
  items: CommandPaletteItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<!--
  Global command palette (Cmd/Ctrl+K). Hidden by default and opened purely
  via progressive enhancement; the index is handed in as a prop and shipped
  to the client as JSON so no raw data is imported here.
-->
<div
  id="command-palette"
  class:list={[
    "fixed inset-0 z-[80] hidden items-start justify-center px-4 pt-[12vh]",
    className,
  ]}
  role="dialog"
  aria-modal="true"
  aria-label="Command palette"
>
  <div
    data-palette-backdrop
    class="absolute inset-0 bg-term-bg/80 backdrop-blur-sm"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative w-full max-w-xl overflow-hidden rounded-lg border border-grid bg-term-panel shadow-[0_0_40px_-12px] shadow-acid/20"
  >
    <!-- Title bar -->
    <div
      class="flex items-center gap-3 border-b border-grid bg-term-panel-2 px-4 py-2.5"
    >
      <span class="flex items-center gap-1.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-dot-red"></span>
        <span class="h-3 w-3 rounded-full bg-dot-amber"></span>
        <span class="h-3 w-3 rounded-full bg-dot-green"></span>
      </span>
      <span class="text-xs tracking-[0.2em] text-ink-faint">~/command</span>
    </div>

    <!-- Input row -->
    <div class="flex items-center gap-2 border-b border-grid px-4 py-3">
      <span class="text-acid" aria-hidden="true">$</span>
      <input
        id="command-palette-input"
        type="text"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="search, or try 'week 3' · 'rose vs luke'…"
        class="w-full bg-transparent text-sm text-ink placeholder:text-ink-faint focus:outline-none"
        role="combobox"
        aria-expanded="true"
        aria-controls="command-palette-list"
        aria-autocomplete="list"
        aria-activedescendant=""
      />
    </div>

    <!-- Results -->
    <ul
      id="command-palette-list"
      role="listbox"
      aria-label="Results"
      class="max-h-[50vh] overflow-y-auto py-2"
    >
    </ul>
    <p
      data-palette-empty
      class="hidden px-4 py-6 text-center text-sm text-ink-faint"
    >
      <span class="text-danger" aria-hidden="true">!</span> no matches — try another
      search
    </p>

    <!-- Footer hints -->
    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-grid bg-term-panel-2 px-4 py-2 text-[10px] tracking-[0.15em] text-ink-faint uppercase [&_kbd]:rounded [&_kbd]:border [&_kbd]:border-grid [&_kbd]:bg-term-bg [&_kbd]:px-1.5 [&_kbd]:py-0.5 [&_kbd]:text-ink-dim"
    >
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <span class="hidden sm:inline"
        ><kbd>week&nbsp;3</kbd> jump · <kbd>a&nbsp;vs&nbsp;b</kbd> compare</span
      >
    </div>
  </div>
</div>

<script
  type="application/json"
  id="command-palette-data"
  set:html={JSON.stringify(items)}
/>

<script>
  import { applyTheme, type ThemeName } from "../lib/theme";

  interface PaletteItem {
    id: string;
    label: string;
    group: "page" | "task" | "team" | "player" | "action";
    href: string;
    hint?: string;
    keywords?: string;
  }

  const palette = document.getElementById("command-palette");
  const input = document.getElementById(
    "command-palette-input",
  ) as HTMLInputElement | null;
  const list = document.getElementById("command-palette-list");
  const empty = palette?.querySelector<HTMLElement>("[data-palette-empty]");
  const backdrop = palette?.querySelector<HTMLElement>(
    "[data-palette-backdrop]",
  );
  const dataEl = document.getElementById("command-palette-data");

  if (palette && input && list && dataEl) {
    const items: PaletteItem[] = JSON.parse(dataEl.textContent || "[]");

    const groupGlyph: Record<PaletteItem["group"], string> = {
      action: "»",
      page: "./",
      task: "#",
      team: "&",
      player: "@",
    };
    const groupLabel: Record<PaletteItem["group"], string> = {
      action: "actions",
      page: "pages",
      task: "tasks",
      team: "teams",
      player: "players",
    };
    const groupOrder: PaletteItem["group"][] = [
      "page",
      "task",
      "team",
      "player",
    ];

    // ── Dynamic commands (keyboard-first navigation) ───────────────────────
    // A few typed queries synthesize navigation shortcuts on the fly instead
    // of plain search hits: "week 3" jumps to that task, "rose vs luke" opens
    // the head-to-head. Everything is derived from the shipped index, so no
    // extra data is imported here — just reshaped on the client.
    const playerItems = items.filter((i) => i.group === "player");

    // Derive the site's base path from a real link so synthesized hrefs work
    // under a sub-path deploy (e.g. GitHub Pages) as well as at the root.
    const siteBase = (() => {
      const href = (playerItems[0] ?? items[0])?.href ?? "";
      const match = href.match(/^(.*)\/players\/[^/]+\/?$/);
      return match ? match[1] : "";
    })();

    const idFromHref = (href: string) =>
      href.split(/[?#]/)[0].replace(/\/+$/, "").split("/").pop() ?? "";

    // Week number → task item, parsed from the `week-NN` slug in the href/id.
    const tasksByWeek = new Map<number, PaletteItem>();
    for (const item of items) {
      if (item.group !== "task") continue;
      const m = item.href.match(/week-(\d+)/) ?? item.id.match(/week-(\d+)/);
      if (m) tasksByWeek.set(parseInt(m[1], 10), item);
    }

    const rankOf = (item: PaletteItem) => {
      const m = (item.hint ?? "").match(/#(\d+)/);
      return m ? parseInt(m[1], 10) : Infinity;
    };
    const leaderItem = playerItems
      .slice()
      .sort((a, b) => rankOf(a) - rankOf(b))[0];

    // Best fuzzy player match for a loose term (reuses the shared scorer).
    function findPlayer(term: string): PaletteItem | null {
      const t = term.trim().toLowerCase();
      if (!t) return null;
      let best: PaletteItem | null = null;
      let bestScore = Infinity;
      for (const item of playerItems) {
        const s = score(item, t);
        if (s === null) continue;
        if (s < bestScore) {
          bestScore = s;
          best = item;
        }
      }
      return best;
    }

    function makeAction(
      id: string,
      label: string,
      href: string,
      hint?: string,
    ): PaletteItem {
      return { id, label, group: "action", href, hint };
    }

    function resolveCommands(query: string): PaletteItem[] {
      const lower = query.trim().toLowerCase();
      if (!lower) return [];
      const actions: PaletteItem[] = [];

      // Compare: "compare X vs Y", "diff X / Y", or just "X vs Y".
      const hasVerb = /^(compare|cmp|diff)\b/.test(lower);
      const body = lower.replace(/^(compare|cmp|diff|versus|vs)\s+/, "");
      const sides = body.split(/\s+(?:vs\.?|versus|v|x|\/)\s+/);
      if (sides.length === 2) {
        const a = findPlayer(sides[0]);
        const b = findPlayer(sides[1]);
        if (a && b && a !== b) {
          const aid = idFromHref(a.href);
          const bid = idFromHref(b.href);
          actions.push(
            makeAction(
              `cmp-${aid}-${bid}`,
              `Compare ${a.label} vs ${b.label}`,
              `${siteBase}/compare/${aid}/${bid}`,
              "head-to-head",
            ),
          );
        }
      } else if (hasVerb && leaderItem) {
        // "compare X" with no opponent → pit them against the current leader.
        const a = findPlayer(body);
        if (a && a !== leaderItem) {
          const aid = idFromHref(a.href);
          const bid = idFromHref(leaderItem.href);
          actions.push(
            makeAction(
              `cmp-${aid}-${bid}`,
              `Compare ${a.label} vs ${leaderItem.label}`,
              `${siteBase}/compare/${aid}/${bid}`,
              "vs leader",
            ),
          );
        }
      }

      // Jump to week N: "week 3", "wk 3", "w3", "task 7", or a bare "3".
      const weekMatch =
        lower.match(/^(?:jump\s+to\s+)?(?:week|wk|w|task|t)\s*0*(\d{1,2})$/) ??
        lower.match(/^0*(\d{1,2})$/);
      if (weekMatch) {
        const n = parseInt(weekMatch[1], 10);
        const task = tasksByWeek.get(n);
        if (task) {
          actions.push(
            makeAction(
              `jump-week-${n}`,
              `Jump to Week ${String(n).padStart(2, "0")} — ${task.label}`,
              task.href,
              task.hint,
            ),
          );
        }
      }

      return actions;
    }

    let options: HTMLLIElement[] = [];
    let activeIndex = 0;
    let lastFocused: HTMLElement | null = null;

    // ── Easter egg: a tiny fake shell ──────────────────────────────────────
    // Typing a shell-style command prints a cheeky response instead of search
    // results. Pure fun for anyone who treats the prompt like a real terminal.
    interface Secret {
      /** What to echo back on the `$` line (the user's own input). */
      echo: string;
      /** Response lines. A leading "> " renders a cyan marker, "! " a red one. */
      lines: string[];
      /** Optional action bound to Enter (e.g. exit closes the palette). */
      onEnter?: () => void;
    }

    let currentSecret: Secret | null = null;

    // ── Easter-egg CRT theme switcher ──────────────────────────────────────
    // Typing `theme amber` (and friends) in this prompt recolours the whole
    // UI to an alternate phosphor. Hidden on purpose: there is no visible
    // control, only this command. Aliases keep it forgiving.
    const THEME_ALIASES: Record<string, ThemeName> = {
      green: "dark",
      dark: "dark",
      p1: "dark",
      default: "dark",
      light: "light",
      paper: "light",
      day: "light",
      amber: "amber",
      gold: "amber",
      orange: "amber",
      p3: "amber",
      cyan: "cyan",
      ice: "cyan",
      blue: "cyan",
      magenta: "magenta",
      pink: "magenta",
      synthwave: "magenta",
      vapor: "magenta",
      vaporwave: "magenta",
    };
    const THEME_LABELS: Record<ThemeName, string> = {
      dark: "green phosphor",
      light: "paper terminal",
      amber: "amber phosphor",
      cyan: "ice phosphor",
      magenta: "synthwave",
    };

    const eggToast = (
      msg: string,
      tone: "acid" | "magenta" | "amber" = "acid",
    ) =>
      (
        window as unknown as {
          __eggToast?: (m: string, t?: "acid" | "magenta" | "amber") => void;
        }
      ).__eggToast?.(msg, tone);

    function resolveTheme(raw: string, q: string): Secret {
      const arg = q.replace(/^(theme|crt|phosphor)\s*/, "").trim();

      if (!arg || arg === "list" || arg === "ls" || arg === "help") {
        return {
          echo: raw,
          lines: [
            "CRT phosphor bank — pick your glass:",
            "  theme green     P1 · the original (default)",
            "  theme amber     P3 · warm monochrome",
            "  theme cyan      ice · cold cathode",
            "  theme magenta   synthwave",
            "  theme light     paper terminal",
            "",
            "> e.g. 'theme amber', then press ↵",
          ],
        };
      }

      const target = THEME_ALIASES[arg];
      if (!target) {
        return {
          echo: raw,
          lines: [
            `! unknown phosphor '${arg}'.`,
            "> try: green · amber · cyan · magenta · light",
          ],
        };
      }

      return {
        echo: raw,
        lines: [`> glass: ${THEME_LABELS[target]}`, "> press ↵ to apply."],
        onEnter: () => {
          applyTheme(target);
          eggToast(
            `CRT GLASS → ${THEME_LABELS[target].toUpperCase()}`,
            "amber",
          );
        },
      };
    }

    function resolveSecret(raw: string): Secret | null {
      const q = raw.toLowerCase();
      if (!q) return null;

      if (
        q === "theme" ||
        q.startsWith("theme ") ||
        q === "crt" ||
        q.startsWith("crt ") ||
        q === "phosphor" ||
        q.startsWith("phosphor ")
      ) {
        return resolveTheme(raw, q);
      }

      if (q === "echo" || q.startsWith("echo ")) {
        return { echo: raw, lines: [raw.slice(4).trim()] };
      }

      if (q === "sudo" || q.startsWith("sudo ")) {
        const rest = q.slice(4).trim();
        if (rest === "make me a sandwich") {
          return { echo: raw, lines: ["Okay."] };
        }
        if (rest.startsWith("make me a")) {
          return { echo: raw, lines: ["What? Make it yourself."] };
        }
        return {
          echo: raw,
          lines: [
            "[sudo] password for guest: ",
            "",
            "! Nice try. This incident has been reported to the Taskmaster.",
          ],
        };
      }

      if (q.startsWith("rm ")) {
        return {
          echo: raw,
          lines: [
            "rm: removing the entire leaderboard...",
            "! permission denied — the Taskmaster is watching.",
          ],
        };
      }

      if (q.startsWith("cat ")) {
        const file = q.slice(4).trim();
        if (file.includes("secret") || file.includes("do_not_open")) {
          return {
            echo: raw,
            lines: [
              "> It was never about the points.",
              "> It was about the friends we scored along the way.",
            ],
          };
        }
        return {
          echo: raw,
          lines: [`cat: ${file}: No such file or directory`],
        };
      }

      switch (q) {
        case "help":
        case "?":
          return {
            echo: raw,
            lines: [
              "available commands:",
              "  whoami   ls        date      coffee",
              "  echo …   sudo …    cat …     fortune",
              "  uptime   credits   konami    clear",
              "  greg     42        hello     exit",
              "",
              "> everything else just searches. happy hunting.",
            ],
          };
        case "whoami":
          return { echo: raw, lines: ["guest — ranked: unranked (for now)"] };
        case "ls":
        case "ls -la":
        case "dir":
          return {
            echo: raw,
            lines: [
              "drwxr-xr-x   tasks/",
              "drwxr-xr-x   players/",
              "drwxr-xr-x   leaderboard/",
              "-rw-------   secret_plans.txt",
              "-rw-r--r--   do_not_open.md",
            ],
          };
        case "date":
          return { echo: raw, lines: ["> " + new Date().toString()] };
        case "coffee":
        case "make coffee":
          return {
            echo: raw,
            lines: [
              "      ( (",
              "       ) )",
              "    ........",
              "    |      |]",
              "    \\      /",
              "     `----'",
              "brewing… productivity +10",
            ],
          };
        case "hello":
        case "hi":
        case "hey":
          return {
            echo: raw,
            lines: ["> Hello there. Ready to climb the leaderboard?"],
          };
        case "greg":
        case "taskmaster":
          return {
            echo: raw,
            lines: ['> "Your time starts… now." — the Taskmaster'],
          };
        case "42":
        case "the answer":
          return {
            echo: raw,
            lines: ["> The answer to life, the universe, and everything."],
          };
        case "exit":
        case "quit":
        case ":q":
          return {
            echo: raw,
            lines: ["logging out… (press ↵ to close)"],
            onEnter: () => close(),
          };
        case ":wq":
          return { echo: raw, lines: ["saved. (nothing was actually saved)"] };
        case "vim":
        case "vi":
        case "nano":
          return {
            echo: raw,
            lines: ["> you're already in the only editor that matters."],
          };
        case "clear":
        case "cls":
          return { echo: raw, lines: ["(nothing to see here… yet)"] };
        case "konami":
          return {
            echo: raw,
            lines: ["> ↑ ↑ ↓ ↓ ← → ← → B A", "> go on, try it."],
          };
        case "uptime":
          return {
            echo: raw,
            lines: ["up 16 weeks · 25 players · load average: intense"],
          };
        case "credits":
          return {
            echo: raw,
            lines: [
              "EAYL TASKMASTER",
              "> built by the Engineering Academy",
              "> terminal easter eggs included at no extra charge",
            ],
          };
        case "sl":
          return {
            echo: raw,
            lines: [
              "      ====        ________                ___________",
              "  _D _|  |_______/        \\__I_I_____===__|_________|",
              "   |(_)---  |   H\\________/ |   |        =|___ ___|  ",
              "   /     |  |   H  |  |     |   |         ||_| |_||  ",
              "  |      |  |   H  |__--------------------| [___] |  ",
              "> (you typed 'ls' too fast.)",
            ],
          };
        case "fortune": {
          const fortunes = [
            "> A task a day keeps the bottom of the table away.",
            "> The points mean everything. — the Taskmaster",
            "> Somewhere, a spreadsheet is judging you.",
            "> Your next idea is better than your last excuse.",
            "> Ship it. The deadline waits for no one.",
          ];
          return {
            echo: raw,
            lines: [fortunes[Math.floor(Math.random() * fortunes.length)]],
          };
        }
        default:
          return null;
      }
    }

    function secretLine(text: string): HTMLDivElement {
      const div = document.createElement("div");
      div.className = "whitespace-pre-wrap break-words";
      let marker = "";
      let markerClass = "";
      if (text.startsWith("> ")) {
        marker = ">";
        markerClass = "text-cyan";
        text = text.slice(2);
      } else if (text.startsWith("! ")) {
        marker = "!";
        markerClass = "text-danger";
        text = text.slice(2);
      }
      if (marker) {
        const m = document.createElement("span");
        m.className = `mr-2 ${markerClass}`;
        m.setAttribute("aria-hidden", "true");
        m.textContent = marker;
        div.appendChild(m);
        div.appendChild(document.createTextNode(text));
        div.classList.add("text-ink");
      } else {
        div.classList.add("text-ink-dim");
        div.textContent = text;
      }
      return div;
    }

    function renderSecret(secret: Secret) {
      list!.innerHTML = "";
      options = [];
      empty?.classList.add("hidden");
      input?.setAttribute("aria-activedescendant", "");

      const li = document.createElement("li");
      li.setAttribute("role", "presentation");
      li.className = "px-4 py-4 text-sm leading-relaxed";

      const echo = document.createElement("div");
      echo.className = "mb-2 flex gap-2";
      const dollar = document.createElement("span");
      dollar.className = "text-acid";
      dollar.setAttribute("aria-hidden", "true");
      dollar.textContent = "$";
      const cmd = document.createElement("span");
      cmd.className = "break-words text-ink";
      cmd.textContent = secret.echo;
      echo.appendChild(dollar);
      echo.appendChild(cmd);
      li.appendChild(echo);

      for (const line of secret.lines) li.appendChild(secretLine(line));

      list!.appendChild(li);
    }

    // Subsequence fuzzy match: every query char must appear in order. Returns
    // a score (lower = better) or null when there is no match.
    function score(item: PaletteItem, query: string): number | null {
      if (!query) return 0;
      const haystack =
        `${item.label} ${item.hint ?? ""} ${item.keywords ?? ""}`.toLowerCase();
      const label = item.label.toLowerCase();
      if (label.startsWith(query)) return -2;
      if (label.includes(query)) return -1;
      let hi = 0;
      for (let qi = 0; qi < query.length; qi++) {
        hi = haystack.indexOf(query[qi], hi);
        if (hi === -1) return null;
        hi++;
      }
      return hi;
    }

    function setActive(index: number) {
      if (options.length === 0) return;
      activeIndex = (index + options.length) % options.length;
      options.forEach((opt, i) => {
        const on = i === activeIndex;
        opt.setAttribute("aria-selected", String(on));
        opt.classList.toggle("bg-acid/10", on);
        opt.classList.toggle("border-acid", on);
        opt.classList.toggle("border-transparent", !on);
        opt.classList.toggle("text-ink", on);
      });
      const active = options[activeIndex];
      input?.setAttribute("aria-activedescendant", active.id);
      active.scrollIntoView({ block: "nearest" });
    }

    function createOption(item: PaletteItem): HTMLLIElement {
      const li = document.createElement("li");
      li.id = `palette-opt-${item.id}`;
      li.setAttribute("role", "option");
      li.dataset.href = item.href;
      li.className =
        "mx-2 flex cursor-pointer items-center gap-3 rounded border-l-2 border-transparent px-3 py-2 text-sm text-ink-dim transition-colors hover:bg-acid/10 hover:text-ink";

      const glyph = document.createElement("span");
      glyph.className =
        item.group === "action"
          ? "w-5 shrink-0 text-acid"
          : "w-5 shrink-0 text-cyan";
      glyph.setAttribute("aria-hidden", "true");
      glyph.textContent = groupGlyph[item.group];
      li.appendChild(glyph);

      const label = document.createElement("span");
      label.className = "flex-1 truncate font-semibold";
      label.textContent = item.label;
      li.appendChild(label);

      if (item.hint) {
        const hint = document.createElement("span");
        hint.className =
          "shrink-0 text-[11px] tracking-wide text-ink-faint tabular-nums";
        hint.textContent = item.hint;
        li.appendChild(hint);
      }

      li.addEventListener("mouseenter", () => setActive(options.indexOf(li)));
      li.addEventListener("click", () => go(li));
      return li;
    }

    function appendGroup(group: PaletteItem["group"], entries: PaletteItem[]) {
      if (entries.length === 0) return;

      const header = document.createElement("li");
      header.setAttribute("role", "presentation");
      header.className =
        "px-4 pt-3 pb-1 text-[10px] tracking-[0.25em] text-ink-faint uppercase";
      header.textContent = groupLabel[group];
      list!.appendChild(header);

      for (const item of entries) {
        const li = createOption(item);
        list!.appendChild(li);
        options.push(li);
      }
    }

    function render(query: string) {
      currentSecret = resolveSecret(query);
      if (currentSecret) {
        renderSecret(currentSecret);
        return;
      }

      list!.innerHTML = "";
      options = [];

      // Synthesized shortcuts (jump to week / compare) always sit on top.
      const actions = resolveCommands(query);

      const matches = items
        .map((item) => ({ item, s: score(item, query) }))
        .filter((m): m is { item: PaletteItem; s: number } => m.s !== null)
        .sort((a, b) => a.s - b.s);

      if (actions.length === 0 && matches.length === 0) {
        empty?.classList.remove("hidden");
        input?.setAttribute("aria-activedescendant", "");
        return;
      }
      empty?.classList.add("hidden");

      appendGroup("action", actions);
      for (const group of groupOrder) {
        appendGroup(
          group,
          matches.filter((m) => m.item.group === group).map((m) => m.item),
        );
      }

      setActive(0);
    }

    function go(opt: HTMLLIElement) {
      const href = opt.dataset.href;
      if (href) window.location.href = href;
    }

    function open() {
      if (!palette!.classList.contains("hidden")) return;
      lastFocused = document.activeElement as HTMLElement | null;
      palette!.classList.remove("hidden");
      palette!.classList.add("flex");
      document.body.style.overflow = "hidden";
      input!.value = "";
      render("");
      input!.focus();
    }

    function close() {
      palette!.classList.add("hidden");
      palette!.classList.remove("flex");
      document.body.style.overflow = "";
      lastFocused?.focus();
    }

    function toggle() {
      palette!.classList.contains("hidden") ? open() : close();
    }

    input.addEventListener("input", () => render(input.value.trim()));

    input.addEventListener("keydown", (e) => {
      switch (e.key) {
        case "ArrowDown":
          e.preventDefault();
          setActive(activeIndex + 1);
          break;
        case "ArrowUp":
          e.preventDefault();
          setActive(activeIndex - 1);
          break;
        case "Enter":
          e.preventDefault();
          if (currentSecret?.onEnter) {
            currentSecret.onEnter();
          } else if (options[activeIndex]) {
            go(options[activeIndex]);
          }
          break;
      }
    });

    palette.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      }
    });

    backdrop?.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        toggle();
      }
    });

    document
      .querySelectorAll<HTMLElement>("[data-command-palette-trigger]")
      .forEach((trigger) => trigger.addEventListener("click", open));
  }
</script>
