---
import type { LeaderboardRow, PlayerFlair } from "../types";
import { withBase } from "../lib/url";
import PlayerAvatar from "./PlayerAvatar.astro";
import PlayerFlairName from "./PlayerFlairName.astro";

interface Props {
  rows: LeaderboardRow[];
  /** Clim Coin flair (name colour, pet) by player id. */
  flair?: Record<string, PlayerFlair>;
  class?: string;
}

const { rows, flair = {}, class: className = "" } = Astro.props;

const medal = (rank: number) =>
  rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null;

// Tint the podium rows so the top three stand out in the dense table.
const rowAccent = (rank: number) => {
  if (rank === 1) return "bg-amber/5";
  if (rank === 2) return "bg-ink/5";
  if (rank === 3) return "bg-acid/5";
  return "";
};

// Colour a single recent finishing position in the form guide.
const formClasses = (position: number) => {
  if (position === 1) return "border-acid-dim bg-acid/10 text-acid";
  if (position <= 3) return "border-cyan/40 bg-cyan/5 text-cyan";
  return "border-grid bg-term-bg text-ink-faint";
};

// Rank movement since the previous task: climbed (▲), dropped (▼) or held (–).
const movementMeta = (movement?: number) => {
  if (typeof movement !== "number") return null;
  if (movement > 0)
    return {
      icon: "▲",
      text: String(movement),
      cls: "text-acid",
      label: `up ${movement}`,
    };
  if (movement < 0)
    return {
      icon: "▼",
      text: String(Math.abs(movement)),
      cls: "text-danger",
      label: `down ${Math.abs(movement)}`,
    };
  return { icon: "–", text: "", cls: "text-ink-faint", label: "no change" };
};

const th =
  "px-3 py-2.5 text-left text-[10px] font-bold tracking-[0.2em] text-ink-faint uppercase";
const thBtn =
  "inline-flex items-center gap-1 whitespace-nowrap uppercase tracking-[0.2em] transition-colors hover:text-ink focus-visible:outline-none";

// Sort value used for the "avg pos" column: players who have not been scored
// sink to the bottom when sorting best-first rather than appearing as "0".
const avgSortValue = (row: LeaderboardRow) =>
  row.tasksCompleted > 0 ? row.averagePosition : 9999;
---

<div class:list={["overflow-x-auto", className]} data-sortable-standings>
  <table class="w-full border-collapse text-sm">
    <caption class="sr-only">
      Full competition standings. Column headers can be used to re-sort the
      table.
    </caption>
    <thead>
      <tr class="border-b border-grid">
        <th
          scope="col"
          class:list={[th, "w-12 text-center"]}
          aria-sort="ascending"
        >
          <button
            type="button"
            class:list={[thBtn, "mx-auto"]}
            data-sort-key="rank"
            data-sort-type="num"
            data-default-dir="asc"
          >
            #<span
              class="cd-sort-arrow text-[9px]"
              data-arrow
              aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" class={th} aria-sort="none">
          <button
            type="button"
            class={thBtn}
            data-sort-key="name"
            data-sort-type="str"
            data-default-dir="asc"
          >
            Player<span
              class="cd-sort-arrow text-[9px]"
              data-arrow
              aria-hidden="true"></span>
          </button>
        </th>
        <th
          scope="col"
          class:list={[th, "hidden text-center sm:table-cell"]}
          aria-sort="none"
        >
          <button
            type="button"
            class:list={[thBtn, "mx-auto"]}
            data-sort-key="played"
            data-sort-type="num"
            data-default-dir="desc"
          >
            Played<span
              class="cd-sort-arrow text-[9px]"
              data-arrow
              aria-hidden="true"></span>
          </button>
        </th>
        <th
          scope="col"
          class:list={[th, "hidden text-center sm:table-cell"]}
          aria-sort="none"
        >
          <button
            type="button"
            class:list={[thBtn, "mx-auto"]}
            data-sort-key="wins"
            data-sort-type="num"
            data-default-dir="desc"
          >
            Wins<span
              class="cd-sort-arrow text-[9px]"
              data-arrow
              aria-hidden="true"></span>
          </button>
        </th>
        <th
          scope="col"
          class:list={[th, "hidden text-center lg:table-cell"]}
          aria-sort="none"
        >
          <button
            type="button"
            class:list={[thBtn, "mx-auto"]}
            data-sort-key="avg"
            data-sort-type="num"
            data-default-dir="asc"
          >
            Avg&nbsp;pos<span
              class="cd-sort-arrow text-[9px]"
              data-arrow
              aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" class:list={[th, "hidden lg:table-cell"]}>Form</th>
        <th scope="col" class:list={[th, "text-right"]} aria-sort="none">
          <button
            type="button"
            class:list={[thBtn, "ml-auto"]}
            data-sort-key="pts"
            data-sort-type="num"
            data-default-dir="desc"
          >
            Pts<span
              class="cd-sort-arrow text-[9px]"
              data-arrow
              aria-hidden="true"></span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr
            class:list={[
              "group border-b border-grid-soft transition-colors last:border-b-0 hover:bg-term-panel-2/60",
              rowAccent(row.rank),
            ]}
            data-me-row
            data-player-id={row.player.id}
            data-rank={row.rank}
            data-name={row.player.name.toLowerCase()}
            data-played={row.tasksCompleted}
            data-wins={row.wins}
            data-avg={avgSortValue(row)}
            data-pts={row.points}
          >
            <td class="px-3 py-3 text-center">
              {medal(row.rank) ? (
                <span class="text-lg" aria-hidden="true">
                  {medal(row.rank)}
                </span>
              ) : (
                <span class="text-sm font-bold tabular-nums text-ink-faint">
                  {String(row.rank).padStart(2, "0")}
                </span>
              )}
              <span class="sr-only">Rank {row.rank}</span>
              {movementMeta(row.movement) && (
                <span
                  class:list={[
                    "mt-1 flex items-center justify-center gap-0.5 text-[10px] font-bold tabular-nums",
                    movementMeta(row.movement)!.cls,
                  ]}
                >
                  <span aria-hidden="true">
                    {movementMeta(row.movement)!.icon}
                  </span>
                  {movementMeta(row.movement)!.text}
                  <span class="sr-only">
                    {movementMeta(row.movement)!.label}
                  </span>
                </span>
              )}
            </td>

            <td class="px-3 py-3">
              <a
                href={withBase(`/players/${row.player.id}`)}
                class="flex items-center gap-3"
              >
                <PlayerAvatar player={row.player} class="h-8 w-8 rounded" />
                <span class="min-w-0">
                  <span class="flex items-center gap-1.5">
                    <PlayerFlairName
                      name={row.player.name}
                      flair={flair[row.player.id]}
                      class="font-semibold group-hover:text-acid"
                    />
                    <span class="me-badge shrink-0 items-center rounded border border-acid bg-acid/10 px-1 py-0.5 text-[9px] font-bold tracking-[0.15em] text-acid">
                      YOU
                    </span>
                  </span>
                  <span class="block text-[11px] text-ink-faint sm:hidden">
                    {row.wins} {row.wins === 1 ? "win" : "wins"} &middot;{" "}
                    {row.tasksCompleted} played
                  </span>
                </span>
              </a>
            </td>

            <td class="hidden px-3 py-3 text-center tabular-nums text-ink-dim sm:table-cell">
              {row.tasksCompleted}
            </td>

            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">
              {row.wins > 0 ? (
                <span class="font-bold text-acid">{row.wins}</span>
              ) : (
                <span class="text-ink-faint">0</span>
              )}
            </td>

            <td class="hidden px-3 py-3 text-center tabular-nums text-ink-dim lg:table-cell">
              {row.averagePosition > 0 ? row.averagePosition.toFixed(1) : "—"}
            </td>

            <td class="hidden px-3 py-3 lg:table-cell">
              {row.form.length > 0 ? (
                <span class="flex items-center gap-1">
                  {row.form.map((position) => (
                    <span
                      class:list={[
                        "flex h-5 w-5 items-center justify-center rounded border text-[11px] font-bold tabular-nums",
                        formClasses(position),
                      ]}
                      title={`Position ${position}`}
                    >
                      {position}
                    </span>
                  ))}
                </span>
              ) : (
                <span class="text-ink-faint">—</span>
              )}
            </td>

            <td class="px-3 py-3 text-right">
              <span class="text-base font-extrabold tabular-nums text-acid">
                {row.points}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  type Dir = "asc" | "desc";

  document
    .querySelectorAll<HTMLElement>("[data-sortable-standings]")
    .forEach((root) => {
      const tbody = root.querySelector("tbody");
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("button[data-sort-key]"),
      );
      if (!tbody || buttons.length === 0) return;

      const rows = Array.from(
        tbody.querySelectorAll<HTMLTableRowElement>("tr"),
      );
      const typeByKey = new Map(
        buttons.map((b) => [b.dataset.sortKey!, b.dataset.sortType ?? "num"]),
      );

      let activeKey = "rank";
      let activeDir: Dir = "asc";

      function rank(row: HTMLTableRowElement) {
        return Number(row.dataset.rank ?? 0);
      }

      function apply() {
        const factor = activeDir === "asc" ? 1 : -1;
        const isStr = typeByKey.get(activeKey) === "str";

        const sorted = rows.slice().sort((a, b) => {
          const av = a.dataset[activeKey] ?? "";
          const bv = b.dataset[activeKey] ?? "";
          let cmp: number;
          if (isStr) {
            cmp = av.localeCompare(bv);
          } else {
            cmp = Number(av) - Number(bv);
          }
          // Stable, meaningful tie-break: fall back to true competition rank.
          if (cmp === 0) return rank(a) - rank(b);
          return cmp * factor;
        });

        sorted.forEach((row) => tbody!.appendChild(row));

        buttons.forEach((btn) => {
          const th = btn.closest("th");
          const arrow = btn.querySelector<HTMLElement>("[data-arrow]");
          const isActive = btn.dataset.sortKey === activeKey;
          if (th) {
            th.setAttribute(
              "aria-sort",
              isActive
                ? activeDir === "asc"
                  ? "ascending"
                  : "descending"
                : "none",
            );
          }
          if (arrow) {
            arrow.textContent = isActive
              ? activeDir === "asc"
                ? "\u25B2"
                : "\u25BC"
              : "\u2195";
          }
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.dataset.sortKey!;
          if (key === activeKey) {
            activeDir = activeDir === "asc" ? "desc" : "asc";
          } else {
            activeKey = key;
            activeDir = (btn.dataset.defaultDir as Dir) ?? "asc";
          }
          apply();
        });
      });

      apply();
    });
</script>
