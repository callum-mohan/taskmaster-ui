---
import AdminField from "./AdminField.astro";
import Notice from "./Notice.astro";
import SlugFromName from "./SlugFromName.astro";
import { btnPrimary, btnGhost, labelClass } from "./styles";
import type { FieldErrors, FormValues } from "../../lib/admin-forms";
import { withBase } from "../../lib/url";

interface MemberOption {
  id: string;
  name: string;
  /** Name of the squad the player is in now, if it isn't this one. */
  otherTeam?: string;
}

interface Props {
  mode: "create" | "edit";
  values: FormValues;
  /** Every player, in roster order. */
  options: MemberOption[];
  errors?: FieldErrors;
  formError?: string;
}

const { mode, values, options, errors = {}, formError } = Astro.props;
const isCreate = mode === "create";
const selected = new Set((values.memberIds ?? "").split(",").filter(Boolean));
---

<form method="post" class="space-y-5" data-slug-form>
  <input type="hidden" name="intent" value="save" />
  {formError && <Notice tone="error">{formError}</Notice>}
  <div class="grid gap-5 sm:grid-cols-2">
    <AdminField
      label="name"
      name="name"
      value={values.name}
      error={errors.name}
      required
      attrs={{ "data-slug-source": "" }}
    />
    <AdminField
      label="id"
      name="id"
      value={values.id}
      error={errors.id}
      readonly={!isCreate}
      required
      hint={isCreate
        ? "Used in the team's URL (/teams/<id>). Can't be changed later."
        : "Used in URLs, so it can't be changed."}
      attrs={isCreate
        ? { "data-slug-target": "", "data-slug-prefix": "team " }
        : {}}
    />
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <AdminField
      label="tagline"
      name="tagline"
      value={values.tagline}
      error={errors.tagline}
      placeholder="e.g. sudo make me-a-sandwich"
      hint="Optional command-style tagline."
    />
    <AdminField
      label="team position"
      name="sortOrder"
      type="number"
      min={0}
      value={values.sortOrder}
      error={errors.sortOrder}
      hint={isCreate
        ? "Optional. Blank adds the team to the end."
        : "Display order; also breaks ties on equal points."}
    />
  </div>
  <fieldset aria-describedby="members-hint">
    <legend class={labelClass}>members</legend>
    <p id="members-hint" class="mt-1.5 text-xs text-ink-faint">
      A player can only be in one team; picking someone from another team moves
      them here.
    </p>
    {
      errors.memberIds && (
        <p class="mt-1.5 text-xs text-danger">{errors.memberIds}</p>
      )
    }
    <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        options.map((option) => (
          <label class="flex cursor-pointer items-center gap-3 rounded-md border border-grid px-3 py-2 text-sm transition-colors hover:border-ink-faint has-[:checked]:border-acid-dim has-[:checked]:bg-acid/5">
            <input
              type="checkbox"
              name="memberIds"
              value={option.id}
              checked={selected.has(option.id)}
              class="h-4 w-4 accent-[var(--color-acid)]"
            />
            <span class="text-ink">{option.name}</span>
            {option.otherTeam && (
              <span class="ml-auto truncate text-[11px] text-amber">
                in {option.otherTeam}
              </span>
            )}
          </label>
        ))
      }
    </div>
  </fieldset>
  <div class="flex flex-wrap gap-3 pt-2">
    <button type="submit" class={btnPrimary}>
      {isCreate ? "create team" : "save changes"}
    </button>
    <a href={withBase("/admin/teams")} class={btnGhost}>cancel</a>
  </div>
</form>
{isCreate && <SlugFromName />}
