---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import PollStatusBadge from "../../../components/PollStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  btnGhost,
  btnPrimary,
  tableCell,
  tableHead,
} from "../../../components/admin/styles";
import { listChangelog } from "../../../data/admin";
import { withBase } from "../../../lib/url";
import { ukDateFormat } from "../../../lib/time";
import {
  LIST_PAGE_SIZE,
  pageHref,
  paginate,
  parsePage,
} from "../../../lib/pagination";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

const [{ getPollSummaries, players }, changelog] = await Promise.all([
  Astro.locals.getQueries(),
  listChangelog(),
]);
const summaries = getPollSummaries();
const changelogPage = paginate(
  changelog,
  parsePage(Astro.url.searchParams.get("changelog")),
  LIST_PAGE_SIZE,
);
const changelogHref = (page: number) =>
  pageHref(Astro.url, "changelog", page, {
    hash: "changelog",
    drop: ["done", "name"],
  });
const categoryClass: Record<string, string> = {
  new: "text-acid",
  improved: "text-cyan",
  fixed: "text-amber",
};
const done = Astro.url.searchParams.get("done");
const subject = Astro.url.searchParams.get("name");

const stamp = ukDateFormat({
  day: "2-digit",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const fmt = (iso: string) => stamp.format(new Date(iso));
---

<AdminLayout title="Polls & changelog">
  <h1 class="text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> ls ~/site
  </h1>
  <p class="mt-1 max-w-prose text-sm text-ink-dim">
    The extras on the homepage: polls for players to vote on, and the "what's
    new" list.
  </p>

  {
    done && subject && (
      <Notice tone="success" class="mt-6">
        {done === "deleted" ? `Deleted "${subject}".` : `Saved "${subject}".`}
      </Notice>
    )
  }

  <section id="polls" aria-labelledby="polls-heading" class="mt-8 scroll-mt-24">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2
          id="polls-heading"
          class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          polls ({summaries.length})
        </h2>
        <p class="mt-1 text-xs text-ink-faint">
          Published polls appear on the homepage between their open and close
          times. Voters can earn bonus points in a week.
        </p>
      </div>
      <a href={withBase("/admin/polls/new")} class={btnPrimary}>+ new poll</a>
    </div>
    <TerminalWindow title="~/site/polls" bodyClass="p-0 sm:p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th scope="col" class={tableHead}>question</th>
              <th scope="col" class:list={[tableHead, "hidden md:table-cell"]}>
                opens → closes
              </th>
              <th scope="col" class={tableHead}>status</th>
              <th scope="col" class={tableHead}>voted</th>
              <th scope="col" class={tableHead}
                ><span class="sr-only">actions</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              summaries.map(({ poll, voterCount }) => (
                <tr class="transition-colors hover:bg-term-panel-2">
                  <td class={tableCell}>
                    <span class="text-ink">{poll.question}</span>
                    <span class="mt-0.5 block text-[11px] text-ink-faint">
                      {poll.kind === "single" ? "single" : "multiple"} choice ·{" "}
                      {poll.options.length} options ·{" "}
                      {poll.anonymous ? "anonymous" : "public"}
                    </span>
                  </td>
                  <td
                    class:list={[
                      tableCell,
                      "hidden whitespace-nowrap text-xs text-ink-faint md:table-cell",
                    ]}
                  >
                    {fmt(poll.opensAt)} → {fmt(poll.closesAt)}
                  </td>
                  <td class={tableCell}>
                    <PollStatusBadge
                      status={poll.status}
                      draft={!poll.published}
                    />
                  </td>
                  <td class:list={[tableCell, "tabular-nums text-ink-dim"]}>
                    {voterCount}/{players.length}
                  </td>
                  <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                    <a
                      href={withBase(`/admin/polls/new?from=${poll.id}`)}
                      class="mr-4 text-ink-dim hover:text-ink hover:underline"
                      aria-label={`Duplicate poll: ${poll.question}`}
                    >
                      duplicate
                    </a>
                    <a
                      href={withBase(`/admin/polls/${poll.id}`)}
                      class="text-cyan hover:underline"
                      aria-label={`Edit poll: ${poll.question}`}
                    >
                      edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {
          summaries.length === 0 && (
            <p class="p-6 text-sm text-ink-dim">
              No polls yet.{" "}
              <a
                href={withBase("/admin/polls/new")}
                class="text-cyan hover:underline"
              >
                Create one
              </a>
              .
            </p>
          )
        }
      </div>
    </TerminalWindow>
  </section>

  <section
    id="changelog"
    aria-labelledby="changelog-heading"
    class="mt-10 scroll-mt-24"
  >
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2
          id="changelog-heading"
          class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          changelog ({changelog.length})
        </h2>
        <p class="mt-1 text-xs text-ink-faint">
          The homepage "what's new" list, newest first. Visitors see a dot on
          the button until they've opened the newest entry.
        </p>
      </div>
      <a href={withBase("/admin/changelog/new")} class={btnGhost}>+ new entry</a
      >
    </div>
    <TerminalWindow title="~/site/changelog" bodyClass="p-0 sm:p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th scope="col" class={tableHead}>date</th>
              <th scope="col" class={tableHead}>type</th>
              <th scope="col" class={tableHead}>entry</th>
              <th scope="col" class={tableHead}
                ><span class="sr-only">actions</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              changelogPage.items.map((row) => (
                <tr class="transition-colors hover:bg-term-panel-2">
                  <td
                    class:list={[
                      tableCell,
                      "whitespace-nowrap tabular-nums text-ink-faint",
                    ]}
                  >
                    {row.date}
                  </td>
                  <td
                    class:list={[
                      tableCell,
                      "text-xs font-bold uppercase tracking-widest",
                      categoryClass[row.category],
                    ]}
                  >
                    {row.category}
                  </td>
                  <td class={tableCell}>
                    <span class="text-ink">{row.title}</span>
                    <span class="block max-w-prose text-xs text-ink-faint">
                      {row.description}
                    </span>
                  </td>
                  <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                    <a
                      href={withBase(`/admin/changelog/${row.id}`)}
                      class="text-cyan hover:underline"
                      aria-label={`Edit ${row.title}`}
                    >
                      edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {
          changelog.length === 0 && (
            <p class="p-6 text-sm text-ink-dim">No entries yet.</p>
          )
        }
      </div>
    </TerminalWindow>
    <Pagination
      info={changelogPage}
      href={changelogHref}
      label="Changelog pages"
      itemLabel="entries"
      class="mt-3"
    />
  </section>
</AdminLayout>
