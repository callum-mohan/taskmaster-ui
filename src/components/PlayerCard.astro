---
import type { LeaderboardRow, PlayerFlair } from "../types";
import { withBase } from "../lib/url";
import PlayerAvatar from "./PlayerAvatar.astro";
import PlayerFlairName from "./PlayerFlairName.astro";

interface Props {
  row: LeaderboardRow;
  /** The player's Clim Coin flair (name colour, pet, title). */
  flair?: PlayerFlair;
  class?: string;
}

const { row, flair, class: className = "" } = Astro.props;
const { player, rank } = row;

const medal = rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null;

// Emphasise the podium positions with a tinted frame.
const frame =
  rank === 1
    ? "border-amber/40 bg-amber/5 ring-1 ring-amber/20"
    : rank === 2
      ? "border-ink-dim/30 bg-ink/5"
      : rank === 3
        ? "border-acid-dim/40 bg-acid/5"
        : "border-grid bg-term-panel";
---

<a
  href={withBase(`/players/${player.id}`)}
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-xl border p-4 transition-colors hover:border-ink-faint sm:p-5",
    frame,
    className,
  ]}
>
  <!-- Faint rank watermark -->
  <span
    class="pointer-events-none absolute top-1 right-3 text-5xl font-extrabold tabular-nums text-ink-faint opacity-10 select-none"
    aria-hidden="true"
  >
    {String(rank).padStart(2, "0")}
  </span>

  <div class="flex items-center gap-3">
    <span
      class="flex w-7 shrink-0 justify-center text-lg font-extrabold tabular-nums"
    >
      {
        medal ? (
          <span aria-hidden="true">{medal}</span>
        ) : (
          <span class="text-ink-faint">{String(rank).padStart(2, "0")}</span>
        )
      }
      <span class="sr-only">Rank {rank}</span>
    </span>

    <PlayerAvatar player={player} class="h-11 w-11 rounded" />

    <span class="min-w-0 flex-1">
      <span class="flex items-center gap-1.5">
        <PlayerFlairName
          name={player.name}
          flair={flair}
          class="text-base font-extrabold group-hover:text-acid"
        />
      </span>
      {
        flair?.title && (
          <span class="block truncate text-[11px] italic text-magenta">
            “{flair.title}”
          </span>
        )
      }
      <span class="block text-[11px] text-ink-faint">
        {row.wins}{" "}
        {row.wins === 1 ? "win" : "wins"} &middot; {row.tasksCompleted} played
      </span>
    </span>
  </div>

  <div class="mt-4 flex items-end justify-between border-t border-grid pt-3">
    <span class="text-[10px] tracking-[0.2em] text-ink-faint uppercase">
      total score
    </span>
    <span>
      <span class="text-2xl font-extrabold tabular-nums text-acid">
        {row.points}
      </span>
      <span class="ml-1 text-[10px] tracking-widest text-ink-faint">PTS</span>
    </span>
  </div>
</a>
