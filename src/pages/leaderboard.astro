---
import Layout from "../layouts/Layout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import StandingsTable from "../components/StandingsTable.astro";
import StatCard from "../components/StatCard.astro";
import PlayerAvatar from "../components/PlayerAvatar.astro";
import { withBase } from "../lib/url";
import PointsChart from "../components/PointsChart.astro";

const {
  season,
  getLeaderboardWithMovement,
  getCompetitionStats,
  getPointsRaceChart,
  getPlayerFlairs,
} = await Astro.locals.getQueries();

const leaderboard = getLeaderboardWithMovement();
const stats = getCompetitionStats();
const raceChart = getPointsRaceChart(5);

// Visual podium order: runner-up on the left, champion raised in the middle,
// third on the right. Guard against a short roster just in case.
const [first, second, third] = leaderboard;
const podium = [second, first, third].filter(Boolean);

const podiumStyle: Record<
  number,
  { medal: string; label: string; ring: string; height: string }
> = {
  1: {
    medal: "🥇",
    label: "CHAMPION",
    ring: "border-amber/50 bg-amber/5 ring-1 ring-amber/20",
    height: "sm:pt-4",
  },
  2: {
    medal: "🥈",
    label: "RUNNER-UP",
    ring: "border-ink-dim/30 bg-ink/5",
    height: "sm:mt-8",
  },
  3: {
    medal: "🥉",
    label: "THIRD",
    ring: "border-acid-dim/50 bg-acid/5",
    height: "sm:mt-12",
  },
};

const leader = first;
---

<Layout
  title="Leaderboard"
  description="The full EAYL Taskmaster standings, podium and rank movement week by week."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- ============================ HEADER ============================ -->
    <header>
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        cat ~/leaderboard.md
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        THE <span class="text-acid text-glow">LEADERBOARD</span>
      </h1>
      <p
        class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim sm:text-base"
      >
        <span class="text-acid">//</span>{" "}
        {season.status === "closed" ? "Final" : "Live"}
        {" "}{season.name} standings across{" "}
        {stats.tasksCompleted} scored{" "}
        {stats.tasksCompleted === 1 ? "task" : "tasks"}. Ranked by points, then
        wins, then average finishing position.
      </p>
    </header>

    <!-- ============================ PODIUM ============================ -->
    {
      podium.length === 3 && (
        <section class="mt-10" aria-labelledby="podium-heading">
          <h2
            id="podium-heading"
            class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
          >
            leaderboard --podium
          </h2>

          <ol class="grid grid-cols-3 items-end gap-3 sm:gap-4">
            {podium.map((row) => {
              const style = podiumStyle[row.rank];
              return (
                <li class:list={["flex min-w-0", style.height]}>
                  <a
                    href={withBase(`/players/${row.player.id}`)}
                    class:list={[
                      "group flex w-full min-w-0 flex-col items-center gap-2 rounded-xl border px-2 py-4 text-center transition-colors hover:border-ink-faint sm:px-4",
                      style.ring,
                    ]}
                  >
                    <span class="text-2xl sm:text-3xl" aria-hidden="true">
                      {style.medal}
                    </span>
                    <PlayerAvatar
                      player={row.player}
                      class="h-11 w-11 rounded sm:h-14 sm:w-14"
                    />
                    <span class="w-full min-w-0">
                      <span class="line-clamp-2 text-sm font-extrabold wrap-break-word text-ink group-hover:text-acid sm:text-base">
                        {row.player.name}
                      </span>
                      <span class="block text-[10px] tracking-[0.2em] text-ink-faint">
                        {style.label}
                      </span>
                    </span>
                    <span class="mt-1">
                      <span class="text-xl font-extrabold tabular-nums text-acid sm:text-2xl">
                        {row.points}
                      </span>
                      <span class="ml-1 text-[10px] tracking-widest text-ink-faint">
                        PTS
                      </span>
                    </span>
                    <span class="text-[11px] text-ink-faint">
                      {row.wins} {row.wins === 1 ? "win" : "wins"}
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    <!-- ======================== POINTS RACE ======================== -->
    {
      raceChart && (
        <section class="mt-12" aria-labelledby="race-heading">
          <h2
            id="race-heading"
            class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
          >
            leaderboard --race
          </h2>
          <TerminalWindow title="~/points-over-time.chart" meta="top 5">
            <PointsChart
              data={raceChart}
              ariaLabel="Cumulative points over time for the top five players, week by week."
            />
          </TerminalWindow>
        </section>
      )
    }

    <!-- ======================= FULL STANDINGS ======================= -->
    <section class="mt-12">
      <div
        class="mb-4 flex flex-wrap items-end justify-between gap-x-4 gap-y-2"
      >
        <h2
          class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
        >
          leaderboard --all
        </h2>
        <span class="text-[11px] text-ink-faint">
          {leaderboard.length} players &middot; tap a column to sort
        </span>
      </div>

      <TerminalWindow
        title="~/leaderboard.tsv"
        meta="sort: rank ▲"
        bodyClass="p-0 sm:p-0"
      >
        <StandingsTable rows={leaderboard} flair={getPlayerFlairs()} />
      </TerminalWindow>

      <!-- Form guide legend -->
      <p
        class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-ink-faint"
      >
        <span class="tracking-widest uppercase">form guide:</span>
        <span class="flex items-center gap-1.5">
          <span
            class="flex h-4 w-4 items-center justify-center rounded border border-acid-dim bg-acid/10 text-[10px] font-bold text-acid"
            aria-hidden="true">1</span
          >
          win
        </span>
        <span class="flex items-center gap-1.5">
          <span
            class="flex h-4 w-4 items-center justify-center rounded border border-cyan/40 bg-cyan/5 text-[10px] font-bold text-cyan"
            aria-hidden="true">3</span
          >
          podium
        </span>
        <span class="flex items-center gap-1.5">
          <span
            class="flex h-4 w-4 items-center justify-center rounded border border-grid bg-term-bg text-[10px] font-bold text-ink-faint"
            aria-hidden="true">6</span
          >
          finishing position
        </span>
        <span>· most recent last</span>
      </p>

      <!-- Rank movement legend -->
      <p
        class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-ink-faint"
      >
        <span class="tracking-widest uppercase">movement:</span>
        <span class="flex items-center gap-1.5">
          <span class="font-bold text-acid" aria-hidden="true">▲</span> climbed
        </span>
        <span class="flex items-center gap-1.5">
          <span class="font-bold text-danger" aria-hidden="true">▼</span> dropped
        </span>
        <span class="flex items-center gap-1.5">
          <span class="font-bold text-ink-faint" aria-hidden="true">–</span> held
        </span>
        <span>· vs last task</span>
      </p>
    </section>

    <!-- ===================== STANDINGS SUMMARY ===================== -->
    <section class="mt-12">
      <h2
        class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        stats --standings
      </h2>

      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <StatCard
          value={leader ? leader.player.name : "—"}
          label="Current leader"
          command="head -1 leaderboard"
          accent="acid"
        />
        <StatCard
          value={leader ? leader.points : 0}
          label="Points to beat"
          command="max scores"
          accent="magenta"
        />
        <StatCard
          value={stats.tasksCompleted}
          label="Tasks scored"
          command="count tasks --done"
          accent="cyan"
        />
        <StatCard
          value={stats.differentWinners}
          label="Different winners"
          command="uniq winners"
          accent="amber"
        />
      </div>
    </section>
  </div>
</Layout>
