---
import { queriesForTask } from "../../../../lib/season-scope";
import { withSeason } from "../../../../lib/admin-season";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../../components/TerminalWindow.astro";
import TaskForm from "../../../../components/admin/TaskForm.astro";
import ConfirmDelete from "../../../../components/admin/ConfirmDelete.astro";
import RevealControls from "../../../../components/admin/RevealControls.astro";
import Notice from "../../../../components/admin/Notice.astro";
import WeekHeader from "../../../../components/admin/WeekHeader.astro";
import {
  deleteTask,
  describeWriteError,
  getTask,
  getTaskDeleteImpact,
  getWeekCounts,
  setTaskRevealed,
  updateTask,
} from "../../../../data/admin";
import { deriveTaskStatus } from "../../../../data/tasks";
import { getWeekProgress } from "../../../../data/week-progress";
import { ADMIN_WEEKS, weekHref } from "../../../../lib/admin-nav";
import {
  parseTaskForm,
  toDateTimeLocal,
  type FieldErrors,
  type FormValues,
} from "../../../../lib/admin-forms";
import { wallClockToIso, ukDateFormat } from "../../../../lib/time";
import { withBase } from "../../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

const id = Astro.params.id!;
const [task, { players, teams, getTaskById }] = await Promise.all([
  getTask(id),
  queriesForTask(Astro.locals, Astro.params.id),
]);
const view = getTaskById(id);
if (!task || !view) return Astro.rewrite("/404");
const selfUrl = withBase(weekHref(id));

const weekName = `week ${task.weekNumber}`;
let values: FormValues = {
  id: task.id,
  weekNumber: String(task.weekNumber),
  title: task.title,
  description: task.description,
  briefMode: Array.isArray(task.brief) ? "bullets" : "prose",
  brief: Array.isArray(task.brief) ? task.brief.join("\n") : (task.brief ?? ""),
  releaseDate: toDateTimeLocal(task.releaseDate),
  deadline: toDateTimeLocal(task.deadline),
  format: task.format,
  revealPassword: task.revealPassword ?? "",
  maxSubmissions: String(task.maxSubmissions),
  submissionKinds: task.submissionKinds.join(","),
};
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  if (intent === "delete") {
    await deleteTask(id);
    const query = new URLSearchParams({ done: "deleted", name: weekName });
    const season = (await Astro.locals.getSeasons()).getSeason(task.seasonId);
    return Astro.redirect(
      withBase(withSeason(`${ADMIN_WEEKS}?${query}`, season)),
    );
  }
  if (intent === "reveal" || intent === "relock") {
    await setTaskRevealed(id, intent === "reveal");
    const done = intent === "reveal" ? "revealed" : "relocked";
    return Astro.redirect(`${selfUrl}?done=${done}#reveal-heading`);
  }
  form.set("id", id);
  const parsed = parseTaskForm(form);
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    try {
      await updateTask(id, parsed.data);
      return Astro.redirect(`${selfUrl}?done=saved`);
    } catch (error) {
      formError = describeWriteError(error);
      if (!formError) throw error;
    }
  }
}

const [impact, counts] = await Promise.all([
  getTaskDeleteImpact(id),
  getWeekCounts(),
]);
const progress = getWeekProgress(view, counts.get(id), {
  players: players.length,
  teams: teams.length,
});

const status = deriveTaskStatus({
  releaseDate: wallClockToIso(task.releaseDate),
  deadline: wallClockToIso(task.deadline),
});
const revealedAt = task.revealedAt
  ? `at ${ukDateFormat({
      day: "2-digit",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).format(new Date(wallClockToIso(task.revealedAt)))}`
  : undefined;
const doneParam = Astro.url.searchParams.get("done");
const revealDone =
  doneParam === "revealed" || doneParam === "relocked" ? doneParam : undefined;
---

<AdminLayout title={`Brief · ${weekName}`}>
  <WeekHeader task={view} progress={progress} active="brief" />

  {
    doneParam === "saved" && (
      <Notice tone="success" class="mt-6">
        Brief saved. Changes are live on the site now.
      </Notice>
    )
  }
  {
    doneParam === "created" && (
      <Notice tone="success" class="mt-6">
        Week created. When its deadline passes, judge the entries in the{" "}
        <a href={withBase(weekHref(id, "judge"))} class="font-bold underline">
          judge
        </a>{" "}
        tab.
      </Notice>
    )
  }

  <p class="mt-6 max-w-prose text-sm text-ink-dim">
    The task as players see it. Status follows the release and deadline dates.
    Set how many entries players can send in under{" "}
    <span class="text-ink">entries allowed</span>; 0 means none on the site.
  </p>
  <TerminalWindow title={`~/weeks/${task.id}/brief.md`} class="mt-4">
    <TaskForm
      mode="edit"
      values={values}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
  <section aria-labelledby="reveal-heading" class="mt-8">
    <h2
      id="reveal-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      reveal password
    </h2>
    <TerminalWindow title={`~/weeks/${task.id}/brief.lock`}>
      <RevealControls
        password={task.revealPassword}
        status={status}
        revealedAt={revealedAt}
        done={revealDone}
      />
    </TerminalWindow>
  </section>
  <section aria-labelledby="danger-heading" class="mt-8">
    <h2
      id="danger-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      danger zone
    </h2>
    <ConfirmDelete
      subject={`task "${weekName}: ${task.title}"`}
      impact={impact}
      label="delete task"
    />
  </section>
</AdminLayout>
