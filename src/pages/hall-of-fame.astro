---
import Layout from "../layouts/Layout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import ChampionCard from "../components/ChampionCard.astro";
import AwardCard from "../components/AwardCard.astro";
import { withBase } from "../lib/url";
import type { Award } from "../types";

const [{ seasons, records }, { current }] = await Promise.all([
  Astro.locals.getHallOfFame(),
  Astro.locals.getSeasons(),
]);

// Records render as award cards, naming the season they were set in.
const recordCards: Award[] = records.map((record) => ({
  id: record.id,
  title: record.title,
  command: record.command,
  player: record.player,
  value: record.value,
  detail: [record.detail, record.season.name].filter(Boolean).join(" · "),
  accent: record.accent,
}));
const sectionHeading =
  "prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase";
---

<Layout
  title="Hall of Fame"
  description="Every EAYL Taskmaster champion, podium and winning squad, season by season, plus the all-time records."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <header>
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        cat ~/hall-of-fame.md
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        HALL OF <span class="text-glow-magenta text-magenta">FAME</span>
      </h1>
      <p
        class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim sm:text-base"
      >
        <span class="text-acid">//</span> Every season's champion, podium and winning
        squad, and the records nobody has beaten yet.
      </p>
    </header>

    {
      seasons.length === 0 ? (
        <TerminalWindow title="~/hall-of-fame" class="mt-10">
          <p class="text-sm text-ink-dim">
            <span class="text-amber">●</span> No season has finished yet. When{" "}
            {current ? current.name : "the first season"} ends, its champion
            takes the first spot here.{" "}
            <a
              href={withBase("/leaderboard")}
              class="text-cyan hover:underline"
            >
              See who's leading now &rarr;
            </a>
          </p>
        </TerminalWindow>
      ) : (
        <>
          {recordCards.length > 0 && (
            <section class="mt-10" aria-labelledby="records-heading">
              <h2 id="records-heading" class={sectionHeading}>
                records --all-time
              </h2>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {recordCards.map((award) => (
                  <AwardCard award={award} />
                ))}
              </div>
            </section>
          )}

          <section class="mt-12" aria-labelledby="seasons-heading">
            <h2 id="seasons-heading" class={sectionHeading}>
              champions --by-season
            </h2>
            <div class="space-y-10">
              {seasons.map((honours) => (
                <div>
                  <ChampionCard
                    honours={honours}
                    wrappedHref={withBase(
                      `/seasons/${honours.season.id}/wrapped`,
                    )}
                  />
                  {honours.awards.length > 0 && (
                    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                      {honours.awards.map((award) => (
                        <AwardCard award={award} />
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        </>
      )
    }
  </div>
</Layout>
