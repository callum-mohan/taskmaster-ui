---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import TaskStatusBadge from "../../../components/TaskStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import {
  btnPrimary,
  tableCell,
  tableHead,
} from "../../../components/admin/styles";
import { withBase } from "../../../lib/url";
import { ukDateFormat } from "../../../lib/time";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/admin/login"));

const { tasks } = await Astro.locals.getQueries();
const done = Astro.url.searchParams.get("done");
const subject = Astro.url.searchParams.get("name");

const stamp = ukDateFormat({
  day: "2-digit",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
---

<AdminLayout title="Tasks">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight text-ink">
        <span class="text-acid">$</span> ls ~/tasks
      </h1>
      <p class="mt-1 text-sm text-ink-dim">
        {tasks.length} tasks. Status follows the release and deadline dates.
      </p>
    </div>
    <a href={withBase("/admin/tasks/new")} class={btnPrimary}>+ new task</a>
  </div>

  {
    done && subject && (
      <Notice tone="success" class="mt-6">
        {done === "deleted" ? `Deleted ${subject}.` : `Saved ${subject}.`}
      </Notice>
    )
  }

  <TerminalWindow title="~/tasks" class="mt-6" bodyClass="p-0 sm:p-0">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th scope="col" class={tableHead}>week</th>
            <th scope="col" class={tableHead}>title</th>
            <th scope="col" class:list={[tableHead, "hidden md:table-cell"]}>
              release → deadline
            </th>
            <th scope="col" class={tableHead}>status</th>
            <th scope="col" class={tableHead}
              ><span class="sr-only">actions</span></th
            >
          </tr>
        </thead>
        <tbody>
          {
            tasks.map((task) => (
              <tr class="transition-colors hover:bg-term-panel-2">
                <td class:list={[tableCell, "tabular-nums text-magenta"]}>
                  {String(task.weekNumber).padStart(2, "0")}
                </td>
                <td class={tableCell}>
                  <span class="text-ink">{task.title}</span>
                  {task.format === "team" && (
                    <span class="ml-2 text-[10px] font-bold tracking-widest text-cyan">
                      TEAM
                    </span>
                  )}
                  {task.passwordProtected && task.status !== "completed" && (
                    <span
                      class:list={[
                        "ml-2 text-[10px] font-bold tracking-widest",
                        task.revealedToAll ? "text-acid" : "text-amber",
                      ]}
                    >
                      {task.revealedToAll ? "REVEALED" : "🔒 PASSWORD"}
                    </span>
                  )}
                </td>
                <td
                  class:list={[
                    tableCell,
                    "hidden whitespace-nowrap text-xs text-ink-faint md:table-cell",
                  ]}
                >
                  {stamp.format(new Date(task.releaseDate))} →{" "}
                  {stamp.format(new Date(task.deadline))}
                </td>
                <td class={tableCell}>
                  <TaskStatusBadge status={task.status} />
                </td>
                <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                  <a
                    href={withBase(`/admin/scores/${task.id}`)}
                    class="mr-4 text-acid hover:underline"
                    aria-label={`Scores for week ${task.weekNumber}`}
                  >
                    scores
                  </a>
                  <a
                    href={withBase(`/admin/tasks/${task.id}`)}
                    class="text-cyan hover:underline"
                    aria-label={`Edit week ${task.weekNumber}`}
                  >
                    edit
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        tasks.length === 0 && (
          <p class="p-6 text-sm text-ink-dim">No tasks yet.</p>
        )
      }
    </div>
  </TerminalWindow>
</AdminLayout>
