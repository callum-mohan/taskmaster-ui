---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import EasterEggs from "../components/EasterEggs.astro";
import WhatsNewBanner from "../components/WhatsNewBanner.astro";
import WanderingPet from "../components/WanderingPet.astro";
import StormMode from "../components/StormMode.astro";
import { withBase } from "../lib/url";
import { isSeasonPublic } from "../data/seasons";

const [
  { getCommandPaletteItems, getWhatsNew, getNotifications, features },
  viewer,
  { seasons, seasonOfPlayer },
] = await Promise.all([
  Astro.locals.getQueries(),
  Astro.locals.getViewer(),
  Astro.locals.getSeasons(),
]);

interface Props {
  /** Page-specific title segment; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Social share image, relative to the site root. */
  image?: string;
  /** Keep the page out of search engines (e.g. the admin panel). */
  noindex?: boolean;
  /** Keep storm mode off this page (the admin area stays workable). */
  calm?: boolean;
}

const SITE_NAME = "EAYL Taskmaster";

const {
  title,
  description = "16 weeks. 25 players. One winner. The EAYL Academy Taskmaster challenge.",
  image = "/og.png",
  noindex = false,
  calm = false,
} = Astro.props;

const storm = features.storm_mode && !calm;

// Page-specific titles read "<page> · EAYL Taskmaster"; the home page (no
// title prop) just uses the site name on its own.
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;

// Absolute URLs for canonical + social tags (Astro.site is set in the config).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);

const paletteItems = getCommandPaletteItems({
  admin: viewer?.isAdmin,
  seasons: viewer?.isAdmin ? seasons : seasons.filter(isSeasonPublic),
});
const whatsNew = getWhatsNew();
// A signed-in player's Clim Coin balance and equipped pet, from their own
// season (their wallet is per season).
const playerId = viewer?.playerId;
const playerSeason = playerId ? seasonOfPlayer(playerId) : undefined;
const playerCoins =
  playerId && playerSeason
    ? await Astro.locals.getQueries(playerSeason.id).then((q) => ({
        balance: q.getWallet(playerId).balance,
        pet: q.getLoadout(playerId).pet,
      }))
    : undefined;
// Only players get notifications: their read marker lives on the account.
const notifications = viewer?.playerId
  ? getNotifications({
      playerId: viewer.playerId,
      readAt: viewer.notificationsReadAt,
    })
  : undefined;
---

<!doctype html>
<html lang="en" data-storm={storm ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      // Dark is the default when nothing valid is stored. The exotic CRT
      // phosphor themes (amber/cyan/magenta) are summoned from the command
      // palette but persist here like any other.
      (function () {
        const valid = ["dark", "light", "amber", "cyan", "magenta"];
        try {
          const saved = localStorage.getItem("eayl-theme");
          const theme = valid.indexOf(saved) >= 0 ? saved : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#080b10" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / Slack / Teams -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[70] focus:bg-acid focus:text-term-bg focus:px-3 focus:py-1 focus:font-bold"
      >Skip to content</a
    >
    <Navbar
      viewer={viewer}
      notifications={notifications}
      coinBalance={playerCoins?.balance}
      skillTrees={features.skill_trees}
    />
    <WhatsNewBanner info={whatsNew} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette items={paletteItems} />
    <EasterEggs />
    {storm && <StormMode />}
    {
      playerCoins?.pet?.imageUrl && (
        <WanderingPet
          name={playerCoins.pet.name}
          imageUrl={playerCoins.pet.imageUrl}
        />
      )
    }
  </body>
</html>
