---
import type { TaskStatus, WhatsNewInfo } from "../types";

interface Props {
  /** Current task signal, or undefined when there is no active task. */
  info?: WhatsNewInfo;
  class?: string;
}

const { info, class: className = "" } = Astro.props;

const weekLabel = info
  ? `WEEK ${String(info.weekNumber).padStart(2, "0")}`
  : "";

// Presentational treatment per task status. The banner only ever renders for
// a live or upcoming task (getCurrentTask never returns a completed one), but
// the map is exhaustive so the union stays type-safe.
const config: Record<
  TaskStatus,
  { tag: string; frame: string; accent: string; cta: string; live?: boolean }
> = {
  live: {
    tag: "NEW TASK LIVE",
    frame: "border-amber/40 bg-amber/10",
    accent: "text-amber",
    cta: "border-amber text-amber hover:bg-amber hover:text-term-bg",
    live: true,
  },
  upcoming: {
    tag: "NEXT TASK",
    frame: "border-grid bg-term-panel",
    accent: "text-ink-dim",
    cta: "border-grid text-ink-dim hover:border-ink-faint hover:text-ink",
  },
  completed: {
    tag: "LATEST TASK",
    frame: "border-acid-dim bg-acid/10",
    accent: "text-acid",
    cta: "border-acid text-acid hover:bg-acid hover:text-term-bg",
  },
};

const style = info ? config[info.status] : null;
---

{
  info && style && (
    <div class:list={["mx-auto w-full max-w-6xl px-4 pt-4 sm:px-6", className]}>
      <div
        id="whats-new"
        data-task-id={info.taskId}
        role="status"
        aria-live="polite"
        class:list={[
          "hidden items-center gap-3 rounded-lg border px-4 py-3 text-sm",
          style.frame,
        ]}
      >
        <span
          class:list={[
            "flex shrink-0 items-center gap-1.5 text-[10px] font-bold tracking-[0.2em]",
            style.accent,
          ]}
        >
          {style.live ? (
            <span
              class="live-dot h-1.5 w-1.5 rounded-full bg-amber"
              aria-hidden="true"
            />
          ) : (
            <span aria-hidden="true">●</span>
          )}
          {style.tag}
        </span>

        <p class="min-w-0 flex-1 truncate text-ink-dim">
          <span class={`font-bold ${style.accent}`}>{weekLabel}</span>
          <span class="mx-1.5 text-ink-faint" aria-hidden="true">
            ·
          </span>
          <span class="font-semibold text-ink">{info.title}</span>
          <span class="ml-2 hidden text-ink-faint sm:inline">
            has landed since your last visit
          </span>
        </p>

        <a
          href={info.href}
          data-whats-new-view
          class:list={[
            "inline-flex shrink-0 items-center rounded-md border px-3 py-1.5 text-xs font-bold tracking-widest transition-colors",
            style.cta,
          ]}
        >
          [ VIEW ]
        </a>

        <button
          type="button"
          data-whats-new-dismiss
          aria-label="Dismiss new task notice"
          class="shrink-0 rounded px-1.5 py-1 text-ink-faint transition-colors hover:text-ink"
        >
          <span aria-hidden="true">✕</span>
        </button>
      </div>
    </div>
  )
}

<script>
  const STORAGE_KEY = "tm:last-seen-task";
  const banner = document.getElementById("whats-new");

  if (banner) {
    const taskId = banner.dataset.taskId ?? "";

    const markSeen = () => {
      try {
        localStorage.setItem(STORAGE_KEY, taskId);
      } catch {
        // Ignore storage being unavailable (private mode, blocked, etc).
      }
    };

    let lastSeen: string | null = null;
    try {
      lastSeen = localStorage.getItem(STORAGE_KEY);
    } catch {
      lastSeen = null;
    }

    // Only surface the banner when the current task differs from the one the
    // visitor last acknowledged — i.e. a new week has gone live since.
    if (taskId && lastSeen !== taskId) {
      banner.classList.remove("hidden");
      banner.classList.add("flex");
    }

    banner
      .querySelector<HTMLButtonElement>("[data-whats-new-dismiss]")
      ?.addEventListener("click", () => {
        markSeen();
        banner.classList.add("hidden");
        banner.classList.remove("flex");
      });

    // Viewing the task also counts as acknowledging it.
    banner
      .querySelector<HTMLAnchorElement>("[data-whats-new-view]")
      ?.addEventListener("click", markSeen);
  }
</script>
