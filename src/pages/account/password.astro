---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import AdminField from "../../components/admin/AdminField.astro";
import Notice from "../../components/admin/Notice.astro";
import { btnPrimary, btnGhost } from "../../components/admin/styles";
import { clearMustChangePassword } from "../../data/accounts";
import {
  MIN_PASSWORD_LENGTH,
  parsePasswordForm,
} from "../../lib/account-forms";
import type { FieldErrors } from "../../lib/admin-forms";
import { changePassword } from "../../lib/auth";
import { withBase } from "../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
const player = Astro.locals.player;
if (!player) return Astro.redirect(withBase("/login"));

const forced = player.mustChangePassword;
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const parsed = parsePasswordForm(await Astro.request.formData());
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    const failure = await changePassword(
      Astro,
      parsed.data.currentPassword,
      parsed.data.newPassword,
    );
    if (failure?.field) {
      errors = { [failure.field]: failure.message };
    } else if (failure) {
      formError = failure.message;
    } else {
      if (forced) await clearMustChangePassword(player.userId);
      return Astro.redirect(withBase("/account?done=password"));
    }
  }
}
---

<Layout title="Change password">
  <div class="mx-auto max-w-md px-4 py-12 sm:px-6 sm:py-16">
    <p class="prompt text-xs font-bold uppercase tracking-[0.3em] text-ink-dim">
      passwd {player.playerId}
    </p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink">
      CHANGE <span class="text-acid text-glow">PASSWORD</span>
    </h1>
    <p class="mt-2 text-sm text-ink-dim">
      <span class="text-acid">// </span>
      {
        forced
          ? "You're signed in with a temporary password. Choose your own to continue."
          : "Your other devices will be signed out."
      }
    </p>

    <TerminalWindow
      title="~/account/passwd"
      meta={forced ? "required" : undefined}
      class="mt-6"
    >
      {
        formError && (
          <Notice tone="error" class="mb-5">
            {formError}
          </Notice>
        )
      }
      <form method="post" class="space-y-5" novalidate>
        <!-- Lets password managers pair the new password with the account. -->
        <input
          type="email"
          name="username"
          value={player.email}
          autocomplete="username"
          class="sr-only"
          tabindex="-1"
          aria-hidden="true"
          readonly
        />
        <AdminField
          label={forced ? "temporary password" : "current password"}
          name="currentPassword"
          type="password"
          error={errors.currentPassword}
          autocomplete="current-password"
          required
        />
        <AdminField
          label="new password"
          name="newPassword"
          type="password"
          error={errors.newPassword}
          hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
          autocomplete="new-password"
          required
        />
        <AdminField
          label="confirm new password"
          name="confirmPassword"
          type="password"
          error={errors.confirmPassword}
          autocomplete="new-password"
          required
        />
        <div class="flex flex-wrap gap-3">
          <button type="submit" class={btnPrimary}>change password</button>
          {
            !forced && (
              <a href={withBase("/account")} class={btnGhost}>
                cancel
              </a>
            )
          }
        </div>
      </form>
      {
        forced && (
          <form
            method="post"
            action={withBase("/logout")}
            class="mt-5 border-t border-grid pt-4"
          >
            <button
              type="submit"
              class="text-xs text-ink-faint hover:text-ink hover:underline"
            >
              sign out instead
            </button>
          </form>
        )
      }
    </TerminalWindow>
  </div>
</Layout>
