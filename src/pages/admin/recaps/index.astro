---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import TaskStatusBadge from "../../../components/TaskStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import { listRecaps } from "../../../data/admin";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

const [{ tasks, getRecapTaskIds }, recapRows] = await Promise.all([
  Astro.locals.getQueries(),
  listRecaps(),
]);
const written = new Set(recapRows.map((r) => r.taskId));
const live = new Set(getRecapTaskIds());
// Newest week first: that's the one usually being written up.
const weeks = tasks
  .filter((t) => t.status !== "upcoming")
  .sort((a, b) => b.weekNumber - a.weekNumber);
const done = Astro.url.searchParams.get("done");
const subject = Astro.url.searchParams.get("name");
---

<AdminLayout title="Recaps">
  <h1 class="text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> ls ~/recaps
  </h1>
  <p class="mt-1 max-w-prose text-sm text-ink-dim">
    The editorial colour on each week's episode recap: headline, summary,
    funniest moment and quote. A recap page goes up once a week is scored;
    anything you leave blank is written from the results.
  </p>

  {
    done && subject && (
      <Notice tone="success" class="mt-6">
        {done === "cleared"
          ? `Cleared the ${subject} write-up.`
          : `Saved the ${subject} recap.`}
      </Notice>
    )
  }

  <TerminalWindow
    title="~/recaps"
    meta={`${written.size} written`}
    class="mt-6"
  >
    <ul class="grid gap-2 sm:grid-cols-2">
      {
        weeks.map((task) => (
          <li>
            <a
              href={withBase(`/admin/recaps/${task.id}`)}
              class="group flex h-full flex-col gap-2 rounded-md border border-grid px-4 py-3 transition-colors hover:border-acid-dim"
            >
              <span class="flex items-center justify-between gap-3">
                <span class="text-xs font-bold tracking-widest text-magenta">
                  WEEK {String(task.weekNumber).padStart(2, "0")}
                </span>
                <TaskStatusBadge status={task.status} />
              </span>
              <span class="text-sm text-ink group-hover:text-acid">
                {task.title}
              </span>
              <span class="text-xs text-ink-faint">
                {written.has(task.id) ? (
                  <span class="text-acid">written</span>
                ) : (
                  "auto copy"
                )}
                {" · "}
                {live.has(task.id) ? "recap page live" : "not scored yet"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      weeks.length === 0 && (
        <p class="text-sm text-ink-dim">No weeks have been released yet.</p>
      )
    }
  </TerminalWindow>
</AdminLayout>
