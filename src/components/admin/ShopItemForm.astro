---
// Create / edit a Clim Coin shop item. The category, cosmetic kind and
// power-up are fixed once created (owned items keep their slot and effect),
// so on edit they're shown read-only and posted back as hidden fields.
import AdminField from "./AdminField.astro";
import Notice from "./Notice.astro";
import SlugFromName from "./SlugFromName.astro";
import { btnGhost, btnPrimary, inputClass, labelClass } from "./styles";
import {
  CATEGORY_INFO,
  COSMETIC_KIND_LABELS,
  COSMETIC_KINDS,
  NAME_COLOURS,
  POWER_UP_INFO,
  POWER_UP_KINDS,
  PROFILE_THEMES,
  SHOP_CATEGORIES,
} from "../../data/coins";
import type { FieldErrors, FormValues } from "../../lib/admin-forms";
import { withBase } from "../../lib/url";

interface Props {
  mode: "create" | "edit";
  values: FormValues;
  errors?: FieldErrors;
  formError?: string;
}

const { mode, values, errors = {}, formError } = Astro.props;
const isCreate = mode === "create";

const select = (name: string) => ({
  id: `field-${name}`,
  name,
  "aria-invalid": errors[name] ? ("true" as const) : undefined,
  "aria-describedby": errors[name] ? `field-${name}-error` : undefined,
  class: inputClass(Boolean(errors[name])),
});
---

<form method="post" class="space-y-5" data-slug-form>
  <input type="hidden" name="intent" value="save" />
  {formError && <Notice tone="error">{formError}</Notice>}
  <div class="grid gap-5 sm:grid-cols-2">
    <AdminField
      label="name"
      name="name"
      value={values.name}
      error={errors.name}
      required
      attrs={{ "data-slug-source": "" }}
    />
    <AdminField
      label="id"
      name="id"
      value={values.id}
      error={errors.id}
      readonly={!isCreate}
      required
      hint={isCreate
        ? "Used in links and players' wallets. Can't be changed later."
        : "Can't be changed: players' wallets refer to it."}
      attrs={isCreate ? { "data-slug-target": "" } : {}}
    />
  </div>
  <AdminField
    label="description"
    name="description"
    rows={2}
    value={values.description}
    error={errors.description}
    hint="One line for the shop card. Up to 300 characters."
  />

  <div class="grid gap-5 sm:grid-cols-3">
    <div class="space-y-1.5">
      <label for="field-category" class={labelClass}>
        category <span class="text-acid" aria-hidden="true">*</span>
      </label>
      {
        isCreate ? (
          <select {...select("category")} required>
            <option value="">pick one…</option>
            {SHOP_CATEGORIES.map((category) => (
              <option value={category} selected={values.category === category}>
                {CATEGORY_INFO[category].label}
              </option>
            ))}
          </select>
        ) : (
          <>
            <input type="hidden" name="category" value={values.category} />
            <input
              id="field-category"
              type="text"
              readonly
              value={
                CATEGORY_INFO[values.category as keyof typeof CATEGORY_INFO]
                  ?.label ?? values.category
              }
              class={inputClass(false)}
            />
          </>
        )
      }
      {
        errors.category && (
          <p id="field-category-error" class="text-xs text-danger">
            <span aria-hidden="true">✗ </span>
            {errors.category}
          </p>
        )
      }
    </div>
    <AdminField
      label="price"
      name="price"
      type="number"
      min={0}
      max={10000}
      value={values.price}
      error={errors.price}
      required
      hint="In Clim Coin. Also sets the rarity: ≤15 common, 16–29 rare, 30–39 epic, 40+ legendary."
    />
    <AdminField
      label="sort order"
      name="sortOrder"
      type="number"
      min={0}
      value={values.sortOrder}
      error={errors.sortOrder}
      hint="Lower shows first."
    />
  </div>

  <AdminField
    label="image"
    name="imageUrl"
    value={values.imageUrl}
    error={errors.imageUrl}
    placeholder="/shop/pets/rubber-duck.svg"
    hint="Pets and avatars: a square pixel image committed under /public/shop (e.g. /shop/pets/duck.svg) or an https:// URL."
  />

  <fieldset class="rounded-md border border-grid p-4">
    <legend class:list={[labelClass, "px-1"]}>power-ups only</legend>
    <div class="space-y-1.5">
      <label for="field-powerUp" class={labelClass}>effect</label>
      {
        isCreate ? (
          <select {...select("powerUp")}>
            <option value="">—</option>
            {POWER_UP_KINDS.map((kind) => (
              <option value={kind} selected={values.powerUp === kind}>
                {POWER_UP_INFO[kind].label}
              </option>
            ))}
          </select>
        ) : (
          <>
            <input type="hidden" name="powerUp" value={values.powerUp} />
            <input
              id="field-powerUp"
              type="text"
              readonly
              value={
                POWER_UP_INFO[values.powerUp as keyof typeof POWER_UP_INFO]
                  ?.label ?? "—"
              }
              class={inputClass(false)}
            />
          </>
        )
      }
      {
        errors.powerUp && (
          <p id="field-powerUp-error" class="text-xs text-danger">
            <span aria-hidden="true">✗ </span>
            {errors.powerUp}
          </p>
        )
      }
    </div>
  </fieldset>

  <fieldset class="rounded-md border border-grid p-4">
    <legend class:list={[labelClass, "px-1"]}>cosmetics only</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="space-y-1.5">
        <label for="field-cosmeticKind" class={labelClass}>kind</label>
        {
          isCreate ? (
            <select {...select("cosmeticKind")}>
              <option value="">—</option>
              {COSMETIC_KINDS.map((kind) => (
                <option value={kind} selected={values.cosmeticKind === kind}>
                  {COSMETIC_KIND_LABELS[kind]}
                </option>
              ))}
            </select>
          ) : (
            <>
              <input
                type="hidden"
                name="cosmeticKind"
                value={values.cosmeticKind}
              />
              <input
                id="field-cosmeticKind"
                type="text"
                readonly
                value={
                  COSMETIC_KIND_LABELS[
                    values.cosmeticKind as keyof typeof COSMETIC_KIND_LABELS
                  ] ?? "—"
                }
                class={inputClass(false)}
              />
            </>
          )
        }
        {
          errors.cosmeticKind && (
            <p id="field-cosmeticKind-error" class="text-xs text-danger">
              <span aria-hidden="true">✗ </span>
              {errors.cosmeticKind}
            </p>
          )
        }
      </div>
      <AdminField
        label="value"
        name="cosmeticValue"
        value={values.cosmeticValue}
        error={errors.cosmeticValue}
        hint={`Title: the text shown under the name. Name colour: ${NAME_COLOURS.join(" / ")}. Profile theme: ${PROFILE_THEMES.join(" / ")}.`}
      />
    </div>
  </fieldset>

  <label class="flex items-center gap-3 text-sm text-ink">
    <input
      type="checkbox"
      name="available"
      checked={values.available === "on"}
      class="h-4 w-4 accent-[var(--color-acid)]"
    />
    For sale
    <span class="text-xs text-ink-faint">
      (untick to retire: owners keep it, nobody new can buy it)
    </span>
  </label>

  <div class="space-y-1">
    <label class="flex items-center gap-3 text-sm text-ink">
      <input
        type="checkbox"
        name="crateOnly"
        checked={values.crateOnly === "on"}
        aria-describedby={errors.crateOnly
          ? "field-crateOnly-error"
          : undefined}
        class="h-4 w-4 accent-[var(--color-acid)]"
      />
      Egg exclusive
      <span class="text-xs text-ink-faint">
        (pets, avatars and cosmetics only: hatches from mystery eggs, never sold
        directly; its price still sets its rarity)
      </span>
    </label>
    {
      errors.crateOnly && (
        <p id="field-crateOnly-error" class="text-xs text-danger">
          <span aria-hidden="true">✗ </span>
          {errors.crateOnly}
        </p>
      )
    }
  </div>

  <div class="flex flex-wrap gap-3 pt-2">
    <button type="submit" class={btnPrimary}>
      {isCreate ? "add item" : "save changes"}
    </button>
    <a href={withBase("/admin/site#shop")} class={btnGhost}>cancel</a>
  </div>
</form>
{isCreate && <SlugFromName />}
