---
import type { GalleryEntrySocial } from "../types";
import { withBase } from "../lib/url";

interface Props {
  taskId: string;
  entryId: number;
  social: GalleryEntrySocial;
  /** Gallery page the entry is on, so a no-JS post comes back to it. */
  page?: number;
  class?: string;
}

const { taskId, entryId, social, page = 1, class: className } = Astro.props;
const { reactions, canReact } = social;
const action = withBase(`/account/gallery/${taskId}`);
const shown = canReact ? reactions : reactions.filter((r) => r.count > 0);
const describe = (label: string, count: number, mine: boolean) =>
  `${label}: ${count} ${count === 1 ? "reaction" : "reactions"}${mine ? ", including yours" : ""}`;
const tooltip = (names: string[]) =>
  names.length > 0 ? names.join(", ") : undefined;
---

{
  shown.length > 0 &&
    (canReact ? (
      <form
        method="post"
        action={action}
        class:list={["flex flex-wrap gap-1.5", className]}
        data-reaction-form
      >
        <input type="hidden" name="intent" value="react" />
        <input type="hidden" name="submissionId" value={entryId} />
        {page > 1 && <input type="hidden" name="entries" value={page} />}
        {shown.map((r) => (
          <button
            type="submit"
            name="kind"
            value={r.kind}
            aria-pressed={r.mine ? "true" : "false"}
            aria-label={describe(r.label, r.count, r.mine)}
            title={tooltip(r.names)}
            data-reaction={r.kind}
            data-label={r.label}
            class="inline-flex items-center gap-1 rounded-full border border-grid bg-term-bg/60 px-2 py-0.5 text-xs text-ink-dim transition-colors hover:border-ink-faint hover:text-ink aria-pressed:border-acid-dim aria-pressed:bg-acid/10 aria-pressed:text-acid"
          >
            <span aria-hidden="true">{r.emoji}</span>
            <span class="tabular-nums" data-count>
              {r.count > 0 ? r.count : ""}
            </span>
          </button>
        ))}
      </form>
    ) : (
      <ul
        class:list={["flex flex-wrap gap-1.5", className]}
        aria-label="Reactions"
      >
        {shown.map((r) => (
          <li
            class="inline-flex items-center gap-1 rounded-full border border-grid-soft px-2 py-0.5 text-xs text-ink-dim"
            title={tooltip(r.names)}
          >
            <span aria-hidden="true">{r.emoji}</span>
            <span class="sr-only">{describe(r.label, r.count, false)}</span>
            <span class="tabular-nums" aria-hidden="true">
              {r.count}
            </span>
          </li>
        ))}
      </ul>
    ))
}

<script>
  // Toggle reactions in place: post for JSON and redraw this entry's
  // buttons. Without JS (or if the request fails) the form posts normally
  // and the page comes back to the entry.
  interface Tally {
    kind: string;
    label: string;
    count: number;
    mine: boolean;
    names: string[];
  }

  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.matches("[data-reaction-form]")) return;
    const submitter = (event as SubmitEvent).submitter;
    if (!(submitter instanceof HTMLButtonElement)) return;
    event.preventDefault();
    if (form.dataset.busy) return;
    form.dataset.busy = "1";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form, submitter),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error(String(response.status));
      const { reactions } = (await response.json()) as {
        reactions?: Tally[];
      };
      for (const tally of reactions ?? []) {
        const button = form.querySelector<HTMLButtonElement>(
          `[data-reaction="${tally.kind}"]`,
        );
        if (!button) continue;
        const count = button.querySelector<HTMLElement>("[data-count]");
        if (count)
          count.textContent = tally.count > 0 ? String(tally.count) : "";
        button.setAttribute("aria-pressed", tally.mine ? "true" : "false");
        button.setAttribute(
          "aria-label",
          `${tally.label}: ${tally.count} ${tally.count === 1 ? "reaction" : "reactions"}${tally.mine ? ", including yours" : ""}`,
        );
        if (tally.names.length > 0) button.title = tally.names.join(", ");
        else button.removeAttribute("title");
      }
    } catch {
      delete form.dataset.busy;
      // A programmatic submit leaves out the clicked button's value.
      const kind = document.createElement("input");
      kind.type = "hidden";
      kind.name = submitter.name;
      kind.value = submitter.value;
      form.append(kind);
      HTMLFormElement.prototype.submit.call(form);
      return;
    }
    delete form.dataset.busy;
  });
</script>
