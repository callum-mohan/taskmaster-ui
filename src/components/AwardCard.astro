---
import type { Award } from "../types";
import { withBase } from "../lib/url";
import PlayerAvatar from "./PlayerAvatar.astro";

interface Props {
  award: Award;
  class?: string;
}

const { award, class: className = "" } = Astro.props;

const accentText: Record<Award["accent"], string> = {
  acid: "text-acid",
  magenta: "text-magenta",
  amber: "text-amber",
  cyan: "text-cyan",
};
const accentBorder: Record<Award["accent"], string> = {
  acid: "hover:border-acid/50",
  magenta: "hover:border-magenta/50",
  amber: "hover:border-amber/50",
  cyan: "hover:border-cyan/50",
};
---

<article
  class:list={[
    "flex h-full flex-col rounded-lg border border-grid bg-term-panel p-4 transition-colors sm:p-5",
    accentBorder[award.accent],
    className,
  ]}
>
  <p class="text-[11px] text-ink-faint">
    <span class="text-acid">$</span>
    {" "}{award.command}
  </p>
  <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
    <h3
      class:list={[
        "text-sm font-extrabold tracking-wide uppercase",
        accentText[award.accent],
      ]}
    >
      {award.title}
    </h3>
    {
      award.active && (
        <span class="inline-flex items-center gap-1.5 rounded border border-amber/50 bg-amber/10 px-1.5 py-0.5 text-[9px] font-bold tracking-[0.2em] text-amber">
          <span
            class="live-dot h-1.5 w-1.5 rounded-full bg-amber"
            aria-hidden="true"
          />
          STILL GOING
        </span>
      )
    }
  </div>

  <p
    class:list={[
      "mt-3 text-2xl font-extrabold tabular-nums sm:text-3xl",
      accentText[award.accent],
    ]}
  >
    {award.value}
  </p>

  {
    award.player ? (
      <a
        href={withBase(`/players/${award.player.id}`)}
        class="group mt-3 flex items-center gap-2.5"
      >
        <PlayerAvatar player={award.player} class="h-9 w-9 rounded" />
        <span class="min-w-0">
          <span class="block truncate font-semibold text-ink group-hover:text-acid">
            {award.player.name}
          </span>
          {award.detail && (
            <span class="block truncate text-[11px] text-ink-faint">
              {award.detail}
            </span>
          )}
        </span>
      </a>
    ) : (
      award.detail && (
        <p class="mt-3 text-[11px] text-ink-faint">{award.detail}</p>
      )
    )
  }
</article>
