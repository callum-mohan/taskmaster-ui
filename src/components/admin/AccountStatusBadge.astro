---
import type { PlayerAccountStatus } from "../../types";

interface Props {
  status: PlayerAccountStatus;
  class?: string;
}

const { status, class: className = "" } = Astro.props;

const config: Record<PlayerAccountStatus, { label: string; classes: string }> =
  {
    none: {
      label: "NO EMAIL",
      classes: "border-grid bg-term-panel-2 text-ink-faint",
    },
    invited: {
      label: "INVITED",
      classes: "border-cyan/50 bg-cyan/10 text-cyan",
    },
    pending: {
      label: "TEMP PASSWORD",
      classes: "border-amber/50 bg-amber/10 text-amber",
    },
    active: {
      label: "ACTIVE",
      classes: "border-acid-dim bg-acid/10 text-acid",
    },
  };

const { label, classes } = config[status];
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 whitespace-nowrap rounded border px-2 py-0.5 text-[10px] font-bold tracking-[0.2em]",
    classes,
    className,
  ]}
>
  <span aria-hidden="true">●</span>
  {label}
</span>
