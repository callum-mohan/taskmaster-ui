---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import PollStatusBadge from "../../../components/PollStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import {
  btnPrimary,
  tableCell,
  tableHead,
} from "../../../components/admin/styles";
import { withBase } from "../../../lib/url";
import { ukDateFormat } from "../../../lib/time";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/admin/login"));

const { getPollSummaries, players } = await Astro.locals.getQueries();
const summaries = getPollSummaries();
const done = Astro.url.searchParams.get("done");
const subject = Astro.url.searchParams.get("name");

const stamp = ukDateFormat({
  day: "2-digit",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const fmt = (iso: string) => stamp.format(new Date(iso));
---

<AdminLayout title="Polls">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight text-ink">
        <span class="text-acid">$</span> ls ~/polls
      </h1>
      <p class="mt-1 text-sm text-ink-dim">
        {summaries.length} polls. Published polls appear on the homepage between their
        open and close times.
      </p>
    </div>
    <a href={withBase("/admin/polls/new")} class={btnPrimary}>+ new poll</a>
  </div>

  {
    done && subject && (
      <Notice tone="success" class="mt-6">
        {done === "deleted" ? `Deleted ${subject}.` : `Saved ${subject}.`}
      </Notice>
    )
  }

  <TerminalWindow title="~/polls" class="mt-6" bodyClass="p-0 sm:p-0">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th scope="col" class={tableHead}>question</th>
            <th scope="col" class:list={[tableHead, "hidden md:table-cell"]}>
              opens → closes
            </th>
            <th scope="col" class={tableHead}>status</th>
            <th scope="col" class={tableHead}>voted</th>
            <th scope="col" class={tableHead}
              ><span class="sr-only">actions</span></th
            >
          </tr>
        </thead>
        <tbody>
          {
            summaries.map(({ poll, voterCount }) => (
              <tr class="transition-colors hover:bg-term-panel-2">
                <td class={tableCell}>
                  <span class="text-ink">{poll.question}</span>
                  <span class="mt-0.5 block text-[11px] text-ink-faint">
                    {poll.kind === "single" ? "single" : "multiple"} choice ·{" "}
                    {poll.options.length} options ·{" "}
                    {poll.anonymous ? "anonymous" : "public"}
                  </span>
                </td>
                <td
                  class:list={[
                    tableCell,
                    "hidden whitespace-nowrap text-xs text-ink-faint md:table-cell",
                  ]}
                >
                  {fmt(poll.opensAt)} → {fmt(poll.closesAt)}
                </td>
                <td class={tableCell}>
                  <PollStatusBadge
                    status={poll.status}
                    draft={!poll.published}
                  />
                </td>
                <td class:list={[tableCell, "tabular-nums text-ink-dim"]}>
                  {voterCount}/{players.length}
                </td>
                <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                  <a
                    href={withBase(`/admin/polls/new?from=${poll.id}`)}
                    class="mr-4 text-ink-dim hover:text-ink hover:underline"
                    aria-label={`Duplicate poll: ${poll.question}`}
                  >
                    duplicate
                  </a>
                  <a
                    href={withBase(`/admin/polls/${poll.id}`)}
                    class="text-cyan hover:underline"
                    aria-label={`Edit poll: ${poll.question}`}
                  >
                    edit
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        summaries.length === 0 && (
          <p class="p-6 text-sm text-ink-dim">
            No polls yet.{" "}
            <a
              href={withBase("/admin/polls/new")}
              class="text-cyan hover:underline"
            >
              Create one
            </a>
            .
          </p>
        )
      }
    </div>
  </TerminalWindow>
</AdminLayout>
