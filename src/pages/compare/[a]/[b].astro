---
import Layout from "../../../layouts/Layout.astro";
import ComparisonView from "../../../components/ComparisonView.astro";

const { players, getPlayerComparison } = await Astro.locals.getQueries();

const { a, b } = Astro.params;
const comparison = getPlayerComparison(a!, b!);

// Unknown or identical ids → 404 rather than a broken page.
if (!comparison) {
  return Astro.rewrite("/404");
}
---

<Layout
  title={`${comparison.a.player.name} vs ${comparison.b.player.name}`}
  description={`Head to head: ${comparison.a.player.name} (#${comparison.a.rank}) vs ${comparison.b.player.name} (#${comparison.b.rank}) in the EAYL Taskmaster.`}
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <header class="mb-8">
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        diff --players
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        Head&nbsp;to&nbsp;<span class="text-acid text-glow">Head</span>
      </h1>
      <p class="mt-3 max-w-xl text-sm text-ink-dim">
        Two players enter. The stats don't lie. Pick any pair to see who's
        really winning the academy.
      </p>
    </header>

    <ComparisonView comparison={comparison} players={players} />
  </div>
</Layout>
