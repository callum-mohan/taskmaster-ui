---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import RecapForm from "../../../components/admin/RecapForm.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import { btnGhost } from "../../../components/admin/styles";
import {
  deleteRecap,
  describeWriteError,
  getRecap,
  saveRecap,
} from "../../../data/admin";
import {
  parseRecapForm,
  type FieldErrors,
  type FormValues,
} from "../../../lib/admin-forms";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

const { players, getTaskById, getRecapTaskIds } =
  await Astro.locals.getQueries();
const task = getTaskById(Astro.params.taskId!);
if (!task) return Astro.rewrite("/404");

const weekName = `week ${task.weekNumber}`;
const recap = await getRecap(task.id);
let values: FormValues = {
  headline: recap?.headline ?? "",
  summary: recap?.summary ?? "",
  moment: recap?.moment ?? "",
  momentPlayerId: recap?.momentPlayerId ?? "",
  quoteText: recap?.quoteText ?? "",
  quoteAttribution: recap?.quoteAttribution ?? "",
};
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("intent") === "delete") {
    await deleteRecap(task.id);
    const query = new URLSearchParams({ done: "cleared", name: weekName });
    return Astro.redirect(withBase(`/admin/recaps?${query}`));
  }
  const parsed = parseRecapForm(form);
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    try {
      await saveRecap(task.id, parsed.data);
      const query = new URLSearchParams({ done: "saved", name: weekName });
      return Astro.redirect(withBase(`/admin/recaps?${query}`));
    } catch (error) {
      formError = describeWriteError(error);
      if (!formError) throw error;
    }
  }
}

const hasPage = getRecapTaskIds().includes(task.id);
---

<AdminLayout title={`Recap · ${weekName}`}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href={withBase("/admin/recaps")} class={btnGhost}>&larr; ALL RECAPS</a>
    {
      hasPage ? (
        <a
          href={withBase(`/recaps/${task.id}`)}
          class="text-xs text-cyan hover:underline"
          target="_blank"
          rel="noopener"
        >
          view recap ↗
        </a>
      ) : (
        <span class="text-xs text-ink-faint">
          The recap page goes up once this week is scored.
        </span>
      )
    }
  </div>
  <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> vim ~/recaps/{task.id}.md
  </h1>
  <p class="mt-1 text-sm text-ink-dim">
    Week {task.weekNumber}: {task.title}
  </p>
  <TerminalWindow title={`~/recaps/${task.id}.md`} class="mt-6">
    <RecapForm
      values={values}
      players={players}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
  {
    recap && (
      <section aria-labelledby="danger-heading" class="mt-8">
        <h2
          id="danger-heading"
          class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          danger zone
        </h2>
        <ConfirmDelete
          subject={`the ${weekName} write-up`}
          label="clear write-up"
        />
      </section>
    )
  }
</AdminLayout>
