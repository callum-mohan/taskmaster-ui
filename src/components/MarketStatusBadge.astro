---
import type { MarketListingStatus, MarketOfferStatus } from "../types";

interface Props {
  status: MarketListingStatus | MarketOfferStatus;
  class?: string;
}

const { status, class: className = "" } = Astro.props;

const config: Record<
  MarketListingStatus | MarketOfferStatus,
  { label: string; classes: string }
> = {
  open: { label: "FOR SALE", classes: "border-acid/40 bg-acid/10 text-acid" },
  sold: { label: "SOLD", classes: "border-amber/40 bg-amber/10 text-amber" },
  cancelled: {
    label: "TAKEN DOWN",
    classes: "border-grid bg-term-panel text-ink-faint",
  },
  expired: {
    label: "EXPIRED",
    classes: "border-grid bg-term-panel text-ink-faint",
  },
  pending: {
    label: "PENDING",
    classes: "border-amber/40 bg-amber/10 text-amber",
  },
  accepted: {
    label: "ACCEPTED",
    classes: "border-acid/40 bg-acid/10 text-acid",
  },
  declined: {
    label: "DECLINED",
    classes: "border-grid bg-term-panel text-ink-faint",
  },
  withdrawn: {
    label: "WITHDRAWN",
    classes: "border-grid bg-term-panel text-ink-faint",
  },
};

const { label, classes } = config[status];
---

<span
  class:list={[
    "inline-flex items-center rounded border px-2 py-0.5 text-[10px] font-bold tracking-[0.2em]",
    classes,
    className,
  ]}
>
  {label}
</span>
