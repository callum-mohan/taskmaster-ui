---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import TaskStatusBadge from "../../../components/TaskStatusBadge.astro";
import { getScoreCountsByTask } from "../../../data/admin";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/admin/login"));

const [{ tasks, getLiveTask }, counts] = await Promise.all([
  Astro.locals.getQueries(),
  getScoreCountsByTask(),
]);
const onAirId = getLiveTask()?.id;
// Held weeks first, then the most recent released weeks (the ones a show
// is usually run for).
const held = tasks.filter((t) => t.resultsHeld);
const others = tasks
  .filter((t) => !t.resultsHeld && t.status !== "upcoming")
  .sort((a, b) => b.weekNumber - a.weekNumber);
const label = (n: number) => `WEEK ${String(n).padStart(2, "0")}`;
---

<AdminLayout title="Results night">
  <h1 class="text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> ./results-night
  </h1>
  <p class="mt-1 max-w-prose text-sm text-ink-dim">
    Hold a week's results to keep them off the public site, then reveal them one
    at a time on
    <a
      href={withBase("/live")}
      class="text-cyan hover:underline"
      target="_blank"
      rel="noopener">/live</a
    >, last place first. Publishing ends the show and updates the leaderboard.
  </p>

  <TerminalWindow
    title="~/results/held"
    meta={`${held.length} held`}
    class="mt-6"
  >
    {
      held.length === 0 ? (
        <p class="text-sm text-ink-dim">No results are being held.</p>
      ) : (
        <ul class="grid gap-2 sm:grid-cols-2">
          {held.map((task) => {
            const count = counts.get(task.id)?.scores ?? 0;
            return (
              <li>
                <a
                  href={withBase(`/admin/live/${task.id}`)}
                  class="group flex h-full flex-col gap-2 rounded-md border border-amber/50 px-4 py-3 transition-colors hover:border-amber"
                >
                  <span class="flex items-center justify-between gap-3">
                    <span class="text-xs font-bold tracking-widest text-magenta">
                      {label(task.weekNumber)}
                    </span>
                    <span class="text-[10px] font-bold tracking-widest text-amber">
                      {task.id === onAirId ? "ON AIR" : "HELD"}
                    </span>
                  </span>
                  <span class="text-sm text-ink group-hover:text-acid">
                    {task.title}
                  </span>
                  <span class="text-xs text-ink-faint">
                    {task.resultsRevealCount} of {count} revealed
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </TerminalWindow>

  <TerminalWindow title="~/results/weeks" class="mt-6">
    <h2 class="sr-only">Other weeks</h2>
    <ul class="grid gap-2 sm:grid-cols-2">
      {
        others.map((task) => {
          const count = counts.get(task.id)?.scores ?? 0;
          return (
            <li>
              <a
                href={withBase(`/admin/live/${task.id}`)}
                class="group flex h-full flex-col gap-2 rounded-md border border-grid px-4 py-3 transition-colors hover:border-acid-dim"
              >
                <span class="flex items-center justify-between gap-3">
                  <span class="text-xs font-bold tracking-widest text-magenta">
                    {label(task.weekNumber)}
                  </span>
                  <TaskStatusBadge status={task.status} />
                </span>
                <span class="text-sm text-ink group-hover:text-acid">
                  {task.title}
                </span>
                <span class="text-xs text-ink-faint">
                  {count > 0
                    ? `${count} score${count === 1 ? "" : "s"} · public`
                    : "not scored"}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    {
      others.length === 0 && (
        <p class="text-sm text-ink-dim">No released weeks yet.</p>
      )
    }
  </TerminalWindow>
</AdminLayout>
