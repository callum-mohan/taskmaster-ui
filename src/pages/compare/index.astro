---
import Layout from "../../layouts/Layout.astro";
import ComparisonView from "../../components/ComparisonView.astro";

const { players, getTopPlayers, getPlayerComparison } =
  await Astro.locals.getQueries();

// Default view compares the top two players on the leaderboard.
const [first, second] = getTopPlayers(2);
const comparison = getPlayerComparison(first.player.id, second.player.id)!;
---

<Layout
  title="Compare"
  description="Put any two EAYL Taskmaster players head to head, task by task."
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <header class="mb-8">
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        diff --players
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        Head&nbsp;to&nbsp;<span class="text-acid text-glow">Head</span>
      </h1>
      <p
        class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim sm:text-base"
      >
        <span class="text-acid">//</span> Two players enter. The stats don't lie.
        Pick any pair to see who's really winning the academy.
      </p>
    </header>

    <ComparisonView comparison={comparison} players={players} />
  </div>
</Layout>
