---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import ShopItemForm from "../../../components/admin/ShopItemForm.astro";
import { btnGhost } from "../../../components/admin/styles";
import { createShopItem, describeWriteError } from "../../../data/admin";
import {
  parseShopItemForm,
  type FieldErrors,
  type FormValues,
} from "../../../lib/admin-forms";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

let values: FormValues = { available: "on", price: "10" };
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const parsed = parseShopItemForm(await Astro.request.formData());
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    try {
      await createShopItem(parsed.data);
      const query = new URLSearchParams({
        done: "saved",
        name: parsed.data.name,
      });
      return Astro.redirect(withBase(`/admin/site?${query}#shop`));
    } catch (error) {
      formError = describeWriteError(error);
      if (!formError) throw error;
    }
  }
}
---

<AdminLayout title="New shop item">
  <a href={withBase("/admin/site#shop")} class={btnGhost}>&larr; SHOP</a>
  <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> shop add
  </h1>
  <TerminalWindow title="~/shop/new.item" class="mt-6">
    <ShopItemForm
      mode="create"
      values={values}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
</AdminLayout>
