{
  "name": "taskmaster-ui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:http": "node --env-file=.env.local scripts/db-migrate-http.mjs",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "node scripts/create-admin.mjs",
    "players:accounts": "node scripts/create-player-accounts.mjs",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@neondatabase/auth": "^0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
