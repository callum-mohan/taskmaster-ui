---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import TaskStatusBadge from "../../../components/TaskStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import ScoreGrid from "../../../components/admin/ScoreGrid.astro";
import BonusForm from "../../../components/admin/BonusForm.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import { btnPrimary, btnGhost } from "../../../components/admin/styles";
import {
  addBonus,
  deleteBonus,
  describeWriteError,
  getTaskScoreSheet,
  saveTaskScores,
  saveTeamScores,
  updateBonus,
} from "../../../data/admin";
import {
  parseBonusForm,
  parseRowId,
  parseTaskScoresForm,
  parseTeamScoresForm,
  scoreField,
  type FieldErrors,
  type FormValues,
} from "../../../lib/admin-forms";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/admin/login"));

const { taskId } = Astro.params;
const { players, teams, getTaskById, getPlayerById, getPollBonusesForTask } =
  await Astro.locals.getQueries();
const task = getTaskById(taskId!);
if (!task) return Astro.rewrite("/404");

const isTeam = task.format === "team";
const pollBonuses = getPollBonusesForTask(task.id);
const weekLabel = `WEEK ${String(task.weekNumber).padStart(2, "0")}`;
const selfUrl = withBase(`/admin/scores/${task.id}`);

let gridValues: FormValues | undefined;
let gridErrors: FieldErrors = {};
let newBonusValues: FormValues = {};
let newBonusErrors: FieldErrors = {};
let bonusEdit:
  { rowId: number; values: FormValues; errors: FieldErrors } | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  try {
    if (intent === "save-scores") {
      if (isTeam) {
        const parsed = parseTeamScoresForm(
          form,
          teams.map((t) => t.id),
        );
        if (parsed.ok) {
          await saveTeamScores(task.id, parsed.data);
          return Astro.redirect(`${selfUrl}?done=scores`);
        }
        ({ values: gridValues, errors: gridErrors } = parsed);
      } else {
        const parsed = parseTaskScoresForm(
          form,
          players.map((p) => p.id),
        );
        if (parsed.ok) {
          await saveTaskScores(task.id, parsed.data);
          return Astro.redirect(`${selfUrl}?done=scores`);
        }
        ({ values: gridValues, errors: gridErrors } = parsed);
      }
    } else if (intent === "add-bonus") {
      const parsed = parseBonusForm(form);
      if (parsed.ok) {
        await addBonus(task.id, parsed.data);
        return Astro.redirect(`${selfUrl}?done=bonus-added#bonuses`);
      }
      newBonusValues = parsed.values;
      newBonusErrors = parsed.errors;
    } else if (intent === "update-bonus" || intent === "delete-bonus") {
      const rowId = parseRowId(form);
      if (rowId === undefined) {
        formError = "That bonus no longer exists.";
      } else if (intent === "delete-bonus") {
        await deleteBonus(task.id, rowId);
        return Astro.redirect(`${selfUrl}?done=bonus-deleted#bonuses`);
      } else {
        const parsed = parseBonusForm(form);
        if (parsed.ok) {
          await updateBonus(task.id, rowId, parsed.data);
          return Astro.redirect(`${selfUrl}?done=bonus-saved#bonuses`);
        }
        bonusEdit = { rowId, values: parsed.values, errors: parsed.errors };
      }
    }
  } catch (error) {
    formError = describeWriteError(error);
    if (!formError) throw error;
  }
}

const sheet = await getTaskScoreSheet(task.id);

// Saved values pre-fill the grid unless a rejected submission is being shown.
gridValues ??= Object.fromEntries(
  isTeam
    ? sheet.team.map((row) => [
        scoreField.points(row.teamId),
        String(row.points),
      ])
    : sheet.individual.flatMap((row) => [
        [scoreField.points(row.playerId), String(row.points)],
        [scoreField.comment(row.playerId), row.comment ?? ""],
      ]),
);

const gridRows = isTeam
  ? teams.map((team) => ({
      id: team.id,
      name: team.name,
      detail: team.memberIds
        .map((id) => getPlayerById(id)?.name ?? id)
        .join(", "),
    }))
  : players.map((p) => ({ id: p.id, name: p.name }));

const scoredCount = isTeam ? sheet.team.length : sheet.individual.length;
// Scores for the other format can exist if a task's format was changed.
const hiddenCount = isTeam ? sheet.individual.length : sheet.team.length;

const playerName = (id: string) => getPlayerById(id)?.name ?? id;

const done = Astro.url.searchParams.get("done");
const doneMessage: Record<string, string> = {
  scores: "Scores saved. The leaderboard is already updated.",
  "bonus-added": "Bonus added.",
  "bonus-saved": "Bonus saved.",
  "bonus-deleted": "Bonus deleted.",
};
---

<AdminLayout title={`Scores · ${weekLabel}`}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href={withBase("/admin/scores")} class={btnGhost}>&larr; ALL WEEKS</a>
    <span class="flex gap-4 text-xs">
      <a
        href={withBase(`/admin/tasks/${task.id}`)}
        class="text-cyan hover:underline">edit task</a
      >
      <a
        href={withBase(`/tasks/${task.id}`)}
        class="text-cyan hover:underline"
        target="_blank"
        rel="noopener">view public page ↗</a
      >
    </span>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <span class="text-xs font-bold tracking-widest text-magenta"
      >{weekLabel}</span
    >
    <TaskStatusBadge status={task.status} />
    {
      isTeam && (
        <span class="text-[10px] font-bold tracking-widest text-cyan">
          TEAM TASK
        </span>
      )
    }
  </div>
  <h1 class="mt-2 text-2xl font-extrabold tracking-tight text-ink">
    {task.title}
  </h1>

  {
    done && doneMessage[done] && (
      <Notice tone="success" class="mt-6">
        {doneMessage[done]}
      </Notice>
    )
  }
  {
    formError && (
      <Notice tone="error" class="mt-6">
        {formError}
      </Notice>
    )
  }
  {
    Object.keys(gridErrors).length > 0 && (
      <Notice tone="error" class="mt-6">
        Nothing was saved. Fix the highlighted cells and try again.
      </Notice>
    )
  }

  <TerminalWindow
    title={`~/scores/${task.id}.csv`}
    meta={`${scoredCount} / ${gridRows.length} scored`}
    class="mt-6"
  >
    <h2 class="sr-only">{isTeam ? "Team points" : "Player points"}</h2>
    <p class="mb-4 text-sm text-ink-dim">
      {
        isTeam
          ? "Points per squad. Every member is credited with their squad's points. Leave a cell blank if a squad hasn't been scored."
          : "Points per player. Leave a cell blank if a player hasn't been scored. Notes record how the points were made up."
      }{" "}
      Positions are worked out from the points.
    </p>
    {
      hiddenCount > 0 && (
        <Notice tone="error" class="mb-4">
          {hiddenCount} {isTeam ? "individual" : "team"} score
          {hiddenCount === 1 ? " is" : "s are"} stored for this week from before
          its format changed. They're ignored while it's a{" "}
          {isTeam ? "team" : "individual"} task.
        </Notice>
      )
    }
    <form method="post">
      <input type="hidden" name="intent" value="save-scores" />
      <ScoreGrid
        rows={gridRows}
        values={gridValues}
        errors={gridErrors}
        entity={isTeam ? "team" : "player"}
        withComment={!isTeam}
      />
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button type="submit" class={btnPrimary}>save scores</button>
        <span class="text-xs text-ink-faint"
          >Saves the whole week in one go.</span
        >
      </div>
    </form>
  </TerminalWindow>

  <section id="bonuses" aria-labelledby="bonus-heading" class="mt-8">
    <TerminalWindow
      title={`~/scores/${task.id}.bonus`}
      meta={`${sheet.bonuses.length} entries`}
    >
      <h2 id="bonus-heading" class="text-sm font-bold text-ink">
        <span class="text-acid">$</span> bonus --week {task.weekNumber}
      </h2>
      <p class="mt-1 mb-5 text-sm text-ink-dim">
        One-off bonuses (positive) or deductions (negative). They count toward
        the overall total but never change this week's positions.
      </p>
      <ul class="space-y-3">
        {
          sheet.bonuses.map((bonus) => {
            const editing =
              bonusEdit?.rowId === bonus.id ? bonusEdit : undefined;
            return (
              <li class="flex flex-col gap-2 rounded-md border border-grid p-3 lg:flex-row lg:items-start">
                <div class="flex-1">
                  <BonusForm
                    players={players}
                    rowId={bonus.id}
                    values={
                      editing?.values ?? {
                        playerId: bonus.playerId,
                        points: String(bonus.points),
                        reason: bonus.reason,
                      }
                    }
                    errors={editing?.errors}
                  />
                </div>
                <ConfirmDelete
                  subject={`${bonus.points > 0 ? "+" : ""}${bonus.points} for ${playerName(bonus.playerId)}`}
                  intent="delete-bonus"
                  fields={{ rowId: bonus.id }}
                />
              </li>
            );
          })
        }
      </ul>
      {
        pollBonuses.length > 0 && (
          <div class="mt-5 rounded-md border border-grid p-3">
            <h3 class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint">
              poll voting bonuses
            </h3>
            <ul class="space-y-1 text-sm">
              {pollBonuses.map(({ poll, voterCount }) => (
                <li class="text-ink-dim">
                  <span class="text-acid">+{poll.voteBonusPoints}</span> ×{" "}
                  {voterCount} {voterCount === 1 ? "voter" : "voters"} ·{" "}
                  <a
                    href={withBase(`/admin/polls/${poll.id}`)}
                    class="text-cyan hover:underline"
                  >
                    {poll.question}
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-2 text-xs text-ink-faint">
              Earned automatically by voting; manage them on the poll.
            </p>
          </div>
        )
      }
      <div class="mt-5 rounded-md border border-dashed border-grid p-3">
        <h3
          class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          add bonus / deduction
        </h3>
        <BonusForm
          players={players}
          values={newBonusValues}
          errors={newBonusErrors}
        />
      </div>
    </TerminalWindow>
  </section>
</AdminLayout>
