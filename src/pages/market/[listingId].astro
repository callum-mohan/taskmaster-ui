---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import ShopItemArt from "../../components/ShopItemArt.astro";
import CoinAmount from "../../components/CoinAmount.astro";
import RarityBadge from "../../components/RarityBadge.astro";
import MarketStatusBadge from "../../components/MarketStatusBadge.astro";
import MarketSalesFeed from "../../components/MarketSalesFeed.astro";
import Notice from "../../components/admin/Notice.astro";
import AdminEditLink from "../../components/AdminEditLink.astro";
import {
  btnDanger,
  btnGhost,
  btnPrimary,
  inputClass,
  labelClass,
} from "../../components/admin/styles";
import { rarityOf } from "../../data/coin-rules";
import {
  CATEGORY_INFO,
  COSMETIC_KIND_LABELS,
  POWER_UP_INFO,
} from "../../data/coins";
import {
  describeMarketOutcome,
  isMarketOutcome,
} from "../../lib/account-forms";
import { timeLeftLabel } from "../../lib/coin-ui";
import { ukDateFormat } from "../../lib/time";
import { withBase } from "../../lib/url";
import type { MarketBuyBlock } from "../../types";

const [queries, viewer] = await Promise.all([
  Astro.locals.getQueries(),
  Astro.locals.getViewer(),
]);
const { marketEnabled, getMarketListing, getPlayerById } = queries;
if (!marketEnabled) return Astro.rewrite("/404");

const id = Number(Astro.params.listingId);
const playerId =
  viewer?.playerId && getPlayerById(viewer.playerId)
    ? viewer.playerId
    : undefined;
const detail = Number.isSafeInteger(id)
  ? getMarketListing(id, playerId)
  : undefined;
if (!detail) return Astro.rewrite("/404");

const { view, history, buyBlocked, offerBlocked, myOffer, offers, available } =
  detail;
const { listing, item, seller, status, range, expiresAt } = view;
const isSeller = playerId === listing.sellerId;
const rarity = item.category === "power_up" ? undefined : rarityOf(item.price);
const kindLabel = item.cosmetic
  ? COSMETIC_KIND_LABELS[item.cosmetic.kind]
  : item.powerUp
    ? POWER_UP_INFO[item.powerUp].label
    : CATEGORY_INFO[item.category].label;
const offerMax = listing.price - 1;
const canOffer = !offerBlocked;

const outcomeParam = Astro.url.searchParams.get("market") ?? "";
const notice = isMarketOutcome(outcomeParam)
  ? describeMarketOutcome(outcomeParam)
  : undefined;

const BLOCK_LABEL: Record<MarketBuyBlock, string> = {
  guest: "sign in as a player to buy",
  disabled: "the market is closed",
  "season-closed": "the season's over",
  closed: "no longer for sale",
  "own-listing": "this is your listing",
  owned: "you already have one",
  "no-offers": "listed at the lowest price, so no offers",
  unaffordable: "not enough Clim Coin",
};
const action = withBase("/account/market");
const loginHref = withBase(
  `/login?${new URLSearchParams({ next: `/market/${listing.id}` })}`,
);
const dateFmt = ukDateFormat({
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});
---

<Layout
  title={`${item.name} · marketplace`}
  description={`${item.name} for sale on the EAYL Taskmaster marketplace for ${listing.price} Clim Coin.`}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <nav aria-label="Breadcrumb" class="text-xs text-ink-faint">
      <a href={withBase("/market")} class="text-cyan hover:underline"
        >← marketplace</a
      >
    </nav>

    {
      notice && (
        <Notice tone={notice.tone} class="mt-6">
          {notice.message}
        </Notice>
      )
    }

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_22rem]">
      <TerminalWindow
        title={`~/market/listing-${listing.id}`}
        meta={status === "open" ? timeLeftLabel(expiresAt) : undefined}
      >
        <div class="flex flex-col gap-6 p-5 sm:flex-row">
          <ShopItemArt item={item} class="h-28 w-28 shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="text-[10px] uppercase tracking-[0.25em] text-ink-faint">
              {kindLabel}
            </p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink">
              {item.name}
            </h1>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <MarketStatusBadge status={status} />
              {rarity && <RarityBadge rarity={rarity} />}
              {
                item.crateOnly && (
                  <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-magenta">
                    egg exclusive
                  </span>
                )
              }
            </div>
            {
              item.description && (
                <p class="mt-3 text-sm leading-relaxed text-ink-dim">
                  {item.description}
                </p>
              )
            }
            <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-xs">
              <dt class="text-ink-faint">price</dt>
              <dd>
                <CoinAmount amount={listing.price} class="text-amber" />
                {
                  !item.crateOnly && (
                    <span class="text-ink-faint"> (shop: {item.price})</span>
                  )
                }
              </dd>
              <dt class="text-ink-faint">seller</dt>
              <dd>
                <a
                  href={withBase(`/players/${seller.id}`)}
                  class="text-cyan hover:underline">{seller.name}</a
                >
              </dd>
              <dt class="text-ink-faint">listed</dt>
              <dd class="text-ink-dim">
                <time datetime={listing.at}
                  >{dateFmt.format(new Date(listing.at))}</time
                >
              </dd>
              {
                status === "open" && (
                  <>
                    <dt class="text-ink-faint">ends</dt>
                    <dd class="text-ink-dim">
                      <time datetime={expiresAt}>
                        {dateFmt.format(new Date(expiresAt))}
                      </time>
                    </dd>
                    <dt class="text-ink-faint">offers</dt>
                    <dd class="text-ink-dim">
                      {view.offerCount === 0
                        ? "none yet"
                        : `${view.offerCount} (best ${view.bestOffer})`}
                    </dd>
                  </>
                )
              }
              {
                view.sale && (
                  <>
                    <dt class="text-ink-faint">sold to</dt>
                    <dd class="text-ink-dim">
                      {view.sale.buyer.name} for {view.sale.sale.price}
                    </dd>
                  </>
                )
              }
              {
                listing.cancelledByName && (
                  <>
                    <dt class="text-ink-faint">taken down</dt>
                    <dd class="text-ink-dim">by the Taskmaster</dd>
                  </>
                )
              }
            </dl>
            {
              viewer?.isAdmin && (
                <AdminEditLink
                  href="/admin/market"
                  subject="this listing"
                  class="mt-4"
                />
              )
            }
          </div>
        </div>
      </TerminalWindow>

      <aside class="flex flex-col gap-6" aria-label="Trade">
        <section
          aria-labelledby="buy-heading"
          class="rounded-lg border border-grid bg-term-panel/60 p-5"
        >
          <h2
            id="buy-heading"
            class="text-xs font-bold uppercase tracking-[0.2em] text-ink-faint"
          >
            {isSeller ? "Your listing" : "Buy it"}
          </h2>
          {
            available !== undefined && !isSeller && (
              <p class="mt-2 text-[11px] text-ink-faint">
                you can spend{" "}
                <CoinAmount amount={available} class="text-amber" />
              </p>
            )
          }
          {
            isSeller ? (
              status === "open" ? (
                <form method="post" action={action} class="mt-4">
                  <input type="hidden" name="intent" value="cancel" />
                  <input type="hidden" name="listingId" value={listing.id} />
                  <input type="hidden" name="from" value="listing" />
                  <button type="submit" class:list={[btnDanger, "w-full"]}>
                    take it down
                  </button>
                </form>
              ) : (
                <p class="mt-3 text-sm text-ink-dim">
                  This listing has closed.
                </p>
              )
            ) : buyBlocked === "guest" ? (
              <a href={loginHref} class:list={[btnGhost, "mt-4 w-full"]}>
                sign in to buy →
              </a>
            ) : buyBlocked ? (
              <p class="mt-3 text-sm text-ink-dim">
                <span class="text-cyan" aria-hidden="true">
                  &gt;{" "}
                </span>
                {BLOCK_LABEL[buyBlocked]}.
              </p>
            ) : (
              <form method="post" action={action} class="mt-4">
                <input type="hidden" name="intent" value="buy" />
                <input type="hidden" name="listingId" value={listing.id} />
                <input type="hidden" name="price" value={listing.price} />
                <input type="hidden" name="from" value="listing" />
                <button type="submit" class:list={[btnPrimary, "w-full"]}>
                  buy for {listing.price} Clim Coin
                </button>
              </form>
            )
          }
        </section>

        {
          !isSeller && buyBlocked !== "guest" && status === "open" && (
            <section
              aria-labelledby="offer-heading"
              class="rounded-lg border border-grid bg-term-panel/60 p-5"
            >
              <h2
                id="offer-heading"
                class="text-xs font-bold uppercase tracking-[0.2em] text-ink-faint"
              >
                Make an offer
              </h2>
              {myOffer && (
                <div class="mt-3 flex flex-wrap items-center justify-between gap-2 rounded-md border border-amber/40 bg-amber/5 px-3 py-2 text-xs">
                  <span class="text-ink-dim">
                    your offer:{" "}
                    <CoinAmount
                      amount={myOffer.offer.amount}
                      class="text-amber"
                    />{" "}
                    (held)
                  </span>
                  <form method="post" action={action}>
                    <input type="hidden" name="intent" value="withdraw" />
                    <input
                      type="hidden"
                      name="offerId"
                      value={myOffer.offer.id}
                    />
                    <input type="hidden" name="from" value="listing" />
                    <button type="submit" class="text-cyan hover:underline">
                      withdraw
                    </button>
                  </form>
                </div>
              )}
              {canOffer ? (
                <form method="post" action={action} class="mt-4 space-y-3">
                  <input type="hidden" name="intent" value="offer" />
                  <input type="hidden" name="listingId" value={listing.id} />
                  <input type="hidden" name="from" value="listing" />
                  <div>
                    <label for="offer-amount" class={labelClass}>
                      {myOffer ? "change your offer" : "your offer"} (
                      {range.min}–{offerMax})
                    </label>
                    <input
                      id="offer-amount"
                      name="amount"
                      type="number"
                      inputmode="numeric"
                      required
                      min={range.min}
                      max={offerMax}
                      value={myOffer?.offer.amount ?? range.min}
                      class:list={[inputClass(false), "mt-1"]}
                    />
                  </div>
                  <p class="text-[11px] leading-relaxed text-ink-faint">
                    The coins are held until the seller accepts or declines, you
                    withdraw, or the listing ends.
                  </p>
                  <button type="submit" class:list={[btnGhost, "w-full"]}>
                    {myOffer ? "update offer" : "make offer"}
                  </button>
                </form>
              ) : (
                <p class="mt-3 text-sm text-ink-dim">
                  <span class="text-cyan" aria-hidden="true">
                    &gt;{" "}
                  </span>
                  {BLOCK_LABEL[offerBlocked]}.
                </p>
              )}
            </section>
          )
        }

        {
          isSeller && status === "open" && (
            <section
              aria-labelledby="offers-heading"
              class="rounded-lg border border-grid bg-term-panel/60 p-5"
            >
              <h2
                id="offers-heading"
                class="text-xs font-bold uppercase tracking-[0.2em] text-ink-faint"
              >
                Offers ({offers.length})
              </h2>
              {offers.length === 0 ? (
                <p class="mt-3 text-sm text-ink-faint">no offers yet.</p>
              ) : (
                <ul class="mt-3 divide-y divide-grid/60">
                  {offers.map((o) => (
                    <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-xs">
                      <span class="text-ink-dim">
                        {o.buyer.name}:{" "}
                        <CoinAmount
                          amount={o.offer.amount}
                          class="text-amber"
                        />
                      </span>
                      <span class="flex gap-2">
                        <form method="post" action={action}>
                          <input type="hidden" name="intent" value="accept" />
                          <input
                            type="hidden"
                            name="offerId"
                            value={o.offer.id}
                          />
                          <input type="hidden" name="from" value="listing" />
                          <button
                            type="submit"
                            class:list={[btnPrimary, "px-2 py-1"]}
                            aria-label={`Accept ${o.buyer.name}'s offer of ${o.offer.amount}`}
                          >
                            accept
                          </button>
                        </form>
                        <form method="post" action={action}>
                          <input type="hidden" name="intent" value="decline" />
                          <input
                            type="hidden"
                            name="offerId"
                            value={o.offer.id}
                          />
                          <input type="hidden" name="from" value="listing" />
                          <button
                            type="submit"
                            class:list={[btnGhost, "px-2 py-1"]}
                            aria-label={`Decline ${o.buyer.name}'s offer of ${o.offer.amount}`}
                          >
                            decline
                          </button>
                        </form>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }
      </aside>
    </div>

    <section aria-labelledby="history-heading" class="mt-12">
      <p class="prompt text-[11px] text-ink-faint">
        grep "{item.name}" ./market/sales.log
      </p>
      <h2 id="history-heading" class="mt-1 text-xl font-extrabold text-ink">
        Price history
      </h2>
      <MarketSalesFeed
        sales={history}
        hideItem
        empty="no earlier sales of this item this season."
        class="mt-4 max-w-2xl"
      />
    </section>
  </div>
</Layout>
