---
import Layout from "../layouts/Layout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import ShopItemCard from "../components/ShopItemCard.astro";
import CrateCard from "../components/CrateCard.astro";
import CrateReveal from "../components/CrateReveal.astro";
import RecentPulls from "../components/RecentPulls.astro";
import CoinAmount from "../components/CoinAmount.astro";
import Notice from "../components/admin/Notice.astro";
import { btnGhost } from "../components/admin/styles";
import { COIN_OUTCOME_NOTICE, parseCoinOutcome } from "../lib/coin-ui";
import { withBase } from "../lib/url";

const [queries, viewer] = await Promise.all([
  Astro.locals.getQueries(),
  Astro.locals.getViewer(),
]);
const {
  season,
  getShopSections,
  getWallet,
  getPlayerById,
  getGameRules,
  getCrateViews,
  getRecentPulls,
  getCratePull,
} = queries;

// Wallets are per season: only this season's players shop here.
const playerId =
  viewer?.playerId && getPlayerById(viewer.playerId)
    ? viewer.playerId
    : undefined;
const sections = getShopSections({ playerId });
const crates = getCrateViews({ playerId });
const recentPulls = getRecentPulls();
const wallet = playerId ? getWallet(playerId) : undefined;
const { coins } = getGameRules();

const outcome = parseCoinOutcome(Astro.url.searchParams.get("coins"));
// Just cracked an egg: reveal what hatched (only to the player who cracked it).
const pullId = Number(Astro.url.searchParams.get("pull"));
const pull =
  outcome === "opened" && playerId && Number.isInteger(pullId)
    ? getCratePull(pullId, playerId)
    : undefined;
const notice = outcome && !pull ? COIN_OUTCOME_NOTICE[outcome] : undefined;
---

<Layout
  title="Clim Coin shop"
  description="Spend Clim Coin on pets, avatars, flair and power-ups in the EAYL Taskmaster shop."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p
          class="prompt text-xs font-bold uppercase tracking-[0.3em] text-ink-dim"
        >
          ./shop --currency clim-coin
        </p>
        <h1
          class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
        >
          THE <span class="text-amber">CLIM COIN</span> SHOP
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim">
          <span class="text-acid">//</span> Earn coins by placing well and taking
          part ({season.name}: 1st place pays {coins.placement.first}), then
          spend them on pets, avatars, flair and power-ups. Wallets reset each
          season.
        </p>
      </div>
      {
        wallet ? (
          <div class="rounded-lg border border-amber/40 bg-amber/5 px-5 py-4">
            <p class="text-[10px] uppercase tracking-[0.25em] text-ink-faint">
              your balance
            </p>
            <CoinAmount
              amount={wallet.balance}
              class:list={[
                "mt-1 text-3xl",
                wallet.balance < 0 ? "text-danger" : "text-amber",
              ]}
            />
            <a
              href={withBase("/account#wallet")}
              class="mt-2 block text-xs text-cyan hover:underline"
            >
              open wallet →
            </a>
          </div>
        ) : (
          <div class="w-full max-w-xs rounded-lg border border-grid bg-term-panel/60 px-5 py-4 sm:w-auto">
            <p class="text-[10px] uppercase tracking-[0.25em] text-ink-faint">
              your balance
            </p>
            <p class="mt-1 text-sm leading-relaxed text-ink-dim">
              {viewer
                ? `Only ${season.name} players have a wallet here.`
                : "Sign in as a player to see your coins and buy."}
            </p>
            {!viewer && (
              <a
                href={withBase(
                  `/login?${new URLSearchParams({ next: "/shop" })}`,
                )}
                class="mt-2 block text-xs text-cyan hover:underline"
              >
                sign in →
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      notice && (
        <Notice tone={notice.tone} class="mt-6">
          {notice.message}
        </Notice>
      )
    }

    {pull && <CrateReveal pull={pull} class="mt-8" />}

    <section
      id="crates"
      aria-labelledby="crates-heading"
      class="mt-12 scroll-mt-24"
    >
      <p class="prompt text-[11px] text-ink-faint">ls ./eggs --odds</p>
      <h2
        id="crates-heading"
        class="mt-1 text-2xl font-extrabold tracking-tight text-ink"
      >
        Mystery eggs
      </h2>
      <p class="mt-1 max-w-2xl text-xs leading-relaxed text-ink-dim">
        Crack one open for a random pet, avatar or cosmetic you don't own yet
        (never a power-up). Rarity follows the shop price: Common up to 15, Rare
        16–29, Epic 30–39, Legendary 40+. The odds below are exact.
      </p>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        {
          crates.map((view) => (
            <CrateCard view={view} personal={playerId !== undefined} />
          ))
        }
      </div>
      {
        recentPulls.length > 0 && (
          <div class="mt-6 rounded-lg border border-grid bg-term-panel/40 px-4 py-3">
            <h3 class="text-[10px] font-bold uppercase tracking-[0.25em] text-ink-faint">
              recently hatched
            </h3>
            <RecentPulls pulls={recentPulls} class="mt-1" />
          </div>
        )
      }
    </section>

    {
      sections.length === 0 ? (
        <TerminalWindow title="~/shop" class="mt-10">
          <p class="text-sm text-ink-dim">
            <span class="text-amber">&gt;</span> The shelves are empty. The
            Taskmaster is restocking; check back soon.
          </p>
        </TerminalWindow>
      ) : (
        sections.map((section) => (
          <section aria-labelledby={`shop-${section.category}`} class="mt-12">
            <p class="prompt text-[11px] text-ink-faint">{section.command}</p>
            <h2
              id={`shop-${section.category}`}
              class="mt-1 text-2xl font-extrabold tracking-tight text-ink"
            >
              {section.label}
            </h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {section.listings.map((listing) => (
                <ShopItemCard listing={listing} />
              ))}
            </div>
          </section>
        ))
      )
    }

    <div class="mt-14 flex flex-wrap gap-3">
      <a href={withBase("/rules#clim-coin")} class={btnGhost}>
        how to earn coins
      </a>
      {
        wallet && (
          <a href={withBase("/account#wallet")} class={btnGhost}>
            your wallet
          </a>
        )
      }
    </div>
  </div>
</Layout>
