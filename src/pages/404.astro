---
import Layout from "../layouts/Layout.astro";
import LostGame from "../components/LostGame.astro";
import { getLostArchive } from "../data/queries";
import { withBase } from "../lib/url";

const archive = getLostArchive();

const btnPrimary =
  "inline-flex items-center justify-center gap-2 rounded-md border border-acid bg-acid/10 px-5 py-2.5 text-sm font-bold tracking-widest text-acid transition-colors hover:bg-acid hover:text-term-bg focus-visible:outline-none";
const btnGhost =
  "inline-flex items-center justify-center gap-2 rounded-md border border-grid px-4 py-2 text-xs font-bold tracking-widest text-ink-dim transition-colors hover:border-ink-faint hover:text-ink";

const links = [
  { href: "/tasks", label: "tasks" },
  { href: "/leaderboard", label: "leaderboard" },
  { href: "/compare", label: "compare" },
  { href: "/stats", label: "stats" },
  { href: "/players", label: "players" },
];
---

<Layout title="404 — Not Found">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="text-sm font-bold tracking-[0.3em] text-magenta">ERROR 404</p>
    <h1
      class="mt-3 text-6xl font-extrabold tracking-tight text-ink text-glow sm:text-8xl"
    >
      Not Found
    </h1>
    <p class="mt-4 max-w-md text-sm text-ink-dim">
      The Taskmaster searched everywhere and came back empty-handed. This page
      either never existed or has been disqualified.
    </p>

    <LostGame
      class="mt-8"
      archive={archive}
      homeHref={withBase("/")}
      path={Astro.url.pathname}
    />

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={withBase("/")} class={btnPrimary}>&larr; RETURN HOME</a>
    </div>

    <nav class="mt-8" aria-label="Site sections">
      <p class="mb-2 text-[10px] tracking-[0.2em] text-ink-faint uppercase">
        or jump to
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          links.map((link) => (
            <li>
              <a href={withBase(link.href)} class={btnGhost}>
                ./{link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>
