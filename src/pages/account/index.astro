---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import AdminField from "../../components/admin/AdminField.astro";
import Notice from "../../components/admin/Notice.astro";
import PlayerAvatar from "../../components/PlayerAvatar.astro";
import WalletSection from "../../components/WalletSection.astro";
import { btnPrimary, btnGhost } from "../../components/admin/styles";
import { updateOwnProfile } from "../../data/accounts";
import { runWalletAction } from "../../data/wallet-actions";
import { parseProfileForm, parseWalletAction } from "../../lib/account-forms";
import type { FieldErrors, FormValues } from "../../lib/admin-forms";
import { COIN_OUTCOME_NOTICE, parseCoinOutcome } from "../../lib/coin-ui";
import {
  LIST_PAGE_SIZE,
  pageHref,
  paginate,
  parsePage,
} from "../../lib/pagination";
import { withBase } from "../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
const player = Astro.locals.player;
if (!player || player.mustChangePassword) {
  return Astro.redirect(withBase("/login"));
}

let values: FormValues = {
  bio: player.bio ?? "",
  avatarUrl: player.avatarUrl ?? "",
};
let errors: FieldErrors = {};

// The player's wallet is per season: the season their roster row is in.
const season = (await Astro.locals.getSeasons()).seasonOfPlayer(
  player.playerId,
);

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  // Wallet forms carry an `intent`; the profile form doesn't.
  if (form.has("intent")) {
    const action = parseWalletAction(form);
    const outcome =
      action && season
        ? await runWalletAction(player.playerId, season, action, (id) =>
            Astro.locals.getQueries(id),
          )
        : "invalid";
    return Astro.redirect(withBase(`/account?coins=${outcome}#wallet`), 303);
  }
  const parsed = parseProfileForm(form);
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    await updateOwnProfile(player.playerId, parsed.data);
    return Astro.redirect(withBase("/account?done=saved"));
  }
}

const walletView = season
  ? await Astro.locals.getQueries(season.id).then((q) => {
      const wallet = q.getWallet(player.playerId);
      const panel = q.getPowerUpPanel(player.playerId);
      return {
        wallet,
        panel,
        inventory: q.getInventory(player.playerId),
        hint: panel.task
          ? q.getUnlockedHint(panel.task.id, player.playerId)
          : undefined,
        ledgerPage: paginate(
          wallet.ledger,
          parsePage(Astro.url.searchParams.get("history")),
          LIST_PAGE_SIZE,
        ),
      };
    })
  : undefined;
const ledgerHref = (page: number) =>
  pageHref(Astro.url, "history", page, {
    hash: "history",
    drop: ["coins", "done"],
  });
const coinOutcome = parseCoinOutcome(Astro.url.searchParams.get("coins"));
const coinNotice = coinOutcome ? COIN_OUTCOME_NOTICE[coinOutcome] : undefined;

const done = Astro.url.searchParams.get("done");
const notices: Record<string, string> = {
  saved: "Profile saved. It's live on your public page.",
  password: "Password changed.",
};
const notice = done ? notices[done] : undefined;
const avatarPreview = {
  id: player.playerId,
  name: player.playerName,
  ...(player.avatarUrl && { avatarUrl: player.avatarUrl }),
};
---

<Layout title="Your account">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex items-center gap-4">
        <PlayerAvatar player={avatarPreview} class="h-14 w-14 rounded-md" />
        <div>
          <p
            class="prompt text-xs font-bold uppercase tracking-[0.3em] text-ink-dim"
          >
            whoami
          </p>
          <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink">
            {player.playerName}
          </h1>
          <p class="mt-1 text-xs text-ink-faint">{player.email}</p>
        </div>
      </div>
      <a href={withBase(`/players/${player.playerId}`)} class={btnGhost}>
        view public profile →
      </a>
    </header>

    {
      notice && (
        <Notice tone="success" class="mt-6">
          {notice}
        </Notice>
      )
    }

    <TerminalWindow
      title={`~/players/${player.playerId}.md`}
      meta="edit profile"
      class="mt-8"
    >
      <form method="post" class="space-y-5" novalidate>
        <AdminField
          label="bio"
          name="bio"
          value={values.bio}
          error={errors.bio}
          rows={5}
          hint="Shown on your public player page. Up to 500 characters."
        />
        <AdminField
          label="avatar url"
          name="avatarUrl"
          type="url"
          value={values.avatarUrl}
          error={errors.avatarUrl}
          placeholder="https://…"
          hint="An https:// image link (or a /site path). Leave blank for a generated icon."
        />
        <p class="text-xs text-ink-faint">
          Your name, team and scores are managed by the Taskmaster.
        </p>
        <button type="submit" class={btnPrimary}>save profile</button>
      </form>
    </TerminalWindow>

    {
      walletView && season && (
        <WalletSection
          {...walletView}
          seasonName={season.name}
          seasonClosed={season.status === "closed"}
          ledgerHref={ledgerHref}
          notice={coinNotice}
          class="mt-12"
        />
      )
    }

    <section aria-labelledby="security-heading" class="mt-12">
      <h2
        id="security-heading"
        class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
      >
        security
      </h2>
      <div class="flex flex-wrap gap-3">
        <a href={withBase("/account/password")} class={btnGhost}>
          change password
        </a>
        {
          player.isAdmin && (
            <a href={withBase("/admin")} class={btnGhost}>
              admin area
            </a>
          )
        }
        <form method="post" action={withBase("/logout")}>
          <button type="submit" class={btnGhost}>sign out</button>
        </form>
      </div>
    </section>
  </div>
</Layout>
