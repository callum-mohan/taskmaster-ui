---
// One shop listing: the item, its price and, for the viewer, a buy button
// (a plain POST to `/account/shop/<id>`) or why they can't buy it.
// Limited-time stock says when it leaves.
import type { ShopListing } from "../types";
import ShopItemArt from "./ShopItemArt.astro";
import CoinAmount from "./CoinAmount.astro";
import RarityBadge from "./RarityBadge.astro";
import { getCrate, rarityOf } from "../data/coin-rules";
import { COSMETIC_KIND_LABELS, POWER_UP_INFO } from "../data/coins";
import { PURCHASE_BLOCK_LABEL, timeLeftLabel } from "../lib/coin-ui";
import { ukDateFormat } from "../lib/time";
import { btnPrimary } from "./admin/styles";
import { withBase } from "../lib/url";

interface Props {
  listing: ShopListing;
  class?: string;
}

const { listing, class: className } = Astro.props;
const { item, owned, charges, blocked } = listing;
const action = withBase(`/account/shop/${encodeURIComponent(item.id)}`);
const loginHref = withBase(
  `/login?${new URLSearchParams({ next: `/account/shop/${item.id}` })}`,
);
const kindLabel = item.cosmetic
  ? COSMETIC_KIND_LABELS[item.cosmetic.kind]
  : undefined;
// Only what eggs (crates) can hatch has a rarity.
const rarity = item.category === "power_up" ? undefined : rarityOf(item.price);
const passive = item.powerUp ? POWER_UP_INFO[item.powerUp].passive : false;
const exclusiveLabel = item.crateId
  ? `${getCrate(item.crateId)?.name ?? "seasonal egg"} exclusive`
  : "egg exclusive";
const untilFmt = ukDateFormat({
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});
const status =
  item.category === "power_up"
    ? charges > 0
      ? passive
        ? "✓ armed"
        : "✓ ready to use"
      : owned
        ? passive
          ? "triggered this season"
          : "used this season"
        : passive
          ? "passive · one per season"
          : "one per season"
    : owned
      ? "✓ in your wallet"
      : "";
---

<article
  id={`item-${item.id}`}
  class:list={[
    "flex min-w-0 scroll-mt-24 flex-col gap-3 rounded-lg border bg-term-panel/60 p-4 transition-colors",
    owned ? "border-acid-dim" : "border-grid hover:border-ink-faint",
    className,
  ]}
>
  <div class="flex items-start gap-3">
    <ShopItemArt item={item} />
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-sm font-extrabold text-ink">{item.name}</h3>
      {
        kindLabel && (
          <p class="mt-0.5 text-[10px] uppercase tracking-[0.2em] text-ink-faint">
            {kindLabel}
          </p>
        )
      }
      <div class="mt-1 flex flex-wrap items-center gap-2">
        {
          item.crateOnly ? (
            <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-magenta">
              {exclusiveLabel}
            </span>
          ) : (
            <CoinAmount amount={item.price} class="text-sm text-amber" />
          )
        }
        {rarity && <RarityBadge rarity={rarity} />}
      </div>
    </div>
  </div>
  {
    item.availableUntil && (
      <p class="flex flex-wrap items-center gap-x-2 text-[11px] text-amber">
        <span class="font-bold uppercase tracking-[0.15em]">
          <span aria-hidden="true">⏳ </span>limited
        </span>
        <span>
          until{" "}
          <time datetime={item.availableUntil}>
            {untilFmt.format(new Date(item.availableUntil))}
          </time>{" "}
          · {timeLeftLabel(item.availableUntil)}
        </span>
      </p>
    )
  }
  {
    item.description && (
      <p class="text-xs leading-relaxed text-ink-dim">{item.description}</p>
    )
  }
  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-1">
    <p class="text-[11px] text-ink-faint">{status}</p>
    {
      blocked === "guest" ? (
        <a href={loginHref} class="text-xs text-cyan hover:underline">
          {PURCHASE_BLOCK_LABEL.guest} →
        </a>
      ) : blocked ? (
        <span
          class:list={[
            "text-[11px] font-bold uppercase tracking-widest",
            blocked === "owned" ? "text-acid" : "text-ink-faint",
          ]}
        >
          {PURCHASE_BLOCK_LABEL[blocked]}
        </span>
      ) : (
        <form method="post" action={action}>
          <button type="submit" class={btnPrimary}>
            buy<span class="sr-only"> {item.name}</span>
          </button>
        </form>
      )
    }
  </div>
</article>
