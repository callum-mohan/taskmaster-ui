---
interface Props {
  /** ISO deadline string. */
  deadline: string;
  class?: string;
}

const { deadline, class: className = "" } = Astro.props;

// Server-rendered fallback so the component is not empty before JS runs or if
// JavaScript is disabled. The client script keeps it ticking live.
const diff = Math.max(0, new Date(deadline).getTime() - Date.now());
const totalSeconds = Math.floor(diff / 1000);
const initial = {
  days: Math.floor(totalSeconds / 86400),
  hours: Math.floor((totalSeconds % 86400) / 3600),
  minutes: Math.floor((totalSeconds % 3600) / 60),
  seconds: totalSeconds % 60,
};

// Urgency tiers, mirrored in the client tick below so the no-JS render and
// the live render stay visually consistent.
const HOUR_MS = 3_600_000;
const DAY_MS = 86_400_000;
const urgency: "normal" | "urgent" | "critical" | "done" =
  diff <= 0
    ? "done"
    : diff <= HOUR_MS
      ? "critical"
      : diff <= DAY_MS
        ? "urgent"
        : "normal";

const warnText =
  urgency === "critical"
    ? "> FINAL HOUR"
    : urgency === "urgent"
      ? "> FINAL DAY"
      : "";

const pad = (n: number) => String(n).padStart(2, "0");

const units: { key: keyof typeof initial; label: string }[] = [
  { key: "days", label: "days" },
  { key: "hours", label: "hours" },
  { key: "minutes", label: "mins" },
  { key: "seconds", label: "secs" },
];
---

<div
  class:list={[
    "countdown",
    className,
    urgency === "urgent" && "is-urgent",
    urgency === "critical" && "is-critical",
  ]}
  data-deadline={deadline}
  role="timer"
  aria-label="Time remaining until the deadline"
>
  <div class="grid grid-cols-4 gap-2 sm:gap-3">
    {
      units.map((unit) => (
        <div class="cd-cell rounded-md border border-grid bg-term-bg/70 px-2 py-3 text-center">
          <div
            data-unit={unit.key}
            class="cd-digit text-2xl font-extrabold tabular-nums text-acid text-glow sm:text-4xl"
          >
            {pad(initial[unit.key])}
          </div>
          <div class="mt-1 text-[10px] tracking-[0.2em] text-ink-faint uppercase">
            {unit.label}
          </div>
        </div>
      ))
    }
  </div>
  <p
    data-countdown-warn
    hidden={urgency !== "urgent" && urgency !== "critical"}
    class="cd-warn mt-3 flex items-center justify-center gap-2 text-center text-xs font-bold tracking-[0.3em] uppercase"
  >
    <span aria-hidden="true">&#9888;</span><span data-warn-text>{warnText}</span
    >
  </p>
  <p
    data-countdown-done
    hidden={urgency !== "done"}
    class="mt-3 text-center text-sm font-bold tracking-widest text-amber"
  >
    &gt; TIME'S UP
  </p>
</div>

<script>
  const HOUR_MS = 3_600_000;
  const DAY_MS = 86_400_000;

  function pad(n: number): string {
    return String(n).padStart(2, "0");
  }

  document.querySelectorAll<HTMLElement>(".countdown").forEach((root) => {
    const deadline = new Date(root.dataset.deadline ?? "").getTime();
    if (Number.isNaN(deadline)) return;

    // Only celebrate zero if the timer was actually counting down live, so a
    // page loaded after the deadline doesn't trigger the effect on arrival.
    const startedLive = deadline - Date.now() > 0;
    let firedZero = false;

    const cells = {
      days: root.querySelector<HTMLElement>('[data-unit="days"]'),
      hours: root.querySelector<HTMLElement>('[data-unit="hours"]'),
      minutes: root.querySelector<HTMLElement>('[data-unit="minutes"]'),
      seconds: root.querySelector<HTMLElement>('[data-unit="seconds"]'),
    };
    const doneEl = root.querySelector<HTMLElement>("[data-countdown-done]");
    const warnEl = root.querySelector<HTMLElement>("[data-countdown-warn]");
    const warnText = root.querySelector<HTMLElement>("[data-warn-text]");

    function setWarn(text: string | null) {
      if (!warnEl) return;
      if (text) {
        if (warnText) warnText.textContent = text;
        warnEl.removeAttribute("hidden");
      } else {
        warnEl.setAttribute("hidden", "");
      }
    }

    function tick() {
      const diff = Math.max(0, deadline - Date.now());
      const total = Math.floor(diff / 1000);

      if (cells.days) cells.days.textContent = pad(Math.floor(total / 86400));
      if (cells.hours)
        cells.hours.textContent = pad(Math.floor((total % 86400) / 3600));
      if (cells.minutes)
        cells.minutes.textContent = pad(Math.floor((total % 3600) / 60));
      if (cells.seconds) cells.seconds.textContent = pad(total % 60);

      const critical = diff > 0 && diff <= HOUR_MS;
      const urgent = diff > HOUR_MS && diff <= DAY_MS;
      root.classList.toggle("is-critical", critical);
      root.classList.toggle("is-urgent", urgent);
      setWarn(critical ? "> FINAL HOUR" : urgent ? "> FINAL DAY" : null);

      if (diff <= 0) {
        root.classList.remove("is-urgent", "is-critical");
        setWarn(null);
        doneEl?.removeAttribute("hidden");

        // Easter egg: a one-off glitch + toast the moment the clock dies.
        if (startedLive && !firedZero) {
          firedZero = true;
          root.classList.add("cd-zero-glitch");
          window.setTimeout(
            () => root.classList.remove("cd-zero-glitch"),
            1400,
          );
          (
            window as unknown as {
              __eggToast?: (m: string, t?: string) => void;
            }
          ).__eggToast?.("TIME'S UP — your task is over", "amber");
        }

        clearInterval(timer);
      }
    }

    tick();
    const timer = setInterval(tick, 1000);
  });
</script>
