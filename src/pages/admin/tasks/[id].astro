---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import TaskForm from "../../../components/admin/TaskForm.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import { btnGhost } from "../../../components/admin/styles";
import {
  deleteTask,
  describeWriteError,
  getTask,
  getTaskDeleteImpact,
  updateTask,
} from "../../../data/admin";
import {
  parseTaskForm,
  toDateTimeLocal,
  type FieldErrors,
  type FormValues,
} from "../../../lib/admin-forms";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/admin/login"));

const id = Astro.params.id!;
const task = await getTask(id);
if (!task) return Astro.rewrite("/404");

const weekName = `week ${task.weekNumber}`;
let values: FormValues = {
  id: task.id,
  weekNumber: String(task.weekNumber),
  title: task.title,
  description: task.description,
  briefMode: Array.isArray(task.brief) ? "bullets" : "prose",
  brief: Array.isArray(task.brief) ? task.brief.join("\n") : (task.brief ?? ""),
  releaseDate: toDateTimeLocal(task.releaseDate),
  deadline: toDateTimeLocal(task.deadline),
  format: task.format,
};
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("intent") === "delete") {
    await deleteTask(id);
    const query = new URLSearchParams({ done: "deleted", name: weekName });
    return Astro.redirect(withBase(`/admin/tasks?${query}`));
  }
  form.set("id", id);
  const parsed = parseTaskForm(form);
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    try {
      await updateTask(id, parsed.data);
      const query = new URLSearchParams({
        done: "saved",
        name: `week ${parsed.data.weekNumber}`,
      });
      return Astro.redirect(withBase(`/admin/tasks?${query}`));
    } catch (error) {
      formError = describeWriteError(error);
      if (!formError) throw error;
    }
  }
}

const impact = await getTaskDeleteImpact(id);
---

<AdminLayout title={`Edit ${weekName}`}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href={withBase("/admin/tasks")} class={btnGhost}>&larr; ALL TASKS</a>
    <span class="flex gap-4 text-xs">
      <a
        href={withBase(`/admin/scores/${task.id}`)}
        class="text-acid hover:underline">record scores</a
      >
      <a
        href={withBase(`/tasks/${task.id}`)}
        class="text-cyan hover:underline"
        target="_blank"
        rel="noopener">view public page ↗</a
      >
    </span>
  </div>
  <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> vim ~/tasks/{task.id}.brief
  </h1>
  <TerminalWindow title={`~/tasks/${task.id}.brief`} class="mt-6">
    <TaskForm
      mode="edit"
      values={values}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
  <section aria-labelledby="danger-heading" class="mt-8">
    <h2
      id="danger-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      danger zone
    </h2>
    <ConfirmDelete
      subject={`task "${weekName}: ${task.title}"`}
      impact={impact}
      label="delete task"
    />
  </section>
</AdminLayout>
