---
import SubmissionEntryCard from "./SubmissionEntryCard.astro";
import EntryReactions from "./EntryReactions.astro";
import EntryVote from "./EntryVote.astro";
import type { PublicGalleryGroup } from "../types";

interface Props {
  taskId: string;
  groups: PublicGalleryGroup[];
  /** Formats an ISO timestamp for display (the page owns date formatting). */
  formatStamp: (iso: string) => string;
  class?: string;
}

const { taskId, groups, formatStamp, class: className } = Astro.props;
---

<ul class:list={["grid gap-3 sm:grid-cols-2 lg:grid-cols-3", className]}>
  {
    groups.flatMap((group) =>
      group.entries.map((entry) => (
        <li
          id={`entry-${entry.id}`}
          class="flex min-w-0 scroll-mt-24 flex-col gap-1.5"
        >
          <a
            href={group.owner.href}
            class:list={[
              "truncate text-sm font-extrabold transition-colors hover:text-acid active:text-acid",
              group.owner.type === "team" ? "text-magenta" : "text-ink",
            ]}
          >
            {group.owner.name}
          </a>
          <SubmissionEntryCard
            entry={entry}
            formatStamp={formatStamp}
            showSubmitter={group.owner.type === "team"}
            class={
              entry.social.winner ? "flex-1 ring-1 ring-amber/40" : "flex-1"
            }
          />
          <div class="flex flex-wrap items-center gap-2">
            <EntryReactions
              taskId={taskId}
              entryId={entry.id}
              social={entry.social}
            />
            <EntryVote
              taskId={taskId}
              entryId={entry.id}
              social={entry.social}
              class="ml-auto"
            />
          </div>
        </li>
      )),
    )
  }
</ul>
