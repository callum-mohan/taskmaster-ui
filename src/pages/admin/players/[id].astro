---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import PlayerForm from "../../../components/admin/PlayerForm.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import AdminField from "../../../components/admin/AdminField.astro";
import AccountStatusBadge from "../../../components/admin/AccountStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import {
  btnDanger,
  btnGhost,
  btnPrimary,
  inputClass,
  labelClass,
} from "../../../components/admin/styles";
import {
  addCoinAdjustment,
  deleteCoinAdjustment,
  deletePlayer,
  describeWriteError,
  getPlayer,
  getPlayerDeleteImpact,
  giftItem,
  listCoinAdjustments,
  revokeItemGift,
  updatePlayer,
} from "../../../data/admin";
import CoinAmount from "../../../components/CoinAmount.astro";
import SkillSigil from "../../../components/SkillSigil.astro";
import { SKILL_ACCENT_CLASS } from "../../../lib/skill-ui";
import { ukDateFormat } from "../../../lib/time";
import {
  accountStatus,
  getPlayerAccount,
  setMustChangePassword,
  setPlayerEmail,
} from "../../../data/accounts";
import { resetUserPassword, temporaryPassword } from "../../../lib/auth";
import {
  parseCoinAdjustmentForm,
  parseItemGiftForm,
  parsePlayerEmailForm,
  parsePlayerForm,
  parseRowId,
  type FieldErrors,
  type FormValues,
} from "../../../lib/admin-forms";
import { withBase } from "../../../lib/url";
import { CATEGORY_INFO, POWER_UP_INFO } from "../../../data/coins";
import type { ShopItem } from "../../../types";
import { withSeason } from "../../../lib/admin-season";

// Fail closed if the middleware guard is ever bypassed.
const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(withBase("/login"));

const id = Astro.params.id!;
const player = await getPlayer(id);
if (!player) return Astro.rewrite("/404");
const season = (await Astro.locals.getSeasons()).getSeason(player.seasonId);
const rosterHref = (query = "") =>
  withBase(withSeason(`/admin/roster${query}`, season));

let account = await getPlayerAccount(id);

let values: FormValues = {
  id: player.id,
  name: player.name,
  bio: player.bio ?? "",
  avatarUrl: player.avatarUrl ?? "",
  sortOrder: String(player.sortOrder),
};
let errors: FieldErrors = {};
let formError: string | undefined;
let accountEmail = account?.email ?? "";
let accountError: string | undefined;
// Shown once, in this response only: never put it in a redirect URL.
let resetPassword: { password: string; signedOut: boolean } | undefined;
let coinValues: FormValues = {};
let coinErrors: FieldErrors = {};
const coinsDone = (done: string) =>
  Astro.redirect(withBase(`/admin/players/${id}?done=${done}#coins`));
let itemValues: FormValues = {};
let itemErrors: FieldErrors = {};
let itemError: string | undefined;
const itemsDone = (done: string) =>
  Astro.redirect(withBase(`/admin/players/${id}?done=${done}#items`));

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  if (intent === "delete") {
    await deletePlayer(id);
    const query = new URLSearchParams({ done: "deleted", name: player.name });
    return Astro.redirect(rosterHref(`?${query}`));
  }
  if (intent === "coins-grant") {
    const parsed = parseCoinAdjustmentForm(form);
    coinValues = parsed.values;
    if (!parsed.ok) {
      coinErrors = parsed.errors;
    } else {
      await addCoinAdjustment(id, parsed.data, admin);
      return coinsDone("coins");
    }
  } else if (intent === "coins-delete") {
    const rowId = parseRowId(form);
    if (rowId !== undefined) await deleteCoinAdjustment(id, rowId);
    return coinsDone("coins-deleted");
  } else if (intent === "item-gift") {
    const parsed = parseItemGiftForm(form);
    itemValues = parsed.values;
    if (!parsed.ok) {
      itemErrors = parsed.errors;
    } else if (await giftItem(id, parsed.data, admin)) {
      return itemsDone("item-gifted");
    } else {
      itemErrors = {
        itemId:
          "They already own that item (or have had that power-up this season), or it no longer exists.",
      };
    }
  } else if (intent === "item-revoke") {
    const rowId = parseRowId(form);
    const { getItemGifts } = await Astro.locals.getQueries(player.seasonId);
    const gift = getItemGifts(id).find((g) => g.gift.id === rowId);
    if (rowId === undefined || !gift) return itemsDone("item-revoked");
    // A spent passive charge (a Shield, Mirror or Insurance that's already
    // paid out) has no stored use to protect it, so check the snapshot too.
    if (gift.spent || !(await revokeItemGift(id, rowId))) {
      itemError = `${gift.item.name} has already been used, so it can't be taken back. Revoke the use in that week's judge tab first.`;
    } else {
      return itemsDone("item-revoked");
    }
  } else if (intent === "reset-password") {
    if (!account?.userId) {
      accountError = "This player has no sign-in account to reset yet.";
    } else {
      // Flag the account first so the player can never sign in with the
      // temporary password without being made to replace it.
      const previous = account.mustChangePassword;
      await setMustChangePassword(id, true);
      const password = temporaryPassword();
      const result = await resetUserPassword(Astro, account.userId, password);
      if (result.ok) {
        resetPassword = { password, signedOut: result.signedOut };
      } else {
        if (!previous) await setMustChangePassword(id, false);
        accountError = result.message;
      }
      account = await getPlayerAccount(id);
    }
  } else if (intent === "account") {
    const parsed = parsePlayerEmailForm(form);
    accountEmail = parsed.values.email ?? "";
    if (!parsed.ok) {
      accountError = parsed.errors.email;
    } else {
      try {
        const saved = await setPlayerEmail(id, parsed.data.email);
        if (saved) {
          return Astro.redirect(
            withBase(`/admin/players/${id}?done=account#account`),
          );
        }
        accountError =
          "This player already has an account; reset it with the script below.";
        account = await getPlayerAccount(id);
      } catch (error) {
        accountError = describeWriteError(error);
        if (!accountError) throw error;
      }
    }
  } else {
    // The id is immutable; ignore whatever was posted for it.
    form.set("id", id);
    const parsed = parsePlayerForm(form);
    values = parsed.values;
    if (!parsed.ok) {
      errors = parsed.errors;
    } else {
      try {
        await updatePlayer(id, parsed.data);
        const query = new URLSearchParams({
          done: "saved",
          name: parsed.data.name,
        });
        return Astro.redirect(rosterHref(`?${query}`));
      } catch (error) {
        formError = describeWriteError(error);
        if (!formError) throw error;
      }
    }
  }
}

const [
  impact,
  adjustments,
  { getWallet, getInventory, getGiftableItems, getItemGifts, getSkillLog },
] = await Promise.all([
  getPlayerDeleteImpact(id),
  listCoinAdjustments(id),
  Astro.locals.getQueries(player.seasonId),
]);
const wallet = getWallet(id);
const inventory = getInventory(id);
const giftable = getGiftableItems(id);
const itemGifts = getItemGifts(id);
const skillLog = getSkillLog(id);
const skillDateFmt = ukDateFormat({ day: "numeric", month: "short" });
/** Extra context for an item in the gift picker. */
const itemTags = (item: ShopItem) =>
  [
    item.powerUp && POWER_UP_INFO[item.powerUp].passive ? "passive" : "",
    !item.available ? "retired" : "",
    item.crateOnly ? "egg exclusive" : "",
    item.skillOnly ? "skill reward" : "",
  ].filter(Boolean);
const itemNotice = {
  "item-gifted": "Item gifted. The player has been notified.",
  "item-revoked": "Gifted item taken back.",
}[Astro.url.searchParams.get("done") ?? ""];
const coinNotice = {
  coins: "Clim Coin adjustment saved.",
  "coins-deleted": "Clim Coin adjustment removed.",
}[Astro.url.searchParams.get("done") ?? ""];
const status = accountStatus(account);
const linked = Boolean(account?.userId);
const accountSaved = Astro.url.searchParams.get("done") === "account";
const emailCommand = `npm run players:accounts -- --reset ${player.id} --email new@example.com`;
const statusHelp: Record<typeof status, string> = {
  none: "Add the player's email to invite them, then run the provisioning script.",
  invited:
    "Waiting for an account. Run the script below to create it with a temporary password.",
  pending:
    "The player must replace their temporary password at their next sign-in.",
  active: "The player has signed in and set their own password.",
};
---

<AdminLayout title={`Edit ${player.name}`}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href={rosterHref()} class={btnGhost}>&larr; ROSTER</a>
    <div class="flex flex-wrap items-center gap-4">
      <a
        href={withBase(
          withSeason(
            `/admin/activity?${new URLSearchParams({ who: player.id })}`,
            season,
          ),
        )}
        class="text-xs text-cyan hover:underline">activity log →</a
      >
      <a
        href={withBase(`/players/${player.id}`)}
        class="text-xs text-cyan hover:underline"
        target="_blank"
        rel="noopener">view public profile ↗</a
      >
    </div>
  </div>
  <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> vim ~/players/{player.id}.md
  </h1>
  <TerminalWindow title={`~/players/${player.id}.md`} class="mt-6">
    <PlayerForm
      mode="edit"
      values={values}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
  <section id="account" aria-labelledby="account-heading" class="mt-8">
    <h2
      id="account-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      sign-in account
    </h2>
    <TerminalWindow title={`~/players/${player.id}/account`}>
      {
        accountSaved && !accountError && (
          <Notice tone="success" class="mb-5">
            Account email saved.
          </Notice>
        )
      }
      <div class="flex flex-wrap items-center gap-3">
        <AccountStatusBadge status={status} />
        <p class="text-sm text-ink-dim">{statusHelp[status]}</p>
      </div>
      {
        resetPassword && (
          <Notice tone="success" class="mt-5">
            Password reset
            {resetPassword.signedOut
              ? " and the player was signed out everywhere."
              : ", but their existing sessions couldn't be signed out."}
            <span class="mt-3 block text-ink">
              temporary password:{" "}
              <code class="select-all rounded border border-grid bg-term-bg px-2 py-1 text-acid">
                {resetPassword.password}
              </code>
            </span>
            <span class="mt-3 block text-ink-dim">
              Send it to the player privately; it won't be shown again. They
              sign in at /login and must choose a new password.
            </span>
          </Notice>
        )
      }
      {
        linked ? (
          <div class="mt-5 space-y-3 text-sm">
            <p class="text-ink">
              <span class="text-ink-faint">email:</span> {account?.email}
            </p>
            <details class="group">
              <summary
                class:list={[
                  btnGhost,
                  "cursor-pointer list-none hover:border-danger/60 hover:text-danger",
                ]}
              >
                reset password
              </summary>
              <div class="mt-3 space-y-3 rounded-md border border-danger/50 bg-danger/5 p-4">
                <p class="text-ink-dim">
                  Issue a new temporary password for {player.name}? Their
                  current password stops working, they're signed out everywhere,
                  and they must choose a new password when they next sign in.
                </p>
                <form method="post">
                  <input type="hidden" name="intent" value="reset-password" />
                  <button type="submit" class={btnDanger}>
                    confirm reset
                  </button>
                </form>
              </div>
            </details>
            <p class="text-ink-dim">
              To change the email, run (this also issues a new temporary
              password):
            </p>
            <p class="overflow-x-auto whitespace-nowrap rounded-md border border-grid bg-term-bg px-3 py-2 text-xs text-ink">
              <span class="text-acid" aria-hidden="true">
                ${" "}
              </span>
              <code>{emailCommand}</code>
            </p>
          </div>
        ) : (
          <form method="post" class="mt-5 space-y-4" novalidate>
            <input type="hidden" name="intent" value="account" />
            <AdminField
              label="email"
              name="email"
              type="email"
              value={accountEmail}
              error={accountError}
              autocomplete="off"
              hint="Private: used only for sign-in. Leave blank to withdraw the invite."
            />
            <button type="submit" class={btnPrimary}>
              save email
            </button>
            {status === "invited" && (
              <p class="text-xs text-ink-faint">
                Then run <code class="text-ink">npm run players:accounts</code>{" "}
                to create the account.
              </p>
            )}
          </form>
        )
      }
      {
        linked && accountError && (
          <Notice tone="error" class="mt-5">
            {accountError}
          </Notice>
        )
      }
    </TerminalWindow>
  </section>
  <section id="coins" aria-labelledby="coins-heading" class="mt-8">
    <h2
      id="coins-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      clim coin
    </h2>
    <TerminalWindow title={`~/players/${player.id}/wallet`}>
      {
        coinNotice && (
          <Notice tone="success" class="mb-5">
            {coinNotice}
          </Notice>
        )
      }
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <CoinAmount
          amount={wallet.balance}
          class:list={[
            "text-3xl",
            wallet.balance < 0 ? "text-danger" : "text-amber",
          ]}
        />
        <p class="text-xs text-ink-faint">
          earned {wallet.earned} · grants {wallet.adjusted} · spent {
            wallet.spent
          }
        </p>
      </div>
      <p class="mt-2 text-xs text-ink-faint">
        Earnings are worked out from results and activity (held results count
        here, but not in the player's own wallet until they're published).
      </p>
      <form
        method="post"
        class="mt-5 grid gap-4 sm:grid-cols-[8rem_1fr_auto] sm:items-start"
        novalidate
      >
        <input type="hidden" name="intent" value="coins-grant" />
        <AdminField
          label="amount"
          name="amount"
          type="number"
          value={coinValues.amount}
          error={coinErrors.amount}
          required
          hint="Negative deducts."
        />
        <AdminField
          label="reason"
          name="reason"
          value={coinValues.reason}
          error={coinErrors.reason}
          required
          hint="Shown in the player's wallet."
        />
        <button type="submit" class:list={[btnPrimary, "sm:mt-6"]}>
          grant / deduct
        </button>
      </form>
      {
        adjustments.length > 0 && (
          <ul class="mt-5 divide-y divide-grid/60 rounded-md border border-grid text-sm">
            {adjustments.map((row) => (
              <li class="flex flex-wrap items-center justify-between gap-3 px-3 py-2">
                <span class="min-w-0 text-ink-dim">
                  {row.reason}
                  <span class="block text-[11px] text-ink-faint">
                    by {row.actorName}
                  </span>
                </span>
                <span class="flex items-center gap-3">
                  <CoinAmount
                    amount={row.amount}
                    signed
                    class:list={[row.amount < 0 ? "text-danger" : "text-amber"]}
                  />
                  <ConfirmDelete
                    subject={`the ${row.amount > 0 ? "grant" : "deduction"} "${row.reason}"`}
                    intent="coins-delete"
                    fields={{ rowId: row.id }}
                    label="remove"
                  />
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </TerminalWindow>
  </section>
  <section
    id="skills"
    aria-labelledby="skills-heading"
    class="mt-8 scroll-mt-24"
  >
    <h2
      id="skills-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      skill tree
    </h2>
    <TerminalWindow title={`~/players/${player.id}/skills`}>
      {
        skillLog.path ? (
          <>
            <p
              class:list={[
                "inline-flex items-center gap-2 text-sm font-bold",
                SKILL_ACCENT_CLASS[skillLog.path.accent].text,
              ]}
            >
              <SkillSigil pathId={skillLog.path.id} class="h-4 w-4" />
              {skillLog.path.name}
              <span class="font-normal text-ink-faint">
                · {skillLog.unlocks.length}/{skillLog.path.nodes.length} skills
              </span>
            </p>
            <ul class="mt-4 divide-y divide-grid/60 rounded-md border border-grid text-sm">
              {skillLog.unlocks.map((u) => (
                <li class="flex flex-wrap items-center justify-between gap-3 px-3 py-2">
                  <span class="min-w-0 text-ink-dim">
                    {u.node.name}
                    <span class="block text-[11px] text-ink-faint">
                      tier {u.node.tier} · {skillDateFmt.format(new Date(u.at))}
                    </span>
                  </span>
                  <CoinAmount amount={-u.price} class="text-danger" />
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="text-sm text-ink-dim">
            No pathway yet. Players pick one themselves on /skills.
          </p>
        )
      }
      <p class="mt-3 text-xs text-ink-faint">
        Pathways are final for the season. Rewards they unlocked show in the
        inventory below.
      </p>
    </TerminalWindow>
  </section>
  <section id="items" aria-labelledby="items-heading" class="mt-8 scroll-mt-24">
    <h2
      id="items-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      gift items &amp; power-ups
    </h2>
    <TerminalWindow title={`~/players/${player.id}/inventory`}>
      {
        itemNotice && !itemError && (
          <Notice tone="success" class="mb-5">
            {itemNotice}
          </Notice>
        )
      }
      {
        itemError && (
          <Notice tone="error" class="mb-5">
            {itemError}
          </Notice>
        )
      }
      <p class="text-xs text-ink-faint">
        <span class="text-acid" aria-hidden="true">$</span> ls ./inventory
      </p>
      {
        inventory.length === 0 ? (
          <p class="mt-2 text-sm text-ink-dim">
            {player.name} doesn't own anything yet.
          </p>
        ) : (
          <ul class="mt-2 flex flex-wrap gap-2 text-xs">
            {inventory.map(({ item, equipped, charges }) => (
              <li class="rounded-md border border-grid bg-term-bg px-2 py-1 text-ink-dim">
                <span class="text-ink">{item.name}</span>{" "}
                <span class="text-ink-faint">
                  · {CATEGORY_INFO[item.category].label.toLowerCase()}
                  {equipped && " · worn"}
                  {charges > 0 && ` · ${charges} unused`}
                </span>
              </li>
            ))}
          </ul>
        )
      }
      {
        giftable.length === 0 ? (
          <p class="mt-5 text-sm text-ink-dim">
            {player.name} already owns everything in the shop.
          </p>
        ) : (
          <form
            method="post"
            class="mt-5 grid gap-4 sm:grid-cols-[minmax(0,16rem)_1fr_auto] sm:items-start"
            novalidate
          >
            <input type="hidden" name="intent" value="item-gift" />
            <div class="space-y-1.5">
              <label for="field-itemId" class={labelClass}>
                item
                <span class="text-acid" aria-hidden="true">
                  {" "}
                  *
                </span>
              </label>
              <select
                id="field-itemId"
                name="itemId"
                required
                aria-invalid={itemErrors.itemId ? "true" : undefined}
                aria-describedby={
                  itemErrors.itemId ? "field-itemId-error" : "field-itemId-hint"
                }
                class={inputClass(Boolean(itemErrors.itemId))}
              >
                <option value="" selected={!itemValues.itemId}>
                  choose an item
                </option>
                {giftable.map((group) => (
                  <optgroup label={group.label}>
                    {group.items.map((item) => {
                      const tags = itemTags(item);
                      return (
                        <option
                          value={item.id}
                          selected={itemValues.itemId === item.id}
                        >
                          {item.name} ({item.price}c
                          {tags.length > 0 && `, ${tags.join(", ")}`})
                        </option>
                      );
                    })}
                  </optgroup>
                ))}
              </select>
              {itemErrors.itemId ? (
                <p id="field-itemId-error" class="text-xs text-danger">
                  {itemErrors.itemId}
                </p>
              ) : (
                <p id="field-itemId-hint" class="text-xs text-ink-faint">
                  Anything they don't own yet, retired and egg-exclusive items
                  too. Free for them.
                </p>
              )}
            </div>
            <AdminField
              label="reason"
              name="giftReason"
              value={itemValues.giftReason}
              error={itemErrors.reason}
              required
              hint="Shown in the player's notification and wallet history."
            />
            <button type="submit" class:list={[btnPrimary, "sm:mt-6"]}>
              gift item
            </button>
          </form>
        )
      }
      {
        itemGifts.length > 0 && (
          <ul class="mt-5 divide-y divide-grid/60 rounded-md border border-grid text-sm">
            {itemGifts.map(({ gift, item, spent }) => (
              <li class="flex flex-wrap items-center justify-between gap-3 px-3 py-2">
                <span class="min-w-0 text-ink-dim">
                  <span class="text-ink">{item.name}</span>
                  <span class="text-ink-faint">
                    {" "}
                    · {CATEGORY_INFO[item.category].label.toLowerCase()}
                  </span>
                  <span class="block">{gift.reason}</span>
                  <span class="block text-[11px] text-ink-faint">
                    by {gift.actorName}
                  </span>
                </span>
                {spent ? (
                  <span class="text-[11px] font-bold uppercase tracking-widest text-ink-faint">
                    used
                  </span>
                ) : (
                  <ConfirmDelete
                    subject={`the gifted ${item.name} from ${player.name}'s inventory`}
                    intent="item-revoke"
                    fields={{ rowId: gift.id }}
                    label="take back"
                  />
                )}
              </li>
            ))}
          </ul>
        )
      }
    </TerminalWindow>
  </section>
  <section aria-labelledby="danger-heading" class="mt-8">
    <h2
      id="danger-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      danger zone
    </h2>
    <ConfirmDelete
      subject={`player "${player.name}"`}
      impact={impact}
      label="delete player"
    />
  </section>
</AdminLayout>
