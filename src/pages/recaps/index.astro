---
import Layout from "../../layouts/Layout.astro";
import { withBase } from "../../lib/url";

const { getRecapSummaries, tasks } = await Astro.locals.getQueries();

const recaps = getRecapSummaries();

// The week currently in progress has no recap yet — tease it at the top.
const liveTask = tasks.find((t) => t.status === "live");
const liveNamed =
  liveTask && liveTask.title.length > 0 && liveTask.title !== "???";
---

<Layout
  title="Recaps"
  description="Weekly episode recaps — the winner, the biggest climber, the funniest moment and how the title race swung, week by week."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Page header -->
    <header>
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        ls ~/recaps
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        THE <span class="text-magenta text-glow-magenta">RECAPS</span>
      </h1>
      <p
        class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim sm:text-base"
      >
        <span class="text-acid">// </span>
        Every completed week, recapped like an episode — who won, who climbed, how
        the race swung, and the moment that got everyone talking.
      </p>
    </header>

    <!-- Now-airing teaser -->
    {
      liveTask && (
        <a
          href={withBase(`/tasks/${liveTask.id}`)}
          class="group mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-amber/40 bg-amber/5 px-4 py-3 transition-colors hover:border-amber"
        >
          <span class="flex items-center gap-2 text-[11px] font-bold tracking-widest text-amber uppercase">
            <span
              class="live-dot h-1.5 w-1.5 rounded-full bg-amber"
              aria-hidden="true"
            />
            Now airing
          </span>
          <span class="text-sm text-ink-dim">
            Week {String(liveTask.weekNumber).padStart(2, "0")}
            {liveNamed && (
              <>
                {" "}
                · <span class="font-bold text-ink">{liveTask.title}</span>
              </>
            )}{" "}
            is still live — its recap lands once the deadline passes.
          </span>
          <span
            class="ml-auto text-xs font-bold tracking-widest text-amber uppercase group-hover:text-ink"
            aria-hidden="true"
          >
            view task &rarr;
          </span>
        </a>
      )
    }

    <!-- Recap grid -->
    {
      recaps.length > 0 ? (
        <section class="mt-10">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            recaps --all
          </h2>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {recaps.map((recap) => (
              <li>
                <a
                  href={withBase(`/recaps/${recap.task.id}`)}
                  class="group flex h-full flex-col rounded-xl border border-grid bg-term-panel p-5 transition-colors hover:border-magenta/50"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold tracking-[0.3em] text-magenta">
                      EP {String(recap.episodeNumber).padStart(2, "0")}
                    </span>
                    <span class="text-[10px] tracking-widest text-ink-faint uppercase">
                      {recap.weekLabel}
                    </span>
                  </div>

                  <h3 class="mt-3 text-lg font-extrabold leading-snug text-ink group-hover:text-acid">
                    {recap.headline}
                  </h3>

                  <dl class="mt-4 space-y-2 text-sm">
                    <div class="flex items-center justify-between gap-3">
                      <dt class="flex items-center gap-1.5 text-ink-faint">
                        <span aria-hidden="true">🥇</span>
                        <span class="text-[11px] tracking-widest uppercase">
                          winner
                        </span>
                      </dt>
                      <dd class="min-w-0 truncate font-semibold text-ink">
                        {recap.winner ? recap.winner.name : "—"}
                        {recap.winningScore !== undefined && (
                          <span class="text-ink-faint">
                            {" "}
                            · {recap.winningScore} pts
                          </span>
                        )}
                      </dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                      <dt class="flex items-center gap-1.5 text-ink-faint">
                        <span class="text-acid" aria-hidden="true">
                          ▲
                        </span>
                        <span class="text-[11px] tracking-widest uppercase">
                          climber
                        </span>
                      </dt>
                      <dd class="min-w-0 truncate font-semibold text-ink">
                        {recap.biggestClimber ? (
                          <>
                            {recap.biggestClimber.player.name}
                            <span class="text-acid">
                              {" "}
                              ▲{recap.biggestClimber.places}
                            </span>
                          </>
                        ) : (
                          "—"
                        )}
                      </dd>
                    </div>
                  </dl>

                  <span class="mt-5 inline-flex items-center gap-2 text-[11px] font-bold tracking-widest text-ink-faint uppercase group-hover:text-magenta">
                    read recap <span aria-hidden="true">&rarr;</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <div class="mt-10 rounded-xl border border-grid bg-term-panel p-8 text-center">
          <p class="text-sm text-ink-dim">
            <span class="text-acid">$</span> ls ~/recaps
          </p>
          <p class="mt-2 text-sm text-ink-faint">
            No episodes yet — the first recap airs once week one is scored.
          </p>
        </div>
      )
    }
  </div>
</Layout>
