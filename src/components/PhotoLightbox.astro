---
// Full-size photo viewer for entry galleries. Render it once per page; it
// enhances every `a[data-lightbox-item]` (see `SubmissionEntryCard`'s
// `lightboxGroup`), paging through links that share a group. Arrow keys or a
// swipe move between photos, Esc or the backdrop closes. Without JS the
// links simply open the full-size image.

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const navBtn =
  "inline-flex items-center gap-1.5 rounded-md border border-grid px-3 py-1.5 text-[11px] font-bold tracking-widest text-ink-dim uppercase transition-colors hover:border-acid hover:text-acid disabled:pointer-events-none disabled:opacity-30";
---

<dialog
  class:list={[
    "m-auto h-fit max-h-[96dvh] w-[min(96vw,72rem)] max-w-none overflow-hidden rounded-xl border border-grid bg-term-panel p-0 text-ink shadow-[0_0_60px_-20px] shadow-acid/30 backdrop:bg-term-bg/90",
    className,
  ]}
  aria-labelledby="lightbox-title"
  data-lightbox
>
  <div
    class="flex items-center gap-3 border-b border-grid bg-term-panel-2 px-4 py-2"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-dot-red"></span>
      <span class="h-3 w-3 rounded-full bg-dot-amber"></span>
      <span class="h-3 w-3 rounded-full bg-dot-green"></span>
    </span>
    <h2
      id="lightbox-title"
      class="min-w-0 flex-1 truncate text-xs text-ink-faint"
      data-lightbox-title
    >
      ~/gallery
    </h2>
    <button
      type="button"
      class="rounded border border-grid px-2 py-0.5 text-[10px] font-bold tracking-widest text-ink-dim uppercase transition-colors hover:border-danger hover:text-danger"
      data-lightbox-close
    >
      <span aria-hidden="true">[esc]</span> close
      <span class="sr-only">photo viewer</span>
    </button>
  </div>

  <figure class="flex flex-col">
    <div
      class="skeleton relative flex min-h-[40dvh] touch-pan-y items-center justify-center bg-term-bg select-none"
      data-lightbox-stage
    >
      <img
        alt=""
        class="max-h-[calc(96dvh-9.5rem)] w-auto max-w-full object-contain"
        data-lightbox-image
      />
    </div>
    <figcaption
      class="border-t border-grid-soft px-4 py-2 text-sm text-ink-dim"
    >
      <span class="text-[11px] text-ink-faint">
        by <span class="text-ink-dim" data-lightbox-credit></span>
      </span>
      <p class="mt-1 whitespace-pre-line break-words" data-lightbox-caption></p>
    </figcaption>
  </figure>

  <div class="flex flex-wrap items-center gap-2 border-t border-grid px-4 py-2">
    <button type="button" class={navBtn} data-lightbox-prev>
      <span aria-hidden="true">&larr;</span> prev
      <span class="sr-only">photo</span>
    </button>
    <span
      class="text-[11px] text-ink-faint tabular-nums"
      aria-live="polite"
      data-lightbox-counter></span>
    <button type="button" class={navBtn} data-lightbox-next>
      next <span class="sr-only">photo</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
    <button
      type="button"
      class="ml-auto text-[11px] text-cyan hover:underline"
      data-lightbox-original
    >
      open original <span aria-hidden="true">&nearr;</span>
      <span class="sr-only">in a new tab</span>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "dialog[data-lightbox]",
  );
  const q = <T extends HTMLElement>(selector: string) =>
    dialog?.querySelector<T>(selector) ?? null;
  const image = q<HTMLImageElement>("[data-lightbox-image]");
  const stage = q<HTMLElement>("[data-lightbox-stage]");
  const title = q<HTMLElement>("[data-lightbox-title]");
  const credit = q<HTMLElement>("[data-lightbox-credit]");
  const caption = q<HTMLElement>("[data-lightbox-caption]");
  const counter = q<HTMLElement>("[data-lightbox-counter]");
  const original = q<HTMLButtonElement>("[data-lightbox-original]");
  const prev = q<HTMLButtonElement>("[data-lightbox-prev]");
  const next = q<HTMLButtonElement>("[data-lightbox-next]");
  const close = q<HTMLButtonElement>("[data-lightbox-close]");

  if (
    dialog &&
    typeof dialog.showModal === "function" &&
    image &&
    stage &&
    title &&
    credit &&
    caption &&
    counter &&
    original &&
    prev &&
    next &&
    close
  ) {
    let items: HTMLAnchorElement[] = [];
    let index = 0;
    let opener: HTMLAnchorElement | undefined;

    const groupOf = (link: HTMLAnchorElement) =>
      [
        ...document.querySelectorAll<HTMLAnchorElement>(
          "a[data-lightbox-item]",
        ),
      ].filter((a) => a.dataset.lightboxItem === link.dataset.lightboxItem);

    const preload = (link?: HTMLAnchorElement) => {
      if (link) new Image().src = link.href;
    };

    const show = (i: number) => {
      index = Math.max(0, Math.min(items.length - 1, i));
      const link = items[index];
      const thumb = link.querySelector("img");
      stage.setAttribute("data-skeleton", "");
      image.src = link.href;
      image.alt = thumb?.alt ?? "";
      credit.textContent = link.dataset.lightboxCredit ?? "";
      caption.textContent = link.dataset.lightboxCaption ?? "";
      caption.hidden = !link.dataset.lightboxCaption;
      title.textContent = `~/gallery/entry-${index + 1}-of-${items.length}`;
      counter.textContent = `${index + 1} / ${items.length}`;
      prev.disabled = index === 0;
      next.disabled = index === items.length - 1;
      preload(items[index - 1]);
      preload(items[index + 1]);
    };

    document.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
        "a[data-lightbox-item]",
      );
      if (!link || !link.dataset.lightboxItem) return;
      event.preventDefault();
      opener = link;
      items = groupOf(link);
      show(items.indexOf(link));
      dialog.showModal();
      document.documentElement.style.overflow = "hidden";
    });

    const loaded = () => stage.removeAttribute("data-skeleton");
    image.addEventListener("load", loaded);
    image.addEventListener("error", loaded);

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      image.removeAttribute("src");
      opener?.focus();
    });
    close.addEventListener("click", () => dialog.close());
    original.addEventListener("click", () => {
      window.open(items[index].href, "_blank", "noopener");
    });
    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (event) => {
      // Handled here too, as not every browser closes a dialog on Esc.
      if (event.key === "Escape") dialog.close();
      else if (event.key === "ArrowLeft") show(index - 1);
      else if (event.key === "ArrowRight") show(index + 1);
      else return;
      event.preventDefault();
    });

    let startX = 0;
    let startY = 0;
    stage.addEventListener("pointerdown", (event) => {
      startX = event.clientX;
      startY = event.clientY;
    });
    stage.addEventListener("pointerup", (event) => {
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        show(dx < 0 ? index + 1 : index - 1);
      }
    });
  }
</script>
