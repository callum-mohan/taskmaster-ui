---
import type { TaskStatus } from "../types";

interface Props {
  status: TaskStatus;
  /** A live task whose brief is still encrypted behind a reveal password. */
  locked?: boolean;
  class?: string;
}

const { status, locked = false, class: className = "" } = Astro.props;

const config: Record<
  TaskStatus,
  { label: string; classes: string; live?: boolean }
> = {
  live: {
    label: "LIVE",
    classes: "border-amber/50 bg-amber/10 text-amber",
    live: true,
  },
  completed: {
    label: "COMPLETED",
    classes: "border-acid-dim bg-acid/10 text-acid",
  },
  upcoming: {
    label: "LOCKED",
    classes: "border-grid bg-term-panel-2 text-ink-faint",
  },
};

const { label: baseLabel, classes, live } = config[status];
const label =
  locked && status === "live" ? `${baseLabel} · ENCRYPTED` : baseLabel;
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded border px-2 py-0.5 text-[10px] font-bold tracking-[0.2em]",
    classes,
    className,
  ]}
>
  {
    live ? (
      <span
        class="live-dot h-1.5 w-1.5 rounded-full bg-amber"
        aria-hidden="true"
      />
    ) : (
      <span class="text-ink-faint" aria-hidden="true">
        ●
      </span>
    )
  }
  {label}
</span>
