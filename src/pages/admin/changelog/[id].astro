---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import ChangelogForm from "../../../components/admin/ChangelogForm.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import { btnGhost } from "../../../components/admin/styles";
import {
  deleteChangelogEntry,
  describeWriteError,
  getChangelogEntry,
  updateChangelogEntry,
} from "../../../data/admin";
import {
  parseChangelogForm,
  type FieldErrors,
  type FormValues,
} from "../../../lib/admin-forms";
import { withBase } from "../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

const id = Astro.params.id!;
const entry = await getChangelogEntry(id);
if (!entry) return Astro.rewrite("/404");

let values: FormValues = {
  id: entry.id,
  date: entry.date,
  title: entry.title,
  description: entry.description,
  category: entry.category,
};
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("intent") === "delete") {
    await deleteChangelogEntry(id);
    const query = new URLSearchParams({ done: "deleted", name: entry.title });
    return Astro.redirect(withBase(`/admin/changelog?${query}`));
  }
  form.set("id", id);
  const parsed = parseChangelogForm(form);
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    try {
      await updateChangelogEntry(id, parsed.data);
      const query = new URLSearchParams({
        done: "saved",
        name: parsed.data.title,
      });
      return Astro.redirect(withBase(`/admin/changelog?${query}`));
    } catch (error) {
      formError = describeWriteError(error);
      if (!formError) throw error;
    }
  }
}
---

<AdminLayout title={`Edit "${entry.title}"`}>
  <a href={withBase("/admin/changelog")} class={btnGhost}>&larr; CHANGELOG</a>
  <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> git commit --amend
  </h1>
  <TerminalWindow title={`~/changelog/${entry.id}.md`} class="mt-6">
    <ChangelogForm
      mode="edit"
      values={values}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
  <section aria-labelledby="danger-heading" class="mt-8">
    <h2
      id="danger-heading"
      class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      danger zone
    </h2>
    <ConfirmDelete subject={`entry "${entry.title}"`} label="delete entry" />
  </section>
</AdminLayout>
