---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../components/TerminalWindow.astro";
import PollStatusBadge from "../../../components/PollStatusBadge.astro";
import Notice from "../../../components/admin/Notice.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  btnGhost,
  btnPrimary,
  tableCell,
  tableHead,
} from "../../../components/admin/styles";
import {
  listChangelog,
  listFeatureFlags,
  listMiniTasks,
  listShopItems,
  setFeatureFlag,
} from "../../../data/admin";
import { deriveMiniTaskStatus, ukToday } from "../../../data/mini-tasks";
import CoinAmount from "../../../components/CoinAmount.astro";
import type { MiniTaskStatus } from "../../../types";
import { FEATURE_FLAGS } from "../../../data/feature-flags";
import { parseFeatureFlagForm } from "../../../lib/admin-forms";
import {
  CATEGORY_INFO,
  POWER_UP_INFO,
  COSMETIC_KIND_LABELS,
} from "../../../data/coins";
import { withBase } from "../../../lib/url";
import { ukDateFormat } from "../../../lib/time";
import {
  LIST_PAGE_SIZE,
  pageHref,
  paginate,
  parsePage,
} from "../../../lib/pagination";

// Fail closed if the middleware guard is ever bypassed.
const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(withBase("/login"));

// The only form posted here: a feature flag toggle.
if (Astro.request.method === "POST") {
  const toggle = parseFeatureFlagForm(await Astro.request.formData());
  if (!toggle) return Astro.redirect(withBase("/admin/site#flags"), 303);
  await setFeatureFlag(toggle.key, toggle.enabled, admin);
  const query = new URLSearchParams({
    done: toggle.enabled ? "flag-on" : "flag-off",
    name: FEATURE_FLAGS[toggle.key].label,
  });
  return Astro.redirect(withBase(`/admin/site?${query}#flags`), 303);
}

// Mini-tasks belong to a season: this screen lists the current one's.
const currentSeason = (await Astro.locals.getSeasons()).current;
const [{ getPollSummaries, players }, changelog, shop, flags, miniTasks] =
  await Promise.all([
    Astro.locals.getQueries(),
    listChangelog(),
    listShopItems(),
    listFeatureFlags(),
    currentSeason ? listMiniTasks(currentSeason.id) : Promise.resolve([]),
  ]);
const today = ukToday();
const miniTaskPage = paginate(
  miniTasks,
  parsePage(Astro.url.searchParams.get("minitasks")),
  LIST_PAGE_SIZE,
);
const miniTaskHref = (page: number) =>
  pageHref(Astro.url, "minitasks", page, {
    hash: "mini-tasks",
    drop: ["done", "name"],
  });
const miniTaskState: Record<MiniTaskStatus, { label: string; class: string }> =
  {
    active: { label: "● RUNNING", class: "text-amber" },
    upcoming: { label: "UPCOMING", class: "text-ink-faint" },
    ended: { label: "✓ ENDED", class: "text-acid" },
  };
const summaries = getPollSummaries();
const changelogPage = paginate(
  changelog,
  parsePage(Astro.url.searchParams.get("changelog")),
  LIST_PAGE_SIZE,
);
const changelogHref = (page: number) =>
  pageHref(Astro.url, "changelog", page, {
    hash: "changelog",
    drop: ["done", "name"],
  });
const categoryClass: Record<string, string> = {
  new: "text-acid",
  improved: "text-cyan",
  fixed: "text-amber",
};
const shopPage = paginate(
  shop,
  parsePage(Astro.url.searchParams.get("shop")),
  LIST_PAGE_SIZE,
);
const shopHref = (page: number) =>
  pageHref(Astro.url, "shop", page, { hash: "shop", drop: ["done", "name"] });
const itemKind = (item: (typeof shop)[number]) =>
  item.powerUp
    ? POWER_UP_INFO[item.powerUp].label
    : item.cosmeticKind
      ? `${COSMETIC_KIND_LABELS[item.cosmeticKind]}: ${item.cosmeticValue}`
      : CATEGORY_INFO[item.category].label;
const done = Astro.url.searchParams.get("done");
const subject = Astro.url.searchParams.get("name");

const stamp = ukDateFormat({
  day: "2-digit",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const fmt = (iso: string) => stamp.format(new Date(iso));
---

<AdminLayout title="Polls, mini-tasks, changelog & shop">
  <h1 class="text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> ls ~/site
  </h1>
  <p class="mt-1 max-w-prose text-sm text-ink-dim">
    The extras around the competition: feature flags, polls for players to vote
    on, mini-tasks, the "what's new" list, and the Clim Coin shop.
  </p>

  {
    done && subject && (
      <Notice tone="success" class="mt-6">
        {done === "deleted"
          ? `Deleted "${subject}".`
          : done === "flag-on"
            ? `Turned on "${subject}".`
            : done === "flag-off"
              ? `Turned off "${subject}".`
              : `Saved "${subject}".`}
      </Notice>
    )
  }

  <section id="flags" aria-labelledby="flags-heading" class="mt-8 scroll-mt-24">
    <h2
      id="flags-heading"
      class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
    >
      feature flags ({flags.length})
    </h2>
    <p class="mt-1 text-xs text-ink-faint">
      Switch site features on or off for everyone, straight away. New features
      start off.
    </p>
    <TerminalWindow title="~/site/flags" class="mt-3">
      <ul class="divide-y divide-grid/60">
        {
          flags.map((flag) => (
            <li class="flex flex-wrap items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
              <div class="min-w-0 max-w-prose">
                <p class="flex flex-wrap items-center gap-2 text-sm font-bold text-ink">
                  {flag.label}
                  <span
                    class:list={[
                      "rounded border px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-widest",
                      flag.enabled
                        ? "border-acid/50 bg-acid/10 text-acid"
                        : "border-grid text-ink-faint",
                    ]}
                  >
                    {flag.enabled ? "on" : "off"}
                  </span>
                  <code class="text-[10px] font-normal text-ink-faint">
                    {flag.key}
                  </code>
                </p>
                <p class="mt-1 text-xs text-ink-dim">{flag.description}</p>
                {flag.changedBy && flag.changedAt && (
                  <p class="mt-1 text-[11px] text-ink-faint">
                    Last changed by {flag.changedBy} · {fmt(flag.changedAt)}
                  </p>
                )}
              </div>
              <form method="post">
                <input type="hidden" name="key" value={flag.key} />
                <input
                  type="hidden"
                  name="enabled"
                  value={flag.enabled ? "off" : "on"}
                />
                <button
                  type="submit"
                  class={flag.enabled ? btnGhost : btnPrimary}
                >
                  {flag.enabled ? "turn off" : "turn on"}
                  <span class="sr-only"> {flag.label}</span>
                </button>
              </form>
            </li>
          ))
        }
      </ul>
    </TerminalWindow>
  </section>

  <section
    id="polls"
    aria-labelledby="polls-heading"
    class="mt-10 scroll-mt-24"
  >
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2
          id="polls-heading"
          class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          polls ({summaries.length})
        </h2>
        <p class="mt-1 text-xs text-ink-faint">
          Published polls appear on the homepage between their open and close
          times. Voters can earn bonus points in a week.
        </p>
      </div>
      <a href={withBase("/admin/polls/new")} class={btnPrimary}>+ new poll</a>
    </div>
    <TerminalWindow title="~/site/polls" bodyClass="p-0 sm:p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th scope="col" class={tableHead}>question</th>
              <th scope="col" class:list={[tableHead, "hidden md:table-cell"]}>
                opens → closes
              </th>
              <th scope="col" class={tableHead}>status</th>
              <th scope="col" class={tableHead}>voted</th>
              <th scope="col" class={tableHead}
                ><span class="sr-only">actions</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              summaries.map(({ poll, voterCount }) => (
                <tr class="transition-colors hover:bg-term-panel-2">
                  <td class={tableCell}>
                    <span class="text-ink">{poll.question}</span>
                    <span class="mt-0.5 block text-[11px] text-ink-faint">
                      {poll.kind === "single" ? "single" : "multiple"} choice ·{" "}
                      {poll.options.length} options ·{" "}
                      {poll.anonymous ? "anonymous" : "public"}
                    </span>
                  </td>
                  <td
                    class:list={[
                      tableCell,
                      "hidden whitespace-nowrap text-xs text-ink-faint md:table-cell",
                    ]}
                  >
                    {fmt(poll.opensAt)} → {fmt(poll.closesAt)}
                  </td>
                  <td class={tableCell}>
                    <PollStatusBadge
                      status={poll.status}
                      draft={!poll.published}
                    />
                  </td>
                  <td class:list={[tableCell, "tabular-nums text-ink-dim"]}>
                    {voterCount}/{players.length}
                  </td>
                  <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                    <a
                      href={withBase(`/admin/polls/new?from=${poll.id}`)}
                      class="mr-4 text-ink-dim hover:text-ink hover:underline"
                      aria-label={`Duplicate poll: ${poll.question}`}
                    >
                      duplicate
                    </a>
                    <a
                      href={withBase(`/admin/polls/${poll.id}`)}
                      class="text-cyan hover:underline"
                      aria-label={`Edit poll: ${poll.question}`}
                    >
                      edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {
          summaries.length === 0 && (
            <p class="p-6 text-sm text-ink-dim">
              No polls yet.{" "}
              <a
                href={withBase("/admin/polls/new")}
                class="text-cyan hover:underline"
              >
                Create one
              </a>
              .
            </p>
          )
        }
      </div>
    </TerminalWindow>
  </section>

  <section
    id="mini-tasks"
    aria-labelledby="mini-tasks-heading"
    class="mt-10 scroll-mt-24"
  >
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2
          id="mini-tasks-heading"
          class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          mini-tasks ({miniTasks.length})
        </h2>
        <p class="mt-1 max-w-prose text-xs text-ink-faint">
          Daily and bonus extras for {currentSeason?.name ?? "the season"},
          worth 1–5 Clim Coin. Open one to tick off who did it; players see them
          while the "Mini-tasks" flag is on.
        </p>
      </div>
      {
        currentSeason && currentSeason.status !== "closed" && (
          <a href={withBase("/admin/mini-tasks/new")} class={btnGhost}>
            + new mini-task
          </a>
        )
      }
    </div>
    <TerminalWindow title="~/site/mini-tasks" bodyClass="p-0 sm:p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th scope="col" class={tableHead}>runs</th>
              <th scope="col" class={tableHead}>status</th>
              <th scope="col" class={tableHead}>mini-task</th>
              <th scope="col" class={tableHead}>reward</th>
              <th scope="col" class={tableHead}>done</th>
              <th scope="col" class={tableHead}
                ><span class="sr-only">actions</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              miniTaskPage.items.map((row) => {
                const state = miniTaskState[deriveMiniTaskStatus(row, today)];
                return (
                  <tr class="transition-colors hover:bg-term-panel-2">
                    <td
                      class:list={[
                        tableCell,
                        "whitespace-nowrap tabular-nums text-ink-faint",
                      ]}
                    >
                      {row.startsOn === row.endsOn
                        ? row.startsOn
                        : `${row.startsOn} → ${row.endsOn}`}
                    </td>
                    <td
                      class:list={[
                        tableCell,
                        "whitespace-nowrap text-[10px] font-bold tracking-widest",
                        state.class,
                      ]}
                    >
                      {state.label}
                    </td>
                    <td class={tableCell}>
                      <span class="text-ink">{row.title}</span>
                      {row.description && (
                        <span class="block max-w-prose text-xs text-ink-faint">
                          {row.description}
                        </span>
                      )}
                    </td>
                    <td
                      class:list={[tableCell, "whitespace-nowrap text-amber"]}
                    >
                      <CoinAmount amount={row.reward} />
                    </td>
                    <td class:list={[tableCell, "tabular-nums text-ink-dim"]}>
                      {row.completions}
                    </td>
                    <td
                      class:list={[tableCell, "text-right whitespace-nowrap"]}
                    >
                      <a
                        href={withBase(`/admin/mini-tasks/${row.id}`)}
                        class="text-cyan hover:underline"
                        aria-label={`Tick off or edit ${row.title}`}
                      >
                        tick off
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
        {
          miniTasks.length === 0 && (
            <p class="p-6 text-sm text-ink-dim">
              No mini-tasks this season yet.
            </p>
          )
        }
      </div>
    </TerminalWindow>
    <Pagination
      info={miniTaskPage}
      href={miniTaskHref}
      label="Mini-task pages"
      itemLabel="mini-tasks"
      class="mt-3"
    />
  </section>

  <section
    id="changelog"
    aria-labelledby="changelog-heading"
    class="mt-10 scroll-mt-24"
  >
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2
          id="changelog-heading"
          class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          changelog ({changelog.length})
        </h2>
        <p class="mt-1 text-xs text-ink-faint">
          The homepage "what's new" list, newest first. Visitors see a dot on
          the button until they've opened the newest entry.
        </p>
      </div>
      <a href={withBase("/admin/changelog/new")} class={btnGhost}>+ new entry</a
      >
    </div>
    <TerminalWindow title="~/site/changelog" bodyClass="p-0 sm:p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th scope="col" class={tableHead}>date</th>
              <th scope="col" class={tableHead}>type</th>
              <th scope="col" class={tableHead}>entry</th>
              <th scope="col" class={tableHead}
                ><span class="sr-only">actions</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              changelogPage.items.map((row) => (
                <tr class="transition-colors hover:bg-term-panel-2">
                  <td
                    class:list={[
                      tableCell,
                      "whitespace-nowrap tabular-nums text-ink-faint",
                    ]}
                  >
                    {row.date}
                  </td>
                  <td
                    class:list={[
                      tableCell,
                      "text-xs font-bold uppercase tracking-widest",
                      categoryClass[row.category],
                    ]}
                  >
                    {row.category}
                  </td>
                  <td class={tableCell}>
                    <span class="text-ink">{row.title}</span>
                    <span class="block max-w-prose text-xs text-ink-faint">
                      {row.description}
                    </span>
                  </td>
                  <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                    <a
                      href={withBase(`/admin/changelog/${row.id}`)}
                      class="text-cyan hover:underline"
                      aria-label={`Edit ${row.title}`}
                    >
                      edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {
          changelog.length === 0 && (
            <p class="p-6 text-sm text-ink-dim">No entries yet.</p>
          )
        }
      </div>
    </TerminalWindow>
    <Pagination
      info={changelogPage}
      href={changelogHref}
      label="Changelog pages"
      itemLabel="entries"
      class="mt-3"
    />
  </section>

  <section id="shop" aria-labelledby="shop-heading" class="mt-10 scroll-mt-24">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2
          id="shop-heading"
          class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink-faint"
        >
          clim coin shop ({shop.length})
        </h2>
        <p class="mt-1 text-xs text-ink-faint">
          What players can spend Clim Coin on, site-wide. Pets, avatars and
          cosmetics also hatch from mystery eggs (rarity follows the price) when
          the <a href="#flags" class="text-cyan hover:underline"
            >mystery eggs flag</a
          > is on. Retired items stay with their owners and stop dropping; items nobody
          owns can be deleted.
        </p>
      </div>
      <span class="flex flex-wrap gap-2">
        <a href={withBase("/admin/market")} class={btnGhost}>marketplace →</a>
        <a href={withBase("/admin/shop/new")} class={btnGhost}>+ new item</a>
      </span>
    </div>
    <TerminalWindow title="~/site/shop" bodyClass="p-0 sm:p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th scope="col" class={tableHead}>item</th>
              <th scope="col" class:list={[tableHead, "hidden md:table-cell"]}>
                kind
              </th>
              <th scope="col" class={tableHead}>price</th>
              <th scope="col" class={tableHead}>sold</th>
              <th scope="col" class={tableHead}
                ><span class="sr-only">actions</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              shopPage.items.map((item) => (
                <tr class="transition-colors hover:bg-term-panel-2">
                  <td class={tableCell}>
                    <span class="text-ink">{item.name}</span>
                    {!item.available && (
                      <span class="ml-2 text-[10px] font-bold uppercase tracking-widest text-ink-faint">
                        retired
                      </span>
                    )}
                    {item.skillOnly && (
                      <span class="ml-2 text-[10px] font-bold uppercase tracking-widest text-cyan">
                        skill reward
                      </span>
                    )}
                    {item.crateOnly && (
                      <span class="ml-2 text-[10px] font-bold uppercase tracking-widest text-magenta">
                        {item.crateId ? `${item.crateId} only` : "egg only"}
                      </span>
                    )}
                    {(item.availableFrom || item.availableUntil) && (
                      <span class="ml-2 text-[10px] font-bold uppercase tracking-widest text-amber">
                        limited
                        {item.availableUntil &&
                          ` · until ${item.availableUntil.slice(0, 16)}`}
                      </span>
                    )}
                  </td>
                  <td
                    class:list={[
                      tableCell,
                      "hidden text-xs text-ink-dim md:table-cell",
                    ]}
                  >
                    {itemKind(item)}
                  </td>
                  <td class:list={[tableCell, "tabular-nums text-amber"]}>
                    {item.price}
                  </td>
                  <td class:list={[tableCell, "tabular-nums text-ink-dim"]}>
                    {item.purchases}
                  </td>
                  <td class:list={[tableCell, "text-right whitespace-nowrap"]}>
                    <a
                      href={withBase(`/admin/shop/${item.id}`)}
                      class="text-cyan hover:underline"
                      aria-label={`Edit ${item.name}`}
                    >
                      edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {
          shop.length === 0 && (
            <p class="p-6 text-sm text-ink-dim">
              The shop is empty.{" "}
              <a
                href={withBase("/admin/shop/new")}
                class="text-cyan hover:underline"
              >
                Add an item
              </a>
              .
            </p>
          )
        }
      </div>
    </TerminalWindow>
    <Pagination
      info={shopPage}
      href={shopHref}
      label="Shop pages"
      itemLabel="items"
      class="mt-3"
    />
  </section>
</AdminLayout>
