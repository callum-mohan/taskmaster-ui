---
import AdminField from "./AdminField.astro";
import Notice from "./Notice.astro";
import SlugFromName from "./SlugFromName.astro";
import { btnPrimary, btnGhost } from "./styles";
import type { FieldErrors, FormValues } from "../../lib/admin-forms";
import { ADMIN_SEASONS } from "../../lib/admin-nav";
import { withBase } from "../../lib/url";

interface Props {
  mode: "create" | "edit";
  values: FormValues;
  errors?: FieldErrors;
  formError?: string;
}

const { mode, values, errors = {}, formError } = Astro.props;
const isCreate = mode === "create";
---

<form method="post" class="space-y-5" data-slug-form>
  <input type="hidden" name="intent" value="save" />
  {formError && <Notice tone="error">{formError}</Notice>}
  <div class="grid gap-5 sm:grid-cols-2">
    <AdminField
      label="name"
      name="name"
      value={values.name}
      error={errors.name}
      required
      placeholder="Cohort 2027"
      attrs={{ "data-slug-source": "" }}
    />
    <AdminField
      label="id"
      name="id"
      value={values.id}
      error={errors.id}
      readonly={!isCreate}
      required
      placeholder="cohort-2027"
      hint={isCreate
        ? "Used in the season's URL (/seasons/<id>). Can't be changed later."
        : "Used in URLs, so it can't be changed."}
      attrs={isCreate ? { "data-slug-target": "" } : {}}
    />
  </div>
  <div class="flex flex-wrap gap-3 pt-2">
    <button type="submit" class={btnPrimary}>
      {isCreate ? "create season" : "save changes"}
    </button>
    <a href={withBase(ADMIN_SEASONS)} class={btnGhost}>cancel</a>
  </div>
</form>
{isCreate && <SlugFromName />}
