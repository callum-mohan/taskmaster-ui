---
import "../styles/global.css";
import TerminalWindow from "../components/TerminalWindow.astro";
import { withBase } from "../lib/url";

// Rendered when a page throws, often because the database or auth service
// is unreachable, so this page deliberately skips `Layout` (which loads the
// competition data) and touches nothing that could fail the same way.

interface Props {
  error: unknown;
}

const { error } = Astro.props;

// Error details are for local debugging only; production shows the copy.
const detail =
  import.meta.env.DEV && error instanceof Error ? error.message : undefined;

Astro.response.headers.set("Cache-Control", "no-store");

const btnPrimary =
  "inline-flex items-center justify-center gap-2 rounded-md border border-acid bg-acid/10 px-5 py-2.5 text-sm font-bold tracking-widest text-acid transition-colors hover:bg-acid hover:text-term-bg focus-visible:outline-none";
const btnGhost =
  "inline-flex items-center justify-center gap-2 rounded-md border border-grid px-4 py-2.5 text-sm font-bold tracking-widest text-ink-dim transition-colors hover:border-ink-faint hover:text-ink";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        const valid = ["dark", "light", "amber", "cyan", "magenta"];
        try {
          const saved = localStorage.getItem("eayl-theme");
          const theme = valid.indexOf(saved) >= 0 ? saved : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#080b10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>500 — Server Error · EAYL Taskmaster</title>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <main id="main" class="flex-1">
      <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
        <p class="text-sm font-bold tracking-[0.3em] text-danger">ERROR 500</p>
        <h1
          class="mt-3 text-6xl font-extrabold tracking-tight text-ink text-glow sm:text-8xl"
        >
          Task Failed
        </h1>
        <p class="mt-4 max-w-md text-sm text-ink-dim">
          Something broke behind the scenes and the Taskmaster is deeply
          disappointed. Give it a moment and try again.
        </p>

        <TerminalWindow title="~/logs/error.log" class="mt-8">
          <p class="text-sm text-ink-dim">
            <span class="text-acid">$</span> render {Astro.url.pathname}
          </p>
          <p class="mt-1 text-sm text-danger">
            <span aria-hidden="true">✗ </span>{detail ?? "request failed"}
          </p>
          <p class="mt-1 text-sm text-ink-faint">
            <span class="text-cyan">&gt;</span> retry in a few seconds<span
              class="caret"></span>
          </p>
        </TerminalWindow>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={Astro.url.pathname + Astro.url.search} class={btnPrimary}
            >&#x21bb; TRY AGAIN</a
          >
          <a href={withBase("/")} class={btnGhost}>&larr; RETURN HOME</a>
        </div>
      </div>
    </main>
  </body>
</html>
