---
import Layout from "../../layouts/Layout.astro";
import TaskCard from "../../components/TaskCard.astro";
import type { TaskStatus } from "../../types";

const { getTaskSummaries } = await Astro.locals.getQueries();

const summaries = getTaskSummaries();

const live = summaries.filter((s) => s.task.status === "live");
const upcoming = summaries.filter((s) => s.task.status === "upcoming");
const completed = summaries
  .filter((s) => s.task.status === "completed")
  .sort((a, b) => b.task.weekNumber - a.task.weekNumber);

const counts: Record<TaskStatus, number> = {
  live: live.length,
  upcoming: upcoming.length,
  completed: completed.length,
};
---

<Layout
  title="Tasks"
  description="Every weekly Taskmaster brief — live, upcoming and completed challenges."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Page header -->
    <header>
      <p
        class="prompt text-xs font-bold tracking-[0.3em] text-ink-dim uppercase"
      >
        ls ~/tasks
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        THE <span class="text-acid text-glow">TASKS</span>
      </h1>
      <p
        class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim sm:text-base"
      >
        <span class="text-acid">// </span>
        {summaries.length} weekly challenges. One released every Friday at 13:00.
        Upcoming briefs stay encrypted until release.
      </p>

      <div
        class="mt-6 flex flex-wrap gap-2 text-xs"
        role="group"
        aria-label="Filter tasks by status"
        data-task-filter
      >
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="task-chip flex items-center gap-2 rounded border border-ink-faint/50 bg-ink/5 px-3 py-1.5 text-ink transition-colors"
        >
          <span class="tracking-widest">ALL</span>
          <span class="font-bold tabular-nums">{summaries.length}</span>
        </button>
        <button
          type="button"
          data-filter="live"
          aria-pressed="false"
          disabled={counts.live === 0}
          class="task-chip flex items-center gap-2 rounded border border-amber/40 bg-amber/5 px-3 py-1.5 text-amber transition-colors disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span
            class="live-dot h-1.5 w-1.5 rounded-full bg-amber"
            aria-hidden="true"></span>
          <span class="tracking-widest">LIVE</span>
          <span class="font-bold tabular-nums text-ink">{counts.live}</span>
        </button>
        <button
          type="button"
          data-filter="completed"
          aria-pressed="false"
          disabled={counts.completed === 0}
          class="task-chip flex items-center gap-2 rounded border border-acid-dim bg-acid/5 px-3 py-1.5 text-acid transition-colors disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span class="tracking-widest">COMPLETED</span>
          <span class="font-bold tabular-nums text-ink">{counts.completed}</span
          >
        </button>
        <button
          type="button"
          data-filter="upcoming"
          aria-pressed="false"
          disabled={counts.upcoming === 0}
          class="task-chip flex items-center gap-2 rounded border border-grid bg-term-panel px-3 py-1.5 text-ink-faint transition-colors disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span class="tracking-widest">LOCKED</span>
          <span class="font-bold tabular-nums text-ink">{counts.upcoming}</span>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>
    </header>

    <!-- Live task(s) -->
    {
      live.length > 0 && (
        <section class="mt-12" data-status-section="live">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            tasks --filter live
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {live.map((summary) => (
              <TaskCard summary={summary} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Completed tasks -->
    {
      completed.length > 0 && (
        <section class="mt-12" data-status-section="completed">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            tasks --filter completed
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {completed.map((summary) => (
              <TaskCard summary={summary} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Upcoming / locked tasks -->
    {
      upcoming.length > 0 && (
        <section class="mt-12" data-status-section="upcoming">
          <h2 class="prompt mb-4 text-xs font-bold tracking-[0.3em] text-ink-dim uppercase">
            tasks --filter locked
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((summary) => (
              <TaskCard summary={summary} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>("[data-task-filter]");
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("[data-status-section]"),
  );
  const statusEl = document.querySelector<HTMLElement>("[data-filter-status]");

  if (root) {
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("button[data-filter]"),
    );

    const labels: Record<string, string> = {
      all: "all tasks",
      live: "live tasks",
      completed: "completed tasks",
      upcoming: "locked tasks",
    };

    function setFilter(filter: string) {
      sections.forEach((section) => {
        section.hidden = !(
          filter === "all" || section.dataset.statusSection === filter
        );
      });
      buttons.forEach((btn) =>
        btn.setAttribute("aria-pressed", String(btn.dataset.filter === filter)),
      );
      if (statusEl)
        statusEl.textContent = `Showing ${labels[filter] ?? filter}`;
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.disabled) return;
        setFilter(btn.dataset.filter ?? "all");
      });
    });
  }
</script>
