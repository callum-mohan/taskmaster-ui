---
import AdminLayout from "../../layouts/AdminLayout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import AdminField from "../../components/admin/AdminField.astro";
import Notice from "../../components/admin/Notice.astro";
import { btnPrimary, btnGhost } from "../../components/admin/styles";
import { createAuth, hasAdminRole, isAuthNetworkError } from "../../lib/auth";
import { withBase } from "../../lib/url";

// The admin portal. Players have their own at /login.

// Only same-site admin paths are allowed as a post-sign-in destination, so
// the `next` parameter can't be used as an open redirect.
const safeNext = (value: string | null) =>
  value && /^\/admin(?:[/?#]|$)/.test(value) && !value.startsWith("//")
    ? value
    : "/admin";

const next = safeNext(Astro.url.searchParams.get("next"));
let email = "";
let error: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "").trim();
  const password = String(form.get("password") ?? "");
  if (!email || !password) {
    error = "Enter your email and password.";
  } else {
    const result = await createAuth(Astro).signIn.email({ email, password });
    const signedIn = result.data?.user;
    if (!result.error && signedIn) {
      const isAdmin = hasAdminRole((signedIn as { role?: string | null }).role);
      // Non-admins land back here, where the GET points them elsewhere.
      const target = isAdmin
        ? safeNext(String(form.get("next") ?? ""))
        : "/admin/login";
      return Astro.redirect(withBase(target));
    }
    error = isAuthNetworkError(result.error?.code)
      ? "The sign-in service is unreachable. Try again in a moment."
      : "Incorrect email or password.";
  }
}

const viewer = await Astro.locals.getViewer();
if (viewer?.isAdmin && Astro.request.method === "GET") {
  return Astro.redirect(withBase(next));
}

// Signed in, but without the admin role (usually a player).
const forbidden = viewer && !viewer.isAdmin ? viewer : undefined;
const signedOut = Astro.url.searchParams.has("signedOut");
---

<AdminLayout title="Admin sign in" bare>
  <div class="mx-auto max-w-md">
    <h1 class="mb-6 text-2xl font-extrabold tracking-tight text-ink">
      <span class="text-acid">$</span> sudo login
    </h1>

    {
      signedOut && !error && !forbidden && (
        <Notice tone="success" class="mb-4">
          Signed out.
        </Notice>
      )
    }

    {
      forbidden ? (
        <TerminalWindow title="~/admin/access.log">
          <Notice tone="error">
            {forbidden.name} doesn't have admin access.
          </Notice>
          <p class="mt-4 text-sm text-ink-dim">
            This is the admin portal.{" "}
            {forbidden.playerId
              ? "Your player profile is in your account area."
              : "Ask an existing admin to grant access, or sign in with a different account."}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {forbidden.playerId && (
              <a href={withBase("/account")} class={btnPrimary}>
                go to your profile
              </a>
            )}
            <form method="post" action={withBase("/logout")}>
              <input type="hidden" name="portal" value="admin" />
              <button
                type="submit"
                class={forbidden.playerId ? btnGhost : btnPrimary}
              >
                sign out
              </button>
            </form>
            <a href={withBase("/")} class={btnGhost}>
              back to site
            </a>
          </div>
        </TerminalWindow>
      ) : (
        <TerminalWindow title="~/admin/login.sh" meta="admins only">
          {error && (
            <Notice tone="error" class="mb-5">
              {error}
            </Notice>
          )}
          <form method="post" class="space-y-5">
            <input type="hidden" name="next" value={next} />
            <AdminField
              label="email"
              name="email"
              type="email"
              value={email}
              autocomplete="username"
              required
            />
            <AdminField
              label="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
            <button type="submit" class:list={[btnPrimary, "w-full"]}>
              sign in
            </button>
          </form>
          <p class="mt-5 text-xs text-ink-faint">
            Player?{" "}
            <a href={withBase("/login")} class="text-cyan hover:underline">
              use the player login
            </a>
          </p>
        </TerminalWindow>
      )
    }
  </div>
</AdminLayout>
