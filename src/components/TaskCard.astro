---
import type { PlayerTaskResult, TaskSummary } from "../types";
import TaskStatusBadge from "./TaskStatusBadge.astro";
import ScoreBadge from "./ScoreBadge.astro";
import { withBase } from "../lib/url";
import { ukDateFormat } from "../lib/time";

interface Props {
  summary: TaskSummary;
  /**
   * The signed-in player's own result, shown on completed tasks. `null` means
   * a player is signed in but wasn't scored; omit it for everyone else.
   */
  yourResult?: PlayerTaskResult | null;
  class?: string;
}

const { summary, yourResult, class: className = "" } = Astro.props;

const ordinal = (n: number) => {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return `${n}${s[(v - 20) % 10] ?? s[v] ?? s[0]}`;
};
const { task, winner, winningScore, winningTeam } = summary;

const status = task.status;
const isTeam = task.format === "team";
const weekLabel = `WEEK ${String(task.weekNumber).padStart(2, "0")}`;

// Live tasks get extra emphasis; locked (upcoming) tasks read as dimmed.
const frameByStatus = {
  live: "border-amber/50 bg-amber/5 ring-1 ring-amber/20 shadow-[0_0_40px_-18px_rgba(255,180,84,0.5)]",
  completed: "border-grid bg-term-panel hover:border-ink-faint",
  upcoming: "border-grid-soft bg-term-panel/50",
} as const;

const numberColor = {
  live: "text-amber",
  completed: "text-acid",
  upcoming: "text-ink-faint",
} as const;

const dayFmt = ukDateFormat({
  day: "2-digit",
  month: "short",
});
const releaseLabel = dayFmt.format(new Date(task.releaseDate));
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-xl border p-5 transition-colors",
    frameByStatus[status],
    className,
  ]}
>
  <!-- Large terminal-style week number watermark -->
  <span
    class:list={[
      "pointer-events-none absolute top-1 right-3 text-5xl font-extrabold tabular-nums opacity-10 select-none",
      numberColor[status],
    ]}
    aria-hidden="true"
  >
    {String(task.weekNumber).padStart(2, "0")}
  </span>

  <div class="flex items-center justify-between gap-3">
    <span
      class:list={["text-xs font-bold tracking-[0.3em]", numberColor[status]]}
    >
      {weekLabel}
    </span>
    <div class="flex items-center gap-2">
      {
        isTeam && (
          <span class="inline-flex items-center rounded border border-magenta/40 bg-magenta/10 px-2 py-0.5 text-[10px] font-bold tracking-[0.2em] text-magenta">
            TEAM
          </span>
        )
      }
      <TaskStatusBadge status={status} locked={task.locked} />
    </div>
  </div>

  {
    status === "upcoming" ? (
      <>
        <h3 class="mt-3 text-xl font-extrabold text-ink-dim">{task.title}</h3>
        <p class="mt-2 flex-1 text-sm text-ink-faint">
          <span class="text-acid">$</span> cat brief.md &rarr;{" "}
          <span class="text-ink-faint">permission denied</span>
        </p>
        <p class="mt-4 text-[11px] tracking-widest text-ink-faint uppercase">
          Unlocks {releaseLabel}
        </p>
      </>
    ) : status === "live" && task.locked ? (
      <>
        <h3 class="mt-3 text-xl font-extrabold text-ink-faint">
          <span aria-hidden="true">▓▓▓▒▒░ ▓▒░</span>
          <span class="sr-only">Encrypted task</span>
        </h3>
        <p class="mt-2 flex-1 text-sm text-ink-dim">
          <span class="text-acid">$</span> cat brief.md &rarr;{" "}
          <span class="text-amber">encrypted, password required</span>
        </p>
        <a
          href={withBase(`/tasks/${task.id}`)}
          class="mt-5 inline-flex items-center justify-center gap-2 rounded-md border border-amber bg-amber/10 px-4 py-2 text-xs font-bold tracking-widest text-amber transition-colors hover:bg-amber hover:text-term-bg"
        >
          [ DECRYPT TASK ]<span class="sr-only">week {task.weekNumber}</span>
        </a>
      </>
    ) : (
      <>
        <h3
          class:list={[
            "mt-3 text-xl font-extrabold text-ink",
            status === "live" && "text-glow",
          ]}
        >
          {task.title}
        </h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-dim">
          {task.description}
        </p>

        {status === "completed" && isTeam && winningTeam && (
          <div class="mt-4 flex items-center justify-between gap-3 border-t border-grid pt-4">
            <div>
              <p class="text-[10px] tracking-[0.2em] text-ink-faint uppercase">
                Winning squad
              </p>
              <p class="mt-0.5 text-sm font-bold text-ink">
                🏆 {winningTeam.name}
              </p>
            </div>
            {winningScore !== undefined && (
              <ScoreBadge points={winningScore} position={1} />
            )}
          </div>
        )}

        {status === "completed" && !isTeam && winner && (
          <div class="mt-4 flex items-center justify-between gap-3 border-t border-grid pt-4">
            <div>
              <p class="text-[10px] tracking-[0.2em] text-ink-faint uppercase">
                Winner
              </p>
              <p class="mt-0.5 text-sm font-bold text-ink">🏆 {winner.name}</p>
            </div>
            {winningScore !== undefined && (
              <ScoreBadge points={winningScore} position={1} />
            )}
          </div>
        )}

        {status === "completed" && yourResult !== undefined && (
          <p
            class="mt-3 flex items-center justify-between gap-3 rounded border border-cyan/30 bg-cyan/5 px-3 py-2 text-xs"
            data-your-result
          >
            <span class="tracking-[0.2em] text-cyan uppercase">
              {isTeam ? "Your squad" : "You"}
            </span>
            {yourResult ? (
              <span class="font-bold tabular-nums">
                <span class="text-ink">{ordinal(yourResult.position)}</span>
                <span class="text-ink-faint"> · </span>
                <span class="text-acid">{yourResult.points}</span>
                <span class="font-medium text-ink-faint"> pts</span>
              </span>
            ) : (
              <span class="text-ink-faint">not scored</span>
            )}
          </p>
        )}

        <a
          href={withBase(`/tasks/${task.id}`)}
          class:list={[
            "mt-5 inline-flex items-center justify-center gap-2 rounded-md border px-4 py-2 text-xs font-bold tracking-widest transition-colors",
            status === "live"
              ? "border-amber bg-amber/10 text-amber hover:bg-amber hover:text-term-bg"
              : "border-grid text-ink-dim hover:border-acid hover:text-acid",
          ]}
        >
          [ VIEW TASK ]
        </a>
      </>
    )
  }
</article>
